<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Kei 主题色板（Semi 档）：色值取自 Semi.Avalonia 12.1.0.1 Dark 主题实际资源。
         键名保持 Kei.*，使用点无需改动。见 polish-round1-report.md Part C 映射表。 -->

    <Color x:Key="Kei.Color.Bg.Window">#FF16161A</Color>
    <Color x:Key="Kei.Color.Bg.Panel">#FF232429</Color>
    <Color x:Key="Kei.Color.Bg.PanelAlt">#FF35363C</Color>
    <Color x:Key="Kei.Color.Bg.Hover">#FF2E3238</Color>
    <Color x:Key="Kei.Color.Bg.TabInactive">#FF16161A</Color>
    <Color x:Key="Kei.Color.Border">#FF41464C</Color>
    <Color x:Key="Kei.Color.Text.Primary">#FFF9F9F9</Color>
    <Color x:Key="Kei.Color.Text.Secondary">#FFC6CACD</Color>
    <Color x:Key="Kei.Color.Text.Muted">#FF888D92</Color>
    <Color x:Key="Kei.Color.Accent">#FF54A9FF</Color>
    <Color x:Key="Kei.Color.Accent.Hover">#FF7FC1FF</Color>
    <Color x:Key="Kei.Color.Session.Foreground">#FF5DC264</Color>
    <Color x:Key="Kei.Color.Status.Connecting">#FFFFAE43</Color>
    <Color x:Key="Kei.Color.Status.Connected">#FF5DC264</Color>
    <Color x:Key="Kei.Color.Status.Disconnected">#FF888D92</Color>
    <Color x:Key="Kei.Color.Status.Error">#FFFC725A</Color>

    <SolidColorBrush x:Key="Kei.Bg.Window" Color="{StaticResource Kei.Color.Bg.Window}"/>
    <SolidColorBrush x:Key="Kei.Bg.Panel" Color="{StaticResource Kei.Color.Bg.Panel}"/>
    <SolidColorBrush x:Key="Kei.Bg.PanelAlt" Color="{StaticResource Kei.Color.Bg.PanelAlt}"/>
    <SolidColorBrush x:Key="Kei.Bg.Hover" Color="{StaticResource Kei.Color.Bg.Hover}"/>
    <SolidColorBrush x:Key="Kei.Bg.TabInactive" Color="{StaticResource Kei.Color.Bg.TabInactive}"/>
    <SolidColorBrush x:Key="Kei.Border" Color="{StaticResource Kei.Color.Border}"/>
    <SolidColorBrush x:Key="Kei.Text.Primary" Color="{StaticResource Kei.Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Kei.Text.Secondary" Color="{StaticResource Kei.Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Kei.Text.Muted" Color="{StaticResource Kei.Color.Text.Muted}"/>
    <SolidColorBrush x:Key="Kei.Accent" Color="{StaticResource Kei.Color.Accent}"/>
    <SolidColorBrush x:Key="Kei.Accent.Hover" Color="{StaticResource Kei.Color.Accent.Hover}"/>
    <SolidColorBrush x:Key="Kei.Session.Foreground" Color="{StaticResource Kei.Color.Session.Foreground}"/>
    <SolidColorBrush x:Key="Kei.Status.Connecting" Color="{StaticResource Kei.Color.Status.Connecting}"/>
    <SolidColorBrush x:Key="Kei.Status.Connected" Color="{StaticResource Kei.Color.Status.Connected}"/>
    <SolidColorBrush x:Key="Kei.Status.Disconnected" Color="{StaticResource Kei.Color.Status.Disconnected}"/>
    <SolidColorBrush x:Key="Kei.Status.Error" Color="{StaticResource Kei.Color.Status.Error}"/>
</ResourceDictionary>
