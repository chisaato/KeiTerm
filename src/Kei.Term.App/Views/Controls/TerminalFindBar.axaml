<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kei.Term.App.ViewModels"
             xmlns:loc="using:Kei.Term.App.Helpers"
             x:Class="Kei.Term.App.Views.Controls.TerminalFindBar"
             x:DataType="vm:TerminalTabViewModel"
             IsVisible="{Binding IsFindBarOpen}"
             FontFamily="{DynamicResource Kei.Font.UI}" FontSize="12" MaxWidth="440">
    <Border Background="{DynamicResource Kei.Bg.Panel}"
            BorderBrush="{DynamicResource Kei.Border}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Kei.Radius.Control}"
            Padding="6">
        <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" ColumnSpacing="4">
            <TextBox x:Name="QueryBox"
                     Classes="findQuery"
                     Text="{Binding FindQuery}"
                     PlaceholderText="{loc:KeiString Terminal.Find.Placeholder}"
                     VerticalAlignment="Center">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding FindNextCommand}"/>
                    <KeyBinding Gesture="Shift+Enter" Command="{Binding FindPreviousCommand}"/>
                    <KeyBinding Gesture="Escape" Command="{Binding CloseFindCommand}"/>
                </TextBox.KeyBindings>
            </TextBox>
            <TextBlock Grid.Column="1"
                       Text="{Binding FindStatus}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Kei.Text.Secondary}"/>
            <Button Grid.Column="2" Classes="iconBtn" Width="28" Height="28" MinHeight="28"
                    ToolTip.Tip="{loc:KeiString Terminal.Find.Previous}" AutomationProperties.Name="{loc:KeiString Terminal.Find.Previous}"
                    Command="{Binding FindPreviousCommand}">
                <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="24" Height="24">
                        <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.ArrowUp}"/>
                    </Grid>
                </Viewbox>
            </Button>
            <Button Grid.Column="3" Classes="iconBtn" Width="28" Height="28" MinHeight="28"
                    ToolTip.Tip="{loc:KeiString Terminal.Find.Next}" AutomationProperties.Name="{loc:KeiString Terminal.Find.Next}"
                    Command="{Binding FindNextCommand}">
                <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="24" Height="24">
                        <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.ArrowDown}"/>
                    </Grid>
                </Viewbox>
            </Button>
            <Button Grid.Column="4" Classes="iconBtn" Width="28" Height="28" MinHeight="28"
                    ToolTip.Tip="{loc:KeiString Terminal.Find.Close}" AutomationProperties.Name="{loc:KeiString Terminal.Find.Close}"
                    Command="{Binding CloseFindCommand}">
                <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="24" Height="24">
                        <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Close}"/>
                    </Grid>
                </Viewbox>
            </Button>
        </Grid>
    </Border>
</UserControl>
