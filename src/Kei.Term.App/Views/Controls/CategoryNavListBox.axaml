<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Kei.Term.App.Views.Controls"
             xmlns:settings="using:Kei.Term.App.ViewModels.Settings"
             xmlns:converters="using:Kei.Term.App.Converters"
             x:Class="Kei.Term.App.Views.Controls.CategoryNavListBox"
             x:DataType="controls:CategoryNavListBox">

    <ListBox x:Name="PART_List"
             ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=controls:CategoryNavListBox}}"
             SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=controls:CategoryNavListBox}, Mode=TwoWay}"
             Margin="0,8" Padding="0"
             Background="Transparent" BorderThickness="0">
        <ListBox.Styles>
            <Style Selector="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Secondary}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="root" Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- 选中态左侧 Accent 竖条 -->
                                <Rectangle Name="accentBar" Width="3" HorizontalAlignment="Left"
                                           Fill="{DynamicResource Kei.Accent}"
                                           IsHitTestVisible="False" Opacity="0"/>
                                <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Content="{TemplateBinding Content}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </Style>

            <Style Selector="ListBoxItem:pointerover /template/ Border#root">
                <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
            </Style>
            <Style Selector="ListBoxItem:selected /template/ Border#root">
                <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
            </Style>
            <Style Selector="ListBoxItem:selected /template/ Rectangle#accentBar">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="ListBoxItem:selected">
                <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
            </Style>
            <Style Selector="ListBoxItem:not(:selected)">
                <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Secondary}"/>
            </Style>
            <Style Selector="ListBoxItem:not(:selected) TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Secondary}"/>
            </Style>
            <Style Selector="ListBoxItem:selected TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
            </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="settings:SettingsCategoryItem">
                <Panel>
                    <!-- 分组标题呈现（不可选） -->
                    <TextBlock Classes="navGroupHeader"
                               Text="{Binding Title}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Kei.Text.Muted}"
                               IsVisible="{Binding IsHeader}"/>

                    <!-- 单行条目呈现（图标 + 标题，去掉副标题） -->
                    <Grid ColumnDefinitions="16,*" ColumnSpacing="10"
                          IsVisible="{Binding !IsHeader}">
                        <Viewbox Grid.Column="0" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Width="24" Height="24" Stretch="None"
                                      Data="{Binding Icon, Converter={x:Static converters:LucideIconGeometryConverter.Instance}}"
                                      Stroke="{Binding $parent[ListBoxItem].Foreground}"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding $parent[ListBoxItem].Foreground}"/>
                    </Grid>
                </Panel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
