<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Kei.Term.Core.Models"
             x:Class="Kei.Term.App.Views.Controls.SessionTreeItemView"
             x:DataType="models:TreeNodeBase">
    <!-- 会话树条目视觉。主窗口和选择会话对话框共用；拖放、右键、双击连接不在这里。 -->
    <UserControl.Styles>
        <Style Selector="Path.folderIcon">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Path.sessionIcon">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="TextBlock.name">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
        </Style>
        <Style Selector=":is(UserControl).session Path.folderIcon">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector=":is(UserControl).session Path.sessionIcon">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector=":is(UserControl).session TextBlock.name">
            <Setter Property="Foreground" Value="{DynamicResource Kei.Session.Foreground}"/>
        </Style>
        <Style Selector=":is(UserControl).virtualRoot TextBlock.name">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector=":is(UserControl).editing TextBlock.name">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </UserControl.Styles>
    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
        <Viewbox Width="{DynamicResource Kei.Tree.IconSize}" Height="{DynamicResource Kei.Tree.IconSize}"
                 Stretch="Uniform" VerticalAlignment="Center">
            <Grid Width="24" Height="24">
                <Path Classes="kei-icon folderIcon" Data="{StaticResource Kei.Icon.Folder}"
                      Width="24" Height="24" Stretch="None"
                      Fill="{DynamicResource Kei.Text.Muted}"/>
                <Path Classes="kei-icon sessionIcon" Data="{StaticResource Kei.Icon.Terminal}"
                      Width="24" Height="24" Stretch="None"
                      Fill="{DynamicResource Kei.Session.Foreground}"/>
            </Grid>
        </Viewbox>
        <TextBlock Classes="name" Text="{Binding Name}"
                   FontSize="{DynamicResource Kei.Tree.FontSize}"
                   VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
