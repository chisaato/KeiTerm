<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kei.Term.App.ViewModels"
        xmlns:views="using:Kei.Term.App.Views"
        xmlns:controls="using:Kei.Term.App.Views.Controls"
        xmlns:models="using:Kei.Term.Core.Models"
        xmlns:conv="using:Kei.Term.App.Converters"
        xmlns:loc="using:Kei.Term.App.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:Class="Kei.Term.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{loc:KeiString Main.Title}"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="600"
        FontFamily="{DynamicResource Kei.Font.UI}"
        Background="{DynamicResource Kei.Bg.Window}">

    <Window.Resources>

        <conv:ConnectionStateBrushConverter x:Key="ConnectionStateBrush"/>
        <conv:TabStatusBrushConverter x:Key="TabStatusBrush"/>
    </Window.Resources>

    <Window.Styles>
        <!-- 仅显示时播放；移除类即取消，外层命中范围和固定列宽不参与动画。 -->
        <Style Selector="Border#SessionManagerSurface.revealing">
            <Style.Animations>
                <Animation Duration="0:0:0.150" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.X" Value="-12"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.X" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 侧栏树：统一由基类 TreeNodeBase 绑定 IsExpanded，消除子类型强转与样式冲突。
             注意：必须用 .sessionTree 限定作用域，否则会级联命中文件管理面板的 TreeViewItem，
             导致其 RemoteDirectoryNodeViewModel 被强转为 TreeNodeBase 而抛绑定异常。 -->
        <Style Selector=".sessionTree TreeViewItem" x:DataType="models:TreeNodeBase">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>

        <Style Selector=".sessionTree TreeViewItem /template/ Border#PART_LayoutRoot">
            <Setter Property="Padding" Value="2,1"/>
        </Style>

        <!-- 拖拽悬停视觉反馈样式：合法目标微亮强调 + 亮蓝左边线，禁止目标微红警示 -->
        <Style Selector=".sessionTree TreeViewItem.drop-target-valid /template/ Border#PART_ContentPill">
            <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Kei.Accent}"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
        </Style>
        <Style Selector=".sessionTree TreeViewItem.drop-target-valid">
            <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Kei.Accent}"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
        </Style>
        <Style Selector=".sessionTree TreeViewItem.drop-target-invalid /template/ Border#PART_ContentPill">
            <Setter Property="Background" Value="{DynamicResource Kei.Bg.ErrorSubtle}"/>
        </Style>
        <Style Selector=".sessionTree TreeViewItem.drop-target-invalid">
            <Setter Property="Background" Value="{DynamicResource Kei.Bg.ErrorSubtle}"/>
        </Style>

        <!-- 控件外观类样式（iconBtn/tabItem/closeBtn）已迁至 DesignSystem/KeiControls.axaml，
             仅 KeiClassic 档挂载，使 Semi/Material 档可由第三方库模板接管。 -->

        <!-- NativeMenuBar 的默认模板只把 Background/BorderBrush 透传给内部 presenter，
             文字色与最小高度需在此补齐，否则 Windows/Linux 上窗口内菜单栏会丢失原有观感。 -->
        <Style Selector="NativeMenuBar /template/ MenuBase#PART_NativeMenuPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
    </Window.Styles>

    <!-- 菜单本体：macOS 导出至系统全局菜单栏，Windows/Linux 由上方 NativeMenuBar 就地渲染。
         快捷键不在此硬编码——修饰键随平台而异（⌘ / Ctrl），由代码后置统一装配。 -->
    <!-- 菜单本体：macOS 导出至系统全局菜单栏，Windows/Linux 由上方 NativeMenuBar 就地渲染。
         快捷键不在此硬编码——修饰键随平台而异（⌘ / Ctrl），由代码后置统一装配。
         注意：子菜单必须写成显式的 <NativeMenuItem.Menu><NativeMenu>…，
         直接嵌套 <NativeMenuItem> 子元素会在 Avalonia 12.1.2 的 XAML 填充期空引用崩溃。 -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{loc:KeiString Menu.File}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{loc:KeiString Menu.File.NewTab}" Command="{Binding NewTabCommand}"/>
                        <NativeMenuItem Header="{loc:KeiString Menu.File.CloseTab}" Command="{Binding CloseCurrentWorkspaceTabCommand}"/>
                        <NativeMenuItem Header="{loc:KeiString Menu.File.ConnectSavedSession}" Command="{Binding ConnectSavedSessionCommand}"/>
                        <NativeMenuItem Header="{loc:KeiString Menu.File.QuickConnect}" Command="{Binding QuickConnectCommand}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="{loc:KeiString Menu.File.NewSession}" Command="{Binding CreateSessionCommand}"/>
                        <NativeMenuItem Header="{loc:KeiString Menu.File.NewFolder}" Command="{Binding CreateFolderCommand}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="{loc:KeiString Menu.File.ImportSecureCrt}" Command="{Binding ImportSecureCrtCommand}"/>
                        <NativeMenuItem Header="{loc:KeiString Menu.File.ImportOpenSshConfig}" Command="{Binding ImportOpenSshConfigCommand}"/>
                        <NativeMenuItem Header="{loc:KeiString Menu.File.ImportKnownHosts}" Command="{Binding ImportKnownHostsCommand}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="{loc:KeiString Menu.File.Connect}" Command="{Binding ConnectSelectedSessionCommand}"/>
                        <NativeMenuItem Header="{loc:KeiString Menu.File.DisconnectTab}" Command="{Binding DisconnectCurrentTabCommand}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="{loc:KeiString Menu.File.Exit}"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="{loc:KeiString Menu.Edit}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{loc:KeiString Menu.Edit.Cut}"/>
                        <NativeMenuItem Header="{loc:KeiString Menu.Edit.Copy}"/>
                        <NativeMenuItem Header="{loc:KeiString Menu.Edit.Paste}"/>
                        <NativeMenuItem Header="{loc:KeiString Menu.Edit.SelectAll}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="{loc:KeiString Menu.Edit.DeleteSelected}"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="{loc:KeiString Menu.View}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{loc:KeiString Menu.View.SessionManager}" ToggleType="CheckBox" IsChecked="{Binding IsSessionManagerPinned, Mode=TwoWay}"/>
                        <NativeMenuItem Header="{loc:KeiString Menu.View.Compose}">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="{loc:KeiString Menu.View.Compose.Show}" ToggleType="CheckBox" IsChecked="{Binding IsComposeBarVisible, Mode=TwoWay}"/>
                                    <NativeMenuItemSeparator/>
                                    <NativeMenuItem Header="{loc:KeiString Menu.View.Compose.SingleLine}" ToggleType="CheckBox" IsChecked="{Binding IsSingleLineCompose, Mode=TwoWay}"/>
                                    <NativeMenuItem Header="{loc:KeiString Menu.View.Compose.MultiLine}" ToggleType="CheckBox" IsChecked="{Binding IsMultiLineCompose, Mode=TwoWay}"/>
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="{loc:KeiString Menu.Appearance}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{loc:KeiString Menu.Appearance.Import}">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="{loc:KeiString Menu.Appearance.Import.Konsole}" Command="{Binding ImportKonsoleCommand}"/>
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="{loc:KeiString Menu.Tools}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{loc:KeiString Menu.Tools.CommandPalette}" Command="{Binding OpenCommandPaletteCommand}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="{loc:KeiString Menu.Tools.IdentityManager}" Command="{Binding OpenIdentityManagerCommand}"/>
                        <NativeMenuItem Header="{loc:KeiString Menu.Tools.KnownHosts}" Command="{Binding OpenKnownHostsCommand}"/>
                        <NativeMenuItem Header="{loc:KeiString Menu.Tools.BatchEdit}" Command="{Binding OpenBatchEditCommand}"/>
                        <NativeMenuItem Header="{loc:KeiString Menu.Tools.Settings}" Command="{Binding OpenSettingsCommand}"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="{loc:KeiString Menu.Help}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{loc:KeiString Menu.Help.About}"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <!-- 根布局：Row0 菜单 / Row1 全宽工具栏 / Row2 左右分栏（SecureCRT 式：菜单与工具栏横贯顶部） -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*">

        <!-- Row0 菜单栏：NativeMenuBar 从本窗口的 NativeMenu.Menu（见文件末尾）取菜单，
             并按 TopLevel 的 IsNativeMenuExported 自动切换：
               macOS          -> 菜单导出至系统全局菜单栏，此处整条隐藏（不再占用窗口高度）
               Windows/Linux  -> 无原生菜单栏，此处就地渲染，保持与替换前一致
             行为依据 Avalonia 12 的 NativeMenuBar.SubscribeToToplevel。 -->
        <NativeMenuBar Grid.Row="0"
                       Background="{DynamicResource Kei.Bg.PanelAlt}"/>

        <!-- Row1 全局工具栏：会话/应用操作组在左，状态消息居中，视图开关在右 -->
        <Border Grid.Row="1"
                Background="{DynamicResource Kei.Bg.PanelAlt}"
                BorderBrush="{DynamicResource Kei.Border}"
                BorderThickness="0,0,0,1"
                Padding="6,3"
                MinHeight="38">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- 全局功能操作组（连接、工具、设置） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="SessionManagerToggleButton" Classes="iconBtn sessionManagerPin" Classes.pinned="{Binding IsSessionManagerPinned}" Width="28" Height="28"
                            ToolTip.Tip="{Binding SessionManagerToggleToolTip}" Command="{Binding ToggleSessionManagerPinCommand}">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Sidebar}"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Separator Classes="toolSep"/>
                    <!-- 连接操作区 -->
                    <Button Classes="iconBtn" ToolTip.Tip="{Binding QuickConnectToolTip}" Command="{Binding QuickConnectCommand}">
                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.QuickConnect}"/>
                    </Button>
                    <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.ConnectSelected}" Command="{Binding ConnectSelectedSessionCommand}">
                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Connect}"/>
                    </Button>
                    <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.DisconnectTab}" Command="{Binding DisconnectCurrentTabCommand}">
                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Disconnect}"/>
                    </Button>

                    <Separator Classes="toolSep"/>

                    <!-- 工具与设置区 -->
                    <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.IdentityManager}" Command="{Binding OpenIdentityManagerCommand}">
                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Key}"/>
                    </Button>
                    <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.Settings}" Command="{Binding OpenSettingsCommand}">
                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Settings}"/>
                    </Button>
                    <Button Classes="iconBtn" ToolTip.Tip="{Binding CommandPaletteToolTip}" Command="{Binding OpenCommandPaletteCommand}">
                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Search}"/>
                    </Button>
                </StackPanel>

                <!-- 暂态状态提示（如粘贴目标无效） -->
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource Kei.Status.Connecting}"
                           IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="8,0"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 视图控制区（文件管理） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="FileManagerToggleButton" Classes="iconBtn" ToolTip.Tip="切换文件管理侧栏" Command="{Binding ToggleFileManagerCommand}">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.SidebarRight}"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row2 左右分栏：左连接管理器 / 中分割条 / 右内容区 -->
        <Grid x:Name="MainSplitGrid" Grid.Row="2" ColumnDefinitions="260,4,*">

            <!-- 左：连接管理器（树操作工具栏 → 过滤框 → 目录树/空态） -->
            <Border x:Name="SessionManagerBorder" Grid.Column="0" Background="Transparent" ClipToBounds="True"
                    IsVisible="{Binding IsSessionManagerVisible}">
                <Border x:Name="SessionManagerSurface" Background="{DynamicResource Kei.Bg.Panel}"
                        BorderBrush="{DynamicResource Kei.Border}" BorderThickness="0,0,1,0">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <Grid RowDefinitions="Auto,Auto,*">

                        <!-- Row0 面板头：专属于会话管理器的操作工具栏（新建会话/目录、剪切、复制、粘贴、折叠全部） -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource Kei.Bg.PanelAlt}"
                                BorderBrush="{DynamicResource Kei.Border}"
                                BorderThickness="0,0,0,1"
                                Padding="6,3">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.NewSession}" Command="{Binding CreateSessionCommand}">
                                    <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.NewSession}"/>
                                </Button>
                                <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.NewFolder}" Command="{Binding CreateFolderCommand}">
                                    <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.NewFolder}"/>
                                </Button>

                                <Separator Classes="toolSep"/>

                                <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.Cut}" Command="{Binding CutNodeCommand}">
                                    <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Cut}"/>
                                </Button>
                                <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.Copy}" Command="{Binding CopyNodeCommand}">
                                    <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Copy}"/>
                                </Button>
                                <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.Paste}" Command="{Binding PasteNodeCommand}">
                                    <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Paste}"/>
                                </Button>

                                <Separator Classes="toolSep"/>

                                <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.CollapseAll}" Command="{Binding CollapseAllCommand}">
                                    <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.CollapseAll}"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Row1 过滤框：即时过滤；展开和固定操作统一放在顶部侧栏按钮。 -->
                        <Grid Grid.Row="1" Margin="6,6,6,4">
                            <TextBox x:Name="SessionManagerFilter" Text="{Binding FilterText}"
                                     PlaceholderText="{loc:KeiString Main.Filter.Placeholder}"
                                     Background="{DynamicResource Kei.Bg.PanelAlt}"
                                     Foreground="{DynamicResource Kei.Text.Primary}"
                                     BorderBrush="{DynamicResource Kei.Border}"
                                     CornerRadius="4"
                                     Padding="6,4"
                                     FontSize="12"/>
                        </Grid>

                        <!-- Row2 目录树 + 空树引导态 -->
                        <Grid Grid.Row="2">
                            <TreeView x:Name="SessionTree"
                                      Classes="sessionTree"
                                      ItemsSource="{Binding TreeNodes}"
                                      SelectedItem="{Binding SelectedTreeNode}"
                                      DoubleTapped="Tree_DoubleTapped"
                                      DragDrop.AllowDrop="True"
                                      Background="Transparent">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:KeiString Tree.Menu.NewSession}" Command="{Binding CreateSessionCommand}"/>
                                        <MenuItem Header="{loc:KeiString Tree.Menu.NewFolder}" Command="{Binding CreateFolderCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="{loc:KeiString Tree.Menu.Rename}" Command="{Binding RenameSelectedNodeCommand}"/>
                                        <MenuItem Header="{loc:KeiString Tree.Menu.EditSelected}" Command="{Binding EditSelectedNodeCommand}"/>
                                        <MenuItem Header="{loc:KeiString Tree.Menu.DeleteSelected}" Command="{Binding DeleteSelectedNodeCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="{loc:KeiString Tree.Menu.BatchEdit}" Command="{Binding OpenBatchEditCommand}"/>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.DataTemplates>
                                    <!-- 条目视觉在 SessionTreeItemView。右键、双击连接、拖放仍留在本窗口。 -->
                                    <TreeDataTemplate DataType="models:VirtualRootNode" ItemsSource="{Binding Children}">
                                        <controls:SessionTreeItemView/>
                                    </TreeDataTemplate>
                                    <TreeDataTemplate DataType="models:FolderNode" ItemsSource="{Binding Children}">
                                        <Grid>
                                            <controls:SessionTreeItemView>
                                                <controls:SessionTreeItemView.HideName>
                                                    <MultiBinding Converter="{x:Static conv:SameNodeConverter.Instance}">
                                                        <Binding />
                                                        <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).RenamingNode"/>
                                                    </MultiBinding>
                                                </controls:SessionTreeItemView.HideName>
                                            </controls:SessionTreeItemView>
                                            <TextBox Classes="treeRenameBox" Margin="22,0,0,0"
                                                     Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).TreeRenameText, Mode=TwoWay}">
                                                <TextBox.IsVisible>
                                                    <MultiBinding Converter="{x:Static conv:SameNodeConverter.Instance}">
                                                        <Binding />
                                                        <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).RenamingNode"/>
                                                    </MultiBinding>
                                                </TextBox.IsVisible>
                                            </TextBox>
                                        </Grid>
                                    </TreeDataTemplate>
                                    <DataTemplate DataType="models:SessionNode" x:DataType="models:SessionNode">
                                        <Grid Background="Transparent">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:KeiString Tree.Menu.Connect}"
                                                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenSessionCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="{loc:KeiString Tree.Menu.Rename}"
                                                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RenameSelectedNodeCommand}"/>
                                                    <MenuItem Header="{loc:KeiString Tree.Menu.Edit}"
                                                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditSelectedNodeCommand}"/>
                                                    <MenuItem Header="{loc:KeiString Tree.Menu.DuplicateSession}"
                                                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DuplicateSelectedSessionCommand}"/>
                                                    <MenuItem Header="{loc:KeiString Tree.Menu.Delete}"
                                                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteSelectedNodeCommand}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{loc:KeiString Tree.Menu.BatchEdit}"
                                                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenBatchEditCommand}"/>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <controls:SessionTreeItemView>
                                                <controls:SessionTreeItemView.HideName>
                                                    <MultiBinding Converter="{x:Static conv:SameNodeConverter.Instance}">
                                                        <Binding />
                                                        <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).RenamingNode"/>
                                                    </MultiBinding>
                                                </controls:SessionTreeItemView.HideName>
                                            </controls:SessionTreeItemView>
                                            <TextBox Classes="treeRenameBox" Margin="22,0,0,0"
                                                     Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).TreeRenameText, Mode=TwoWay}">
                                                <TextBox.IsVisible>
                                                    <MultiBinding Converter="{x:Static conv:SameNodeConverter.Instance}">
                                                        <Binding />
                                                        <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).RenamingNode"/>
                                                    </MultiBinding>
                                                </TextBox.IsVisible>
                                            </TextBox>
                                        </Grid>
                                    </DataTemplate>
                                </TreeView.DataTemplates>
                            </TreeView>

                            <!-- 空树引导态 -->
                            <StackPanel IsVisible="{Binding !HasNodes}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="10"
                                        Margin="16">
                                <TextBlock Text="{loc:KeiString Tree.EmptyGuide}" Foreground="{DynamicResource Kei.Text.Muted}" HorizontalAlignment="Center" FontSize="13"/>
                                <Button Content="{loc:KeiString Tree.AddFirstSession}"
                                        Command="{Binding CreateSessionCommand}"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource Kei.Accent}"
                                        Foreground="{DynamicResource Kei.Accent.Foreground}"
                                        Padding="10,6"
                                        CornerRadius="4"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- 中：垂直分割条 -->
            <GridSplitter x:Name="SessionManagerSplitter" Grid.Column="1"
                          Background="{DynamicResource Kei.Bg.PanelAlt}"
                          ResizeDirection="Columns"
                          IsVisible="{Binding IsSessionManagerDocked}"/>

            <!-- 右：主内容区（标签条 → 终端区 → 撰写栏） -->
            <Grid x:Name="RightContentGrid" Grid.Column="2" RowDefinitions="Auto,*,Auto">

                <!-- 标签条：状态指示竖条 + 标题 + 关闭；无标签时整行隐藏 -->
                <Border x:Name="TabsBarBorder"
                        Grid.Row="0"
                        Background="{DynamicResource Kei.Bg.Panel}"
                        BorderBrush="{DynamicResource Kei.Border}"
                        BorderThickness="0,0,0,1"
                        IsVisible="{Binding HasTabs}">
                    <Grid ColumnDefinitions="*,Auto">
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TabsItemsControl" ItemsSource="{Binding WorkspaceTabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.DataTemplates>
                                    <DataTemplate DataType="vm:TerminalTabViewModel" x:DataType="vm:TerminalTabViewModel">
                                        <Button Classes="tabItem"
                                                Classes.selected="{Binding IsSelected}"
                                                Classes.activity="{Binding HasActivity}"
                                                DragDrop.AllowDrop="True"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectWorkspaceTabCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding ToolTip}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:KeiString Main.Tab.Menu.Reconnect}" Command="{Binding RequestReconnectCommand}"/>
                                                    <MenuItem Header="{loc:KeiString Main.Tab.Menu.Disconnect}" Command="{Binding DisconnectCommand}"/>
                                                    <MenuItem Header="{loc:KeiString Main.Tab.Menu.Clone}" Command="{Binding RequestCloneCommand}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{loc:KeiString Main.Tab.Menu.Rename}" Command="{Binding RequestRenameCommand}"/>
                                                    <MenuItem Header="{loc:KeiString Main.Tab.Menu.FollowRemoteTitle}"
                                                              ToggleType="CheckBox"
                                                              IsChecked="{Binding FollowRemoteTitle, Mode=OneWay}"
                                                              Command="{Binding ToggleFollowRemoteTitleCommand}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{loc:KeiString Main.Tab.Menu.Close}" Command="{Binding RequestCloseCommand}"/>
                                                    <MenuItem Header="{loc:KeiString Main.Tab.Menu.CloseOthers}" Command="{Binding RequestCloseOthersCommand}"/>
                                                    <MenuItem Header="{loc:KeiString Main.Tab.Menu.CloseToRight}" Command="{Binding RequestCloseToRightCommand}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <!-- SecureCRT 风格 3px 宽状态指示竖条，替代原圆点 -->
                                                <Border Width="3" Height="16" CornerRadius="1" VerticalAlignment="Center"
                                                        Background="{Binding State, Converter={StaticResource ConnectionStateBrush}}"/>
                                                <!-- 远端标题可能很长（如 byobu 的 user@host (ip) - byobu）：限宽省略，完整内容见悬停提示 -->
                                                <TextBlock Classes="tabTitle" Text="{Binding Title}" VerticalAlignment="Center" FontSize="12"
                                                           MaxWidth="220" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Kei.Text.Primary}"/>
                                                <!-- 后台标签有新输出 / 响铃 -->
                                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                         Fill="{DynamicResource Kei.Accent}"
                                                         IsVisible="{Binding HasActivity}"/>
                                                <Button Classes="closeBtn"
                                                        Content="✕"
                                                        ToolTip.Tip="{loc:KeiString Main.Tab.CloseTip}"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseWorkspaceTabCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:NewTabViewModel" x:DataType="vm:NewTabViewModel">
                                        <Button Classes="tabItem" Classes.selected="{Binding IsSelected}" DragDrop.AllowDrop="True"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectWorkspaceTabCommand}"
                                                CommandParameter="{Binding}" ToolTip.Tip="{Binding ToolTip}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Terminal}" Width="14" Height="14"/>
                                                <TextBlock Classes="tabTitle" Text="{Binding Title}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Kei.Text.Primary}" VerticalAlignment="Center"/>
                                                <Button Classes="closeBtn" Content="✕" ToolTip.Tip="{loc:KeiString Main.Tab.CloseTip}"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseWorkspaceTabCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Column="1" Classes="iconBtn" Width="28" Height="28" Margin="4,0"
                                ToolTip.Tip="{loc:KeiString Menu.File.NewTab}" Command="{Binding NewTabCommand}">
                            <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.NewSession}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 空态提供与菜单相同的操作和平台快捷键。 -->
                <Panel x:Name="TerminalContainer" Grid.Row="1">
                    <Border Background="{DynamicResource Kei.Bg.Window}"
                            IsVisible="{Binding !HasTabs}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="24" MaxWidth="400">
                            <TextBlock Text="{loc:KeiString Main.Empty.Title}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Kei.Text.Primary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:KeiString Main.Empty.Description}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Kei.Text.Secondary}" TextAlignment="Center" Margin="0,0,0,6"/>
                            <Button x:Name="WelcomeQuickConnectButton" Classes="accent" Command="{Binding QuickConnectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Text="{loc:KeiString Menu.File.QuickConnect}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding QuickConnectShortcutLabel}" FontSize="12"/>
                                </Grid>
                            </Button>
                            <Button x:Name="WelcomeNewSessionButton" Command="{Binding CreateSessionCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Text="{loc:KeiString Menu.File.NewSession}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding NewSessionShortcutLabel}" FontSize="12"
                                               Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding NewTabs}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Panel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:NewTabViewModel" x:DataType="vm:NewTabViewModel">
                                <views:NewTabView HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 每个标签单独承载 Terminal 实例，避免切换时卸载与焦点失效。 -->
                    <ItemsControl ItemsSource="{Binding Tabs}" IsVisible="{Binding HasTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Panel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:TerminalTabViewModel" x:DataType="vm:TerminalTabViewModel">
                                <Grid IsVisible="{Binding IsSelected}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition>
                                            <ColumnDefinition.Width>
                                                <MultiBinding Converter="{x:Static conv:FileManagerColumnWidthConverter.Instance}" ConverterParameter="Left">
                                                    <Binding Path="IsFileManagerVisible"/>
                                                    <Binding Path="IsFileManagerOnLeft"/>
                                                </MultiBinding>
                                            </ColumnDefinition.Width>
                                        </ColumnDefinition>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition>
                                            <ColumnDefinition.Width>
                                                <MultiBinding Converter="{x:Static conv:FileManagerColumnWidthConverter.Instance}" ConverterParameter="Right">
                                                    <Binding Path="IsFileManagerVisible"/>
                                                    <Binding Path="IsFileManagerOnLeft"/>
                                                </MultiBinding>
                                            </ColumnDefinition.Width>
                                        </ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <!-- 终端控件：根据 IsFileManagerOnLeft 动态停靠在 Column 0 或 Column 2。
                                         外层 ScrollViewer 提供回滚滚动条（TerminalControl 实现 ILogicalScrollable）；
                                         底色取配色背景，覆盖网格贴底后顶部的余量区域 -->
                                    <Border Grid.Column="{Binding IsFileManagerOnLeft, Converter={x:Static conv:FileManagerDockConverter.Instance}, ConverterParameter=Terminal}"
                                            Background="{Binding TerminalBackground}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:KeiString Terminal.Menu.Copy}" Command="{Binding CopySelectionCommand}"/>
                                                <MenuItem Header="{loc:KeiString Terminal.Menu.Paste}" Command="{Binding PasteToTerminalCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="{loc:KeiString Terminal.Menu.SelectAll}" Command="{Binding SelectAllTerminalTextCommand}"/>
                                                <MenuItem Header="{loc:KeiString Terminal.Menu.Clear}" Command="{Binding ClearTerminalScreenCommand}"/>
                                                <MenuItem Header="{loc:KeiString Terminal.Menu.ClearScrollback}" Command="{Binding ClearTerminalScrollbackCommand}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <ScrollViewer Classes="terminalScroll"
                                                      Content="{Binding Terminal}"
                                                      Background="Transparent"
                                                      AllowAutoHide="False"
                                                      VerticalScrollBarVisibility="Visible"
                                                      HorizontalScrollBarVisibility="Disabled"/>
                                    </Border>

                                    <!-- 分割条：固定在 Column 1，仅在文件管理器侧栏展开时呈现 -->
                                    <GridSplitter Grid.Column="1" Width="4"
                                                  Background="{DynamicResource Kei.Bg.PanelAlt}"
                                                  ResizeDirection="Columns"
                                                  IsVisible="{Binding IsFileManagerVisible}"/>

                                    <!-- 文件管理器侧栏视图：根据 IsFileManagerOnLeft 动态停靠在 Column 0 或 Column 2 -->
                                    <views:RemoteFileManagerView Grid.Column="{Binding $parent[Grid].((vm:TerminalTabViewModel)DataContext).IsFileManagerOnLeft, Converter={x:Static conv:FileManagerDockConverter.Instance}, ConverterParameter=FileManager}"
                                                                 DataContext="{Binding FileManager}"
                                                                 IsVisible="{Binding $parent[Grid].((vm:TerminalTabViewModel)DataContext).IsFileManagerVisible}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>

                <!-- Row2 撰写栏：显示条件 = 撰写栏开关打开且有选中标签 -->
                <Border Grid.Row="2"
                        Background="{DynamicResource Kei.Bg.PanelAlt}"
                        BorderBrush="{DynamicResource Kei.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="8,6">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsComposeBarVisible"/>
                            <Binding Path="SelectedTab" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                        </MultiBinding>
                    </Border.IsVisible>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{loc:KeiString Main.Compose.PreInput}"
                                   Classes.multiline="{Binding IsMultiLineCompose}"
                                   Foreground="{DynamicResource Kei.Text.Muted}"
                                   Margin="0,0,8,0">
                            <!-- 多行模式贴顶，单行模式居中 -->
                            <TextBlock.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style Selector="TextBlock.multiline">
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="Margin" Value="0,6,8,0"/>
                                </Style>
                            </TextBlock.Styles>
                        </TextBlock>

                        <!-- 单行模式输入框：回车发送 -->
                        <TextBox Grid.Column="1"
                                 IsVisible="{Binding IsSingleLineCompose}"
                                 Text="{Binding ComposeText}"
                                 PlaceholderText="{Binding ComposePlaceholder}"
                                 AcceptsReturn="False"
                                 Background="{DynamicResource Kei.Bg.Panel}"
                                 Foreground="{DynamicResource Kei.Text.Primary}"
                                 BorderBrush="{DynamicResource Kei.Border}"
                                 CornerRadius="3"
                                 Padding="6,4">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SendComposeCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>

                        <!-- 多行模式输入框：Ctrl+Enter 发送，Enter 换行 -->
                        <TextBox Grid.Column="1"
                                 Classes="multiline"
                                 IsVisible="{Binding IsMultiLineCompose}"
                                 Text="{Binding ComposeText}"
                                 PlaceholderText="{Binding ComposePlaceholder}"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 MinHeight="70"
                                 MaxHeight="180"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource Kei.Bg.Panel}"
                                 Foreground="{DynamicResource Kei.Text.Primary}"
                                 BorderBrush="{DynamicResource Kei.Border}"
                                 CornerRadius="3"
                                 Padding="8,6">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendComposeCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>

                        <!-- 发送按钮：多行贴顶，单行居中 -->
                        <Button Grid.Column="2"
                                Content="{loc:KeiString Main.Compose.Send}"
                                Command="{Binding SendComposeCommand}"
                                Classes.multiline="{Binding IsMultiLineCompose}"
                                Background="{DynamicResource Kei.Accent}"
                                Foreground="{DynamicResource Kei.Accent.Foreground}"
                                Margin="8,0,0,0"
                                Padding="12,5"
                                CornerRadius="3">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style Selector="Button.multiline">
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            <!-- 仅在未固定且收起时命中；覆盖布局不占用终端宽度。 -->
            <Border x:Name="SessionManagerRevealZone" Grid.ColumnSpan="3" Width="6" HorizontalAlignment="Left"
                    Background="Transparent" IsVisible="False" IsHitTestVisible="False" ZIndex="11"/>
        </Grid>
        <Grid x:Name="CommandPaletteOverlay" Grid.RowSpan="3" IsVisible="False" Background="Transparent" ZIndex="1000"
              PointerPressed="CommandPaletteOverlay_PointerPressed">
            <ContentControl x:Name="CommandPaletteHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12"/>
        </Grid>
    </Grid>
</Window>
