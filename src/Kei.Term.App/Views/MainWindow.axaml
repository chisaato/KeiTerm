<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kei.Term.App.ViewModels"
        xmlns:views="using:Kei.Term.App.Views"
        xmlns:models="using:Kei.Term.Core.Models"
        xmlns:conv="using:Kei.Term.App.Converters"
        xmlns:loc="using:Kei.Term.App.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:Class="Kei.Term.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{loc:KeiString Main.Title}"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="600"
        FontFamily="Noto Sans CJK SC, Source Han Sans SC, Microsoft YaHei UI, Segoe UI, sans-serif"
        Background="{DynamicResource Kei.Bg.Window}">

    <Window.Resources>

        <conv:ConnectionStateBrushConverter x:Key="ConnectionStateBrush"/>
        <conv:TabStatusBrushConverter x:Key="TabStatusBrush"/>
    </Window.Resources>

    <Window.Styles>
        <!-- 侧栏树：统一由基类 TreeNodeBase 绑定 IsExpanded，消除子类型强转与样式冲突。
             注意：必须用 .sessionTree 限定作用域，否则会级联命中文件管理面板的 TreeViewItem，
             导致其 RemoteDirectoryNodeViewModel 被强转为 TreeNodeBase 而抛绑定异常。 -->
        <Style Selector=".sessionTree TreeViewItem" x:DataType="models:TreeNodeBase">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>

        <Style Selector=".sessionTree TreeViewItem /template/ Border#PART_LayoutRoot">
            <Setter Property="Padding" Value="2,1"/>
        </Style>

        <!-- 拖拽悬停视觉反馈样式：合法目标微亮强调 + 亮蓝左边线，禁止目标微红警示 -->
        <Style Selector=".sessionTree TreeViewItem.drop-target-valid /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Kei.Accent}"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
        </Style>
        <Style Selector=".sessionTree TreeViewItem.drop-target-valid">
            <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Kei.Accent}"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
        </Style>
        <Style Selector=".sessionTree TreeViewItem.drop-target-invalid /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#33E53935"/>
        </Style>
        <Style Selector=".sessionTree TreeViewItem.drop-target-invalid">
            <Setter Property="Background" Value="#33E53935"/>
        </Style>

        <!-- 控件外观类样式（iconBtn/tabItem/closeBtn）已迁至 DesignSystem/KeiControls.axaml，
             仅 KeiClassic 档挂载，使 Semi/Material 档可由第三方库模板接管。 -->
    </Window.Styles>

    <!-- 快捷键：Ctrl+Q 打开快速连接，Ctrl+N 新建会话 -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Q" Command="{Binding QuickConnectCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateSessionCommand}"/>
    </Window.KeyBindings>

    <!-- 根布局：Row0 菜单 / Row1 全宽工具栏 / Row2 左右分栏（SecureCRT 式：菜单与工具栏横贯顶部） -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*">

        <!-- Row0 菜单栏：全宽（Avalonia 12 顶层 Menu 即菜单栏） -->
        <Menu Grid.Row="0"
              Background="{DynamicResource Kei.Bg.PanelAlt}"
              Foreground="{DynamicResource Kei.Text.Primary}"
              MinHeight="30">
            <MenuItem Header="{loc:KeiString Menu.File}">
                <MenuItem Header="{loc:KeiString Menu.File.NewSession}" Command="{Binding CreateSessionCommand}" InputGesture="Ctrl+N"/>
                <MenuItem Header="{loc:KeiString Menu.File.NewFolder}" Command="{Binding CreateFolderCommand}"/>
                <MenuItem Header="{loc:KeiString Menu.File.QuickConnect}" Command="{Binding QuickConnectCommand}" InputGesture="Ctrl+Q"/>
                <Separator/>
                <MenuItem Header="{loc:KeiString Menu.File.ImportSecureCrt}" Command="{Binding ImportSecureCrtCommand}"/>
                <MenuItem Header="{loc:KeiString Menu.File.ImportOpenSshConfig}" Command="{Binding ImportOpenSshConfigCommand}"/>
                <MenuItem Header="{loc:KeiString Menu.File.ImportKnownHosts}" Command="{Binding ImportKnownHostsCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:KeiString Menu.File.Connect}" Command="{Binding ConnectSelectedSessionCommand}"/>
                <MenuItem Header="{loc:KeiString Menu.File.DisconnectTab}" Command="{Binding DisconnectCurrentTabCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:KeiString Menu.File.Exit}" Click="OnExitMenuClick"/>
            </MenuItem>
            <MenuItem Header="{loc:KeiString Menu.Edit}">
                <MenuItem Header="{loc:KeiString Menu.Edit.Cut}" Command="{Binding CutNodeCommand}"/>
                <MenuItem Header="{loc:KeiString Menu.Edit.Copy}" Command="{Binding CopyNodeCommand}"/>
                <MenuItem Header="{loc:KeiString Menu.Edit.Paste}" Command="{Binding PasteNodeCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:KeiString Menu.Edit.DeleteSelected}" Command="{Binding DeleteSelectedNodeCommand}"/>
            </MenuItem>
            <MenuItem Header="{loc:KeiString Menu.View}">
                <MenuItem Header="{loc:KeiString Menu.View.SessionManager}" ToggleType="CheckBox" IsChecked="{Binding IsSessionManagerVisible, Mode=TwoWay}"/>
                <MenuItem Header="{loc:KeiString Menu.View.Compose}">
                    <MenuItem Header="{loc:KeiString Menu.View.Compose.Show}" ToggleType="CheckBox" IsChecked="{Binding IsComposeBarVisible, Mode=TwoWay}"/>
                    <Separator/>
                    <MenuItem Header="{loc:KeiString Menu.View.Compose.SingleLine}" ToggleType="CheckBox" IsChecked="{Binding IsSingleLineCompose, Mode=TwoWay}"/>
                    <MenuItem Header="{loc:KeiString Menu.View.Compose.MultiLine}" ToggleType="CheckBox" IsChecked="{Binding IsMultiLineCompose, Mode=TwoWay}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{loc:KeiString Menu.Appearance}">
                <MenuItem Header="{loc:KeiString Menu.Appearance.Import}">
                    <MenuItem Header="{loc:KeiString Menu.Appearance.Import.Konsole}" Command="{Binding ImportKonsoleCommand}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{loc:KeiString Menu.Tools}">
                <MenuItem Header="{loc:KeiString Menu.Tools.IdentityManager}" Command="{Binding OpenIdentityManagerCommand}"/>
                <MenuItem Header="{loc:KeiString Menu.Tools.Settings}" Command="{Binding OpenSettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="{loc:KeiString Menu.Help}">
                <MenuItem Header="{loc:KeiString Menu.Help.About}" Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <!-- Row1 全局工具栏：会话/应用操作组在左，状态消息居中，视图开关在右 -->
        <Border Grid.Row="1"
                Background="{DynamicResource Kei.Bg.PanelAlt}"
                BorderBrush="{DynamicResource Kei.Border}"
                BorderThickness="0,0,0,1"
                Padding="6,3"
                MinHeight="38">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- 全局功能操作组（连接、工具、设置） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <!-- 连接操作区 -->
                    <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.QuickConnectTip}" Command="{Binding QuickConnectCommand}">
                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.QuickConnect}"/>
                    </Button>
                    <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.ConnectSelected}" Command="{Binding ConnectSelectedSessionCommand}">
                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Connect}"/>
                    </Button>
                    <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.DisconnectTab}" Command="{Binding DisconnectCurrentTabCommand}">
                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Disconnect}"/>
                    </Button>

                    <Separator Classes="toolSep"/>

                    <!-- 工具与设置区 -->
                    <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.IdentityManager}" Command="{Binding OpenIdentityManagerCommand}">
                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Key}"/>
                    </Button>
                    <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.Settings}" Command="{Binding OpenSettingsCommand}">
                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Settings}"/>
                    </Button>
                </StackPanel>

                <!-- 暂态状态提示（如粘贴目标无效） -->
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource Kei.Status.Connecting}"
                           IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="8,0"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 视图控制区（文件管理） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Classes="iconBtn" ToolTip.Tip="切换文件管理侧栏" Command="{Binding ToggleFileManagerCommand}">
                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.FileManager}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row2 左右分栏：左连接管理器 / 中分割条 / 右内容区 -->
        <Grid x:Name="MainSplitGrid" Grid.Row="2" ColumnDefinitions="260,4,*">

            <!-- 左：连接管理器（树操作工具栏 → 过滤框 → 目录树/空态） -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Kei.Bg.Panel}"
                    BorderBrush="{DynamicResource Kei.Border}"
                    BorderThickness="0,0,1,0"
                    IsVisible="{Binding IsSessionManagerVisible}">
                <Grid RowDefinitions="Auto,Auto,*">

                    <!-- Row0 面板头：专属于会话管理器的操作工具栏（新建会话/目录、剪切、复制、粘贴、折叠全部） -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource Kei.Bg.PanelAlt}"
                            BorderBrush="{DynamicResource Kei.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="6,3">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.NewSession}" Command="{Binding CreateSessionCommand}">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.NewSession}"/>
                            </Button>
                            <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.NewFolder}" Command="{Binding CreateFolderCommand}">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.NewFolder}"/>
                            </Button>

                            <Separator Classes="toolSep"/>

                            <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.Cut}" Command="{Binding CutNodeCommand}">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Cut}"/>
                            </Button>
                            <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.Copy}" Command="{Binding CopyNodeCommand}">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Copy}"/>
                            </Button>
                            <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.Paste}" Command="{Binding PasteNodeCommand}">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Paste}"/>
                            </Button>

                            <Separator Classes="toolSep"/>

                            <Button Classes="iconBtn" ToolTip.Tip="{loc:KeiString Toolbar.CollapseAll}" Command="{Binding CollapseAllCommand}">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.CollapseAll}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Row1 过滤框：即时过滤，右侧内嵌收起面板按钮 -->
                    <Grid Grid.Row="1" Margin="6,6,6,4">
                        <TextBox Text="{Binding FilterText}"
                                 PlaceholderText="{loc:KeiString Main.Filter.Placeholder}"
                                 Background="{DynamicResource Kei.Bg.PanelAlt}"
                                 Foreground="{DynamicResource Kei.Text.Primary}"
                                 BorderBrush="{DynamicResource Kei.Border}"
                                 CornerRadius="4"
                                 Padding="6,4,26,4"
                                 FontSize="12"/>
                        <Button Classes="iconBtn" Width="20" Height="20"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                                ToolTip.Tip="{loc:KeiString Main.SessionManager.CollapseTip}"
                                Command="{Binding ToggleSessionManagerCommand}">
                            <TextBlock Text="«" FontSize="12" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                        </Button>
                    </Grid>

                    <!-- Row2 目录树 + 空树引导态 -->
                    <Grid Grid.Row="2">
                        <TreeView x:Name="SessionTree"
                                  Classes="sessionTree"
                                  ItemsSource="{Binding TreeNodes}"
                                  SelectedItem="{Binding SelectedTreeNode}"
                                  DoubleTapped="Tree_DoubleTapped"
                                  DragDrop.AllowDrop="True"
                                  Background="Transparent">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:KeiString Tree.Menu.NewSession}" Command="{Binding CreateSessionCommand}"/>
                                    <MenuItem Header="{loc:KeiString Tree.Menu.NewFolder}" Command="{Binding CreateFolderCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="{loc:KeiString Tree.Menu.EditSelected}" Command="{Binding EditSelectedNodeCommand}"/>
                                    <MenuItem Header="{loc:KeiString Tree.Menu.DeleteSelected}" Command="{Binding DeleteSelectedNodeCommand}"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.DataTemplates>
                                <!-- 虚拟根 "Sessions"：观感与文件夹同构，名称 SemiBold 以区分层级 -->
                                <TreeDataTemplate DataType="models:VirtualRootNode" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,1">
                                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Folder}"
                                              Width="{DynamicResource Kei.Tree.IconSize}"
                                              Height="{DynamicResource Kei.Tree.IconSize}"
                                              Fill="{DynamicResource Kei.Text.Muted}"/>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Kei.Text.Primary}"
                                                   FontSize="{DynamicResource Kei.Tree.FontSize}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </TreeDataTemplate>
                                <!-- 文件夹模板：灰色文件夹图形 -->
                                <TreeDataTemplate DataType="models:FolderNode" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,1">
                                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Folder}"
                                              Width="{DynamicResource Kei.Tree.IconSize}"
                                              Height="{DynamicResource Kei.Tree.IconSize}"
                                              Fill="{DynamicResource Kei.Text.Muted}"/>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Kei.Text.Primary}"
                                                   FontSize="{DynamicResource Kei.Tree.FontSize}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TreeDataTemplate>
                                <!-- 会话模板：终端风格图形，双击或右键连接 -->
                                <DataTemplate DataType="models:SessionNode">
                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,1">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:KeiString Tree.Menu.Connect}"
                                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenSessionCommand}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="{loc:KeiString Tree.Menu.Edit}"
                                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditSelectedNodeCommand}"/>
                                                <MenuItem Header="{loc:KeiString Tree.Menu.Delete}"
                                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteSelectedNodeCommand}"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Terminal}"
                                              Width="{DynamicResource Kei.Tree.IconSize}"
                                              Height="{DynamicResource Kei.Tree.IconSize}"
                                              Fill="{DynamicResource Kei.Session.Foreground}"/>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Kei.Session.Foreground}"
                                                   FontSize="{DynamicResource Kei.Tree.FontSize}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.DataTemplates>
                        </TreeView>

                        <!-- 空树引导态 -->
                        <StackPanel IsVisible="{Binding !HasNodes}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="10"
                                    Margin="16">
                            <TextBlock Text="{loc:KeiString Tree.EmptyGuide}" Foreground="{DynamicResource Kei.Text.Muted}" HorizontalAlignment="Center" FontSize="13"/>
                            <Button Content="{loc:KeiString Tree.AddFirstSession}"
                                    Command="{Binding CreateSessionCommand}"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource Kei.Accent}"
                                    Foreground="White"
                                    Padding="10,6"
                                    CornerRadius="4"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 中：垂直分割条 -->
            <GridSplitter Grid.Column="1"
                          Background="{DynamicResource Kei.Bg.PanelAlt}"
                          ResizeDirection="Columns"
                          IsVisible="{Binding IsSessionManagerVisible}"/>

            <!-- 右：主内容区（标签条 → 终端区 → 撰写栏） -->
            <Grid x:Name="RightContentGrid" Grid.Column="2" RowDefinitions="Auto,*,Auto">

                <!-- 标签条：状态指示竖条 + 标题 + 关闭；无标签时整行隐藏 -->
                <Border x:Name="TabsBarBorder"
                        Grid.Row="0"
                        Background="{DynamicResource Kei.Bg.Panel}"
                        BorderBrush="{DynamicResource Kei.Border}"
                        BorderThickness="0,0,0,1"
                        IsVisible="{Binding HasTabs}">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="TabsItemsControl" ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TerminalTabViewModel">
                                    <Button Classes="tabItem"
                                            Classes.selected="{Binding IsSelected}"
                                            DragDrop.AllowDrop="True"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectTabCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding StatusMessage}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,5">
                                            <!-- SecureCRT 风格 3px 宽状态指示竖条，替代原圆点 -->
                                            <Border Width="3" Height="16" CornerRadius="1" VerticalAlignment="Center"
                                                    Background="{Binding State, Converter={StaticResource ConnectionStateBrush}}"/>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{DynamicResource Kei.Text.Primary}"/>
                                            <Button Classes="closeBtn"
                                                    Content="✕"
                                                    ToolTip.Tip="{loc:KeiString Main.Tab.CloseTip}"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseTabCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- 终端区：无标签时纯色填充，无任何文字 -->
                <Panel x:Name="TerminalContainer" Grid.Row="1">
                    <Border Background="{DynamicResource Kei.Bg.Window}"
                            IsVisible="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNull}}"/>
                    <!-- 终端区：无标签时纯色填充，有标签时通过 ItemsControl 单独承载每个标签的 Terminal 实例，避免 ContentControl 切换带来的卸载与焦点失效 -->
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Panel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:TerminalTabViewModel">
                                <Grid IsVisible="{Binding IsSelected}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition>
                                            <ColumnDefinition.Width>
                                                <MultiBinding Converter="{x:Static conv:FileManagerColumnWidthConverter.Instance}" ConverterParameter="Left">
                                                    <Binding Path="IsFileManagerVisible"/>
                                                    <Binding Path="IsFileManagerOnLeft"/>
                                                </MultiBinding>
                                            </ColumnDefinition.Width>
                                        </ColumnDefinition>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition>
                                            <ColumnDefinition.Width>
                                                <MultiBinding Converter="{x:Static conv:FileManagerColumnWidthConverter.Instance}" ConverterParameter="Right">
                                                    <Binding Path="IsFileManagerVisible"/>
                                                    <Binding Path="IsFileManagerOnLeft"/>
                                                </MultiBinding>
                                            </ColumnDefinition.Width>
                                        </ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <!-- 终端控件：根据 IsFileManagerOnLeft 动态停靠在 Column 0 或 Column 2 -->
                                    <ContentControl Grid.Column="{Binding IsFileManagerOnLeft, Converter={x:Static conv:FileManagerDockConverter.Instance}, ConverterParameter=Terminal}"
                                                    Content="{Binding Terminal}"
                                                    Background="{DynamicResource Kei.Bg.Window}">
                                        <ContentControl.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="复制 (Copy)" Command="{Binding CopySelectionCommand}"/>
                                                <MenuItem Header="粘贴 (Paste)" Command="{Binding PasteToTerminalCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="全选 (Select All)" Command="{Binding SelectAllTerminalTextCommand}"/>
                                                <MenuItem Header="清屏 (Clear)" Command="{Binding ClearTerminalScreenCommand}"/>
                                            </ContextMenu>
                                        </ContentControl.ContextMenu>
                                    </ContentControl>

                                    <!-- 分割条：固定在 Column 1，仅在文件管理器侧栏展开时呈现 -->
                                    <GridSplitter Grid.Column="1" Width="4"
                                                  Background="{DynamicResource Kei.Bg.PanelAlt}"
                                                  ResizeDirection="Columns"
                                                  IsVisible="{Binding IsFileManagerVisible}"/>

                                    <!-- 文件管理器侧栏视图：根据 IsFileManagerOnLeft 动态停靠在 Column 0 或 Column 2 -->
                                    <views:RemoteFileManagerView Grid.Column="{Binding $parent[Grid].((vm:TerminalTabViewModel)DataContext).IsFileManagerOnLeft, Converter={x:Static conv:FileManagerDockConverter.Instance}, ConverterParameter=FileManager}"
                                                                 DataContext="{Binding FileManager}"
                                                                 IsVisible="{Binding $parent[Grid].((vm:TerminalTabViewModel)DataContext).IsFileManagerVisible}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>

                <!-- Row2 撰写栏：显示条件 = 撰写栏开关打开且有选中标签 -->
                <Border Grid.Row="2"
                        Background="{DynamicResource Kei.Bg.PanelAlt}"
                        BorderBrush="{DynamicResource Kei.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="8,6">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsComposeBarVisible"/>
                            <Binding Path="SelectedTab" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                        </MultiBinding>
                    </Border.IsVisible>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{loc:KeiString Main.Compose.PreInput}"
                                   Classes.multiline="{Binding IsMultiLineCompose}"
                                   Foreground="{DynamicResource Kei.Text.Muted}"
                                   Margin="0,0,8,0">
                            <!-- 多行模式贴顶，单行模式居中 -->
                            <TextBlock.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style Selector="TextBlock.multiline">
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="Margin" Value="0,6,8,0"/>
                                </Style>
                            </TextBlock.Styles>
                        </TextBlock>

                        <!-- 单行模式输入框：回车发送 -->
                        <TextBox Grid.Column="1"
                                 IsVisible="{Binding IsSingleLineCompose}"
                                 Text="{Binding ComposeText}"
                                 PlaceholderText="{Binding ComposePlaceholder}"
                                 AcceptsReturn="False"
                                 Background="{DynamicResource Kei.Bg.Panel}"
                                 Foreground="{DynamicResource Kei.Text.Primary}"
                                 BorderBrush="{DynamicResource Kei.Border}"
                                 CornerRadius="3"
                                 Padding="6,4">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SendComposeCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>

                        <!-- 多行模式输入框：Ctrl+Enter 发送，Enter 换行 -->
                        <TextBox Grid.Column="1"
                                 Classes="multiline"
                                 IsVisible="{Binding IsMultiLineCompose}"
                                 Text="{Binding ComposeText}"
                                 PlaceholderText="{Binding ComposePlaceholder}"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 MinHeight="70"
                                 MaxHeight="180"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource Kei.Bg.Panel}"
                                 Foreground="{DynamicResource Kei.Text.Primary}"
                                 BorderBrush="{DynamicResource Kei.Border}"
                                 CornerRadius="3"
                                 Padding="8,6">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendComposeCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>

                        <!-- 发送按钮：多行贴顶，单行居中 -->
                        <Button Grid.Column="2"
                                Content="{loc:KeiString Main.Compose.Send}"
                                Command="{Binding SendComposeCommand}"
                                Classes.multiline="{Binding IsMultiLineCompose}"
                                Background="{DynamicResource Kei.Accent}"
                                Foreground="White"
                                Margin="8,0,0,0"
                                Padding="12,5"
                                CornerRadius="3">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style Selector="Button.multiline">
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
