<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kei.Term.App.ViewModels"
        xmlns:loc="using:Kei.Term.App.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="480"
        x:Class="Kei.Term.App.Views.VaultSecretLibraryWindow"
        x:DataType="vm:VaultSecretLibraryViewModel"
        Title="{loc:KeiString VaultSecretLibrary.Title}"
        Width="780" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Kei.Bg.Window}"
        FontFamily="{DynamicResource Kei.Font.UI}">

    <Grid RowDefinitions="Auto, *, Auto" Margin="14,12">
        <!-- 顶部操作工具栏 -->
        <Border Grid.Row="0" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                <!-- 左侧新建/导入操作 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ImportPrivateKeyButton"
                            Command="{Binding CreatePrivateKeyCommand}"
                            AutomationProperties.Name="{loc:KeiString VaultSecretLibrary.ImportPrivateKey}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Key}"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{loc:KeiString VaultSecretLibrary.ImportPrivateKey}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NewPasswordButton"
                            Command="{Binding CreatePasswordCommand}"
                            AutomationProperties.Name="{loc:KeiString VaultSecretLibrary.NewPassword}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Add}"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{loc:KeiString VaultSecretLibrary.NewPassword}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Classes="toolSep"/>

                    <Button x:Name="RenameButton"
                            Command="{Binding RenameCommand}"
                            CommandParameter="{Binding #SecretList.SelectedItem}"
                            IsEnabled="{Binding #SecretList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                            AutomationProperties.Name="{loc:KeiString VaultSecretLibrary.Rename}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Edit}"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{loc:KeiString VaultSecretLibrary.Rename}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="DeleteButton"
                            Classes="danger"
                            Command="{Binding DeleteCommand}"
                            CommandParameter="{Binding #SecretList.SelectedItem}"
                            IsEnabled="{Binding #SecretList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                            AutomationProperties.Name="{loc:KeiString VaultSecretLibrary.Delete}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Delete}"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{loc:KeiString VaultSecretLibrary.Delete}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 右侧「仅显示无引用」过滤开关 -->
                <CheckBox x:Name="UnreferencedOnlyCheckBox"
                          Grid.Column="2"
                          IsChecked="{Binding UnreferencedOnly, Mode=TwoWay}"
                          Content="{loc:KeiString VaultSecretLibrary.UnreferencedOnly}"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 材料列表主体（含列头与数据行） -->
        <Border Grid.Row="1" Background="{DynamicResource Kei.Bg.Panel}" BorderBrush="{DynamicResource Kei.Border}" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto, *">
                <!-- 列头栏 -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Kei.Bg.PanelAlt}"
                        BorderBrush="{DynamicResource Kei.Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Padding="12,6">
                    <Grid ColumnDefinitions="2*, 80, 3*, 90" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{loc:KeiString VaultSecretLibrary.Column.Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                        <TextBlock Grid.Column="1" Text="{loc:KeiString VaultSecretLibrary.Column.Kind}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                        <TextBlock Grid.Column="2" Text="{loc:KeiString VaultSecretLibrary.Column.Fingerprint}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                        <TextBlock Grid.Column="3" Text="{loc:KeiString VaultSecretLibrary.Column.References}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Kei.Text.Secondary}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- 列表项 -->
                <ListBox x:Name="SecretList"
                         Grid.Row="1"
                         Classes="popupList"
                         ItemsSource="{Binding Items}"
                         Background="Transparent"
                         SelectionChanged="OnSecretListSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VaultSecretListItemViewModel">
                            <Grid ColumnDefinitions="2*, 80, 3*, 90" ColumnSpacing="10" Margin="0,2">
                                <TextBlock Grid.Column="0"
                                           Classes="popupPrimary"
                                           Text="{Binding Name}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Classes="popupSecondary"
                                           Text="{Binding KindLabel}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Classes="popupMuted"
                                           Text="{Binding Fingerprint}"
                                           FontFamily="{DynamicResource Kei.Font.Mono}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Classes="popupSecondary"
                                           Text="{Binding ReferenceCount, StringFormat={loc:KeiString VaultSecretLibrary.ReferenceCountFormat}}"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空态提示 -->
                <TextBlock Grid.Row="1"
                           Text="{loc:KeiString VaultSecretLibrary.Empty}"
                           Foreground="{DynamicResource Kei.Text.Muted}"
                           FontSize="12.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !Items.Count}"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- 底部关闭按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Button x:Name="CloseButton"
                    Content="{loc:KeiString Common.Close}"
                    Click="CloseButton_Click"
                    Width="80"
                    HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>