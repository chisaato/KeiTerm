<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kei.Term.App.ViewModels"
        xmlns:vault="using:Kei.Term.Core.Vault"
        xmlns:loc="using:Kei.Term.App.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="380"
        x:Class="Kei.Term.App.Views.IdentityManagerWindow"
        x:DataType="vm:IdentityManagerViewModel"
        Title="{loc:KeiString IdentityManager.Title}"
        Width="700" Height="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Kei.Bg.Window}"
        FontFamily="{DynamicResource Kei.Font.UI}">

    <Window.Styles>
        <!-- 紧凑列表项内距，消除 Fluent 默认过大的垂直留白 -->
        <Style Selector="ListBoxItem" x:DataType="vault:Identity">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        </Style>
    </Window.Styles>

    <!-- 紧凑边距布局：上下留白收至 12px，外框更贴合内容 -->
    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="14,12">

        <!-- 明文写入警示横幅：条件 = Vault 当前为明文模式（未初始化或已选明文） -->
        <Border x:Name="PlainModeWarning" Grid.Row="0" IsVisible="{Binding IsPlainMode}"
                Background="{DynamicResource Kei.Bg.PanelAlt}" BorderBrush="{DynamicResource Kei.Border.Subtle}" BorderThickness="1"
                CornerRadius="{DynamicResource Kei.Radius.Card}" Padding="10,8" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                <Viewbox Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                    <Grid Width="24" Height="24">
                        <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Warning}"
                              Fill="{DynamicResource Kei.Status.Connecting}"/>
                    </Grid>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="{loc:KeiString IdentityManager.PlainWarning}"
                           Foreground="{DynamicResource Kei.Text.Primary}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="{loc:KeiString IdentityManager.SetMasterPassword}" Command="{Binding SetMasterPasswordCommand}"/>
            </Grid>
        </Border>

        <!-- 顶部操作栏 -->
        <Border Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AddIdentityButton" Command="{Binding AddIdentityCommand}" AutomationProperties.Name="{loc:KeiString IdentityManager.NewIdentity}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Add}"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="{loc:KeiString IdentityManager.NewIdentity}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="EditIdentityButton" Command="{Binding EditIdentityCommand}"
                        AutomationProperties.Name="{loc:KeiString IdentityManager.EditIdentity}"
                        IsEnabled="{Binding SelectedIdentity, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Edit}"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="{loc:KeiString IdentityManager.EditIdentity}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteIdentityButton" Classes="danger" Command="{Binding DeleteIdentityCommand}"
                        AutomationProperties.Name="{loc:KeiString IdentityManager.DeleteIdentity}"
                        IsEnabled="{Binding SelectedIdentity, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Delete}"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="{loc:KeiString IdentityManager.DeleteIdentity}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="LockVaultButton" Command="{Binding LockVaultCommand}" IsVisible="{Binding CanLockVault}"
                        AutomationProperties.Name="{loc:KeiString IdentityManager.LockVault}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Lock}"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="{loc:KeiString IdentityManager.LockVault}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 身份列表 -->
        <Border Grid.Row="2" Background="{DynamicResource Kei.Bg.Panel}" BorderBrush="{DynamicResource Kei.Border}" BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="IdentityList" Classes="popupList" ItemsSource="{Binding Identities}" SelectedItem="{Binding SelectedIdentity}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vault:Identity">
                        <Grid ColumnDefinitions="*, 160, 140" ColumnSpacing="12" Margin="0,2">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Classes="popupPrimary" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Classes="popupMuted" Text="{Binding Description}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="4" VerticalAlignment="Center"
                                  IsVisible="{Binding Username, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Classes="popupSecondary" Text="{loc:KeiString IdentityManager.UserLabel}"/>
                                <TextBlock Classes="popupSecondary" Grid.Column="1" Text="{Binding Username}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <TextBlock Classes="popupSecondary" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                       Text="{Binding Methods.Count, StringFormat={loc:KeiString IdentityManager.MethodCountFormat}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 底部说明 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
            <TextBlock Text="{loc:KeiString IdentityManager.OrderHint}" Foreground="{DynamicResource Kei.Text.Muted}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="{loc:KeiString Common.Close}" Click="CloseButton_Click" Width="80" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
