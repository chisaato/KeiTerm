<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Kei.Term.App.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="280"
        x:Class="Kei.Term.App.Views.VaultSecretInputWindow"
        Title="{loc:KeiString VaultSecretLibrary.Title}"
        Width="460"
        SizeToContent="Height"
        MinHeight="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource Kei.Bg.Window}"
        FontFamily="{DynamicResource Kei.Font.UI}">

    <Grid RowDefinitions="*, Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="12">
            <!-- 标题提示 -->
            <TextBlock x:Name="HeaderBlock"
                       FontWeight="SemiBold"
                       FontSize="13.5"
                       Foreground="{DynamicResource Kei.Text.Primary}"/>

            <!-- 通用：材料名称 -->
            <Grid ColumnDefinitions="84, *">
                <TextBlock Grid.Column="0"
                           Text="{loc:KeiString VaultSecretInput.Name}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Kei.Text.Secondary}"/>
                <TextBox Grid.Column="1"
                         x:Name="NameBox"
                         PlaceholderText="{loc:KeiString VaultSecretInput.Name.Placeholder}"/>
            </Grid>

            <!-- 密码模式专属面板 -->
            <Grid x:Name="PasswordPanel" ColumnDefinitions="84, *">
                <TextBlock Grid.Column="0"
                           Text="{loc:KeiString VaultSecretInput.Password}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Kei.Text.Secondary}"/>
                <TextBox Grid.Column="1"
                         x:Name="PasswordBox"
                         PasswordChar="•"/>
            </Grid>

            <!-- 私钥模式专属面板 -->
            <StackPanel x:Name="PrivateKeyPanel" Spacing="10" IsVisible="False">
                <Grid ColumnDefinitions="84, *, Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               Text="{loc:KeiString VaultSecretInput.PrivateKeyFile}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Kei.Text.Secondary}"/>
                    <TextBox Grid.Column="1"
                             x:Name="KeyFilePathBox"
                             PlaceholderText="{loc:KeiString VaultSecretInput.PrivateKeyFile.Placeholder}"/>
                    <Button Grid.Column="2"
                            x:Name="BrowseButton"
                            Content="{loc:KeiString Common.Browse}"
                            Click="OnBrowseKey"/>
                </Grid>

                <Grid ColumnDefinitions="84, *">
                    <TextBlock Grid.Column="0"
                               Text="{loc:KeiString VaultSecretInput.Passphrase}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Kei.Text.Secondary}"/>
                    <TextBox Grid.Column="1"
                             x:Name="PassphraseBox"
                             PasswordChar="•"
                             PlaceholderText="{loc:KeiString VaultSecretInput.Passphrase.Placeholder}"/>
                </Grid>
            </StackPanel>

            <!-- 错误提示 -->
            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource Kei.Status.Error}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       IsVisible="False"/>
        </StackPanel>

        <!-- 底部操作按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
            <Button x:Name="CancelButton"
                    Content="{loc:KeiString Common.Cancel}"
                    Click="OnCancel"
                    IsCancel="True"
                    Width="80"
                    HorizontalContentAlignment="Center"/>
            <Button x:Name="ConfirmButton"
                    Content="{loc:KeiString Common.Confirm}"
                    Click="OnConfirm"
                    IsDefault="True"
                    Width="80"
                    HorizontalContentAlignment="Center"
                    Classes="accent"/>
        </StackPanel>
    </Grid>
</Window>