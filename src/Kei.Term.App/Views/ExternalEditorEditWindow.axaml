<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kei.Term.App.ViewModels"
        xmlns:loc="using:Kei.Term.App.Helpers"
        x:Class="Kei.Term.App.Views.ExternalEditorEditWindow"
        x:DataType="vm:ExternalEditorEditViewModel"
        Title="{Binding Title}"
        Width="540" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Kei.Bg.Window}"
        FontFamily="{DynamicResource Kei.Font.UI}" FontSize="13">
    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12" Margin="18">
        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
            <TextBlock Text="名称" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
            <TextBox x:Name="EditorNameTextBox" Grid.Column="1" Text="{Binding Name}" PlaceholderText="如 VS Code"/>

            <TextBlock Grid.Row="1" Text="操作系统" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
            <ComboBox x:Name="EditorOsComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding SupportedOsList}" SelectedItem="{Binding SelectedOs}"/>

            <TextBlock Grid.Row="2" Text="命令 / 路径" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="EditorPathTextBox" Text="{Binding Path}" PlaceholderText="如 code 或应用程序路径"/>
                <Button x:Name="BrowseEditorButton" Grid.Column="1" Content="选择应用…"
                        Command="{Binding BrowseCommand}" IsEnabled="{Binding CanBrowse}"/>
            </Grid>

            <CheckBox Grid.Row="3" Grid.Column="1" Content="设为默认编辑器" IsChecked="{Binding IsDefault}" MinHeight="28"/>
        </Grid>
        <SelectableTextBlock Grid.Row="1" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                             FontSize="12" Foreground="{DynamicResource Kei.Status.Error}" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Content="{loc:KeiString Common.Cancel}" Command="{Binding CancelCommand}" MinWidth="76" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="{loc:KeiString Common.Save}" Command="{Binding SaveCommand}" MinWidth="76" Classes="accent" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
