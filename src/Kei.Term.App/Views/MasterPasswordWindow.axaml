<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Kei.Term.App.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="210"
        x:Class="Kei.Term.App.Views.MasterPasswordWindow"
        Title="{loc:KeiString MasterPassword.Title}"
        Width="430" MinHeight="220" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource Kei.Bg.Window}"
        FontFamily="{DynamicResource Kei.Font.UI}">

    <Grid RowDefinitions="*, Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="{loc:KeiString MasterPassword.Header}" FontWeight="Bold" Foreground="{DynamicResource Kei.Text.Primary}" FontSize="14"/>

            <TextBox x:Name="PasswordBox" PasswordChar="•" PlaceholderText="{loc:KeiString MasterPassword.Placeholder}"/>

            <TextBlock x:Name="HintText"
                       Text="{loc:KeiString MasterPassword.Hint}"
                       FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" TextWrapping="Wrap"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource Kei.Status.Error}" FontSize="12" TextWrapping="Wrap"
                       IsVisible="False"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button Content="{loc:KeiString Common.Cancel}" Click="OnCancel" Width="85" HorizontalContentAlignment="Center"/>
            <Button Content="{loc:KeiString MasterPassword.Unlock}" Click="OnConfirm" Width="85" HorizontalContentAlignment="Center"
                    Classes="accent" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
