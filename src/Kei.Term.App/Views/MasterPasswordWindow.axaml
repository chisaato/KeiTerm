<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Kei.Term.App.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="210"
        x:Class="Kei.Term.App.Views.MasterPasswordWindow"
        Title="{loc:KeiString MasterPassword.Title}"
        Width="430" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="#1E1E1E">

    <Grid RowDefinitions="*, Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="12">
            <TextBlock Text="{loc:KeiString MasterPassword.Header}" FontWeight="Bold" Foreground="#4EC9B0" FontSize="14"/>

            <TextBox x:Name="PasswordBox" PasswordChar="•" PlaceholderText="{loc:KeiString MasterPassword.Placeholder}"/>

            <TextBlock x:Name="HintText"
                       Text="{loc:KeiString MasterPassword.Hint}"
                       FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap"
                       IsVisible="False"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,14,0,0">
            <Button Content="{loc:KeiString Common.Cancel}" Click="OnCancel" Width="85" HorizontalContentAlignment="Center"/>
            <Button Content="{loc:KeiString MasterPassword.Unlock}" Click="OnConfirm" Width="85" HorizontalContentAlignment="Center"
                    Classes="accent"/>
        </StackPanel>
    </Grid>
</Window>
