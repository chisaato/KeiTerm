<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Kei.Term.App.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="300"
        x:Class="Kei.Term.App.Views.MasterPasswordWindow"
        Title="{loc:KeiString MasterPassword.Title}"
        Width="440" MinHeight="220" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource Kei.Bg.Window}"
        FontFamily="{DynamicResource Kei.Font.UI}">

    <StackPanel Margin="20" Spacing="12">
        <Grid ColumnDefinitions="36,*" ColumnSpacing="12">
            <Border Width="36" Height="36" VerticalAlignment="Center"
                    Background="{DynamicResource Kei.Bg.Card}" BorderBrush="{DynamicResource Kei.Border.Subtle}"
                    BorderThickness="1" CornerRadius="{DynamicResource Kei.Radius.Card}">
                <Viewbox Width="20" Height="20" Stretch="Uniform">
                    <Grid Width="24" Height="24">
                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Lock}"
                              Width="24" Height="24" Stretch="None" Stroke="{DynamicResource Kei.Accent}"/>
                    </Grid>
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" Text="{loc:KeiString MasterPassword.Header}"
                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Kei.Text.Primary}"/>
                <TextBlock x:Name="DescriptionText" Text="{loc:KeiString MasterPassword.Description}"
                           FontSize="12" Foreground="{DynamicResource Kei.Text.Secondary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="QuickUnlockSection" IsVisible="False" Spacing="8">
            <Button x:Name="QuickUnlockButton" Classes="accent" IsVisible="False" Click="OnQuickUnlock"
                    Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                <Border Height="1" Background="{DynamicResource Kei.Border.Subtle}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{loc:KeiString MasterPassword.Or}"
                           FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}"/>
                <Border Grid.Column="2" Height="1" Background="{DynamicResource Kei.Border.Subtle}" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="{loc:KeiString MasterPassword.PasswordLabel}" FontSize="13"
                       Foreground="{DynamicResource Kei.Text.Primary}"/>
            <Grid ColumnDefinitions="*,88" ColumnSpacing="8">
                <TextBox x:Name="PasswordBox" PasswordChar="•" Height="32"
                         PlaceholderForeground="{DynamicResource Kei.Text.Muted}"
                         PlaceholderText="{loc:KeiString MasterPassword.Placeholder}"/>
                <Button x:Name="PasswordUnlockButton" Grid.Column="1" Content="{loc:KeiString MasterPassword.Unlock}"
                        Click="OnConfirm" Height="32" HorizontalAlignment="Stretch" Classes="accent" IsDefault="True"/>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock x:Name="HintText" Text="{loc:KeiString MasterPassword.Hint}"
                       FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ErrorText" IsVisible="False"
                       FontSize="12" Foreground="{DynamicResource Kei.Status.Error}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border BorderBrush="{DynamicResource Kei.Border.Subtle}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <Button Content="{loc:KeiString Common.Cancel}" Click="OnCancel" MinWidth="88" HorizontalAlignment="Right"/>
        </Border>
    </StackPanel>
</Window>
