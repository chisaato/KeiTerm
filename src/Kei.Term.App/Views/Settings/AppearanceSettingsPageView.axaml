<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kei.Term.App.ViewModels"
             xmlns:settings="using:Kei.Term.App.ViewModels.Settings"
             xmlns:services="using:Kei.Term.App.Services"
             xmlns:profiles="using:Kei.Term.Core.Models.Profiles"
             xmlns:controls="using:Kei.Term.App.Views.Settings.Controls"
             xmlns:loc="using:Kei.Term.App.Helpers"
             x:Class="Kei.Term.App.Views.Settings.AppearanceSettingsPageView"
             x:DataType="settings:AppearanceSettingsPage">

    <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Spacing="16">
        <!-- 页头：面包屑 + 标题 + 描述 -->
        <controls:SettingsPageHeader Group="{loc:KeiString Settings.Groups.App}"
                                     Title="{loc:KeiString Settings.Categories.Appearance}"
                                     Description="{loc:KeiString Settings.Categories.AppearanceDesc}"
                                     SubPageTitle="{Binding CurrentSubPage.Title}"
                                     BackCommand="{Binding NavigateBackCommand}"/>

        <Panel>
            <!-- 主内容区：未在子页时显示 -->
            <Grid ColumnDefinitions="1.1*,*" ColumnSpacing="16" IsVisible="{Binding !IsInSubPage}">
                <!-- 左列：设置卡片 -->
                <StackPanel Grid.Column="0" Spacing="16">
                    <!-- 1. 布局模式卡片 -->
                    <Border Classes="settingsCard">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="settingsSectionTitle" Text="{loc:KeiString Settings.Appearance.LayoutModeSection}"/>

                            <controls:SettingRow Title="{loc:KeiString Settings.Appearance.LayoutMode}"
                                                 Description="{loc:KeiString Settings.Appearance.LayoutModeTip}">
                                <ComboBox MinWidth="200"
                                          HorizontalAlignment="Right"
                                          ItemsSource="{Binding LayoutModeOptions}"
                                          SelectedItem="{Binding SelectedLayoutMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="settings:LayoutModeOption">
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>

                    <!-- 2. 主题与界面外观档案卡片 -->
                    <Border Classes="settingsCard">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="settingsSectionTitle" Text="{loc:KeiString Settings.Appearance.ThemeSection}"/>

                            <controls:SettingRow Title="{loc:KeiString Settings.Appearance.ThemeMode}"
                                                 Description="{loc:KeiString Settings.Appearance.ThemeModeTip}">
                                <ComboBox MinWidth="200"
                                          HorizontalAlignment="Right"
                                          ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedTheme}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="settings:ThemeOption">
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:SettingRow>

                            <Border Classes="settingRowDivider"/>

                            <controls:SettingRow Title="{loc:KeiString Settings.Appearance.GuiProfile}"
                                                 Description="{loc:KeiString Settings.Appearance.GuiProfileTip}">
                                <ComboBox MinWidth="200"
                                          HorizontalAlignment="Right"
                                          ItemsSource="{Binding GuiProfiles}"
                                          SelectedItem="{Binding SelectedGuiProfile}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="profiles:GuiProfile">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>

                    <!-- 3. 界面字体卡片（含回退字体下钻） -->
                    <Border Classes="settingsCard">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="settingsSectionTitle" Text="{loc:KeiString Settings.Appearance.UiFontSection}"/>

                            <controls:SettingRow Title="{loc:KeiString Settings.Appearance.UiFontFamily}"
                                                 Description="{loc:KeiString Settings.Appearance.UiFontFamilyTip}">
                                <AutoCompleteBox MinWidth="200"
                                                 HorizontalAlignment="Right"
                                                 ItemsSource="{Binding AvailableFonts}"
                                                 SelectedItem="{Binding SelectedUiFont}"
                                                 ItemFilter="{Binding FontItemFilter}"
                                                 FilterMode="Custom" MinimumPrefixLength="0"
                                                 ValueMemberBinding="{CompiledBinding DisplayName, DataType=services:FontFamilyOption}">
                                    <AutoCompleteBox.ItemTemplate>
                                        <DataTemplate x:DataType="services:FontFamilyOption">
                                            <TextBlock Text="{Binding DisplayName}" FontFamily="{Binding FontFamily}"/>
                                        </DataTemplate>
                                    </AutoCompleteBox.ItemTemplate>
                                </AutoCompleteBox>
                            </controls:SettingRow>

                            <Border Classes="settingRowDivider"/>

                            <controls:DrillDownRow Title="{loc:KeiString Settings.Appearance.AdvancedFallbackFonts}"
                                                   Description="{loc:KeiString Settings.Appearance.FallbackFontsHint}"
                                                   Summary="{Binding UiFallbackFontsSummary}"
                                                   Command="{Binding DrillDownUiFallbackFontsCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. 外观配置备份卡片 -->
                    <Border Classes="settingsCard">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="settingsSectionTitle" Text="{loc:KeiString Settings.Appearance.ProfileBackupSection}"/>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:KeiString Settings.Appearance.ExportBundle}"
                                        Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).ExportBundleCommand}"
                                        ToolTip.Tip="{loc:KeiString Settings.Appearance.ExportBundleTip}"/>
                                <Button Content="{loc:KeiString Settings.Appearance.ImportBundle}"
                                        Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).ImportBundleCommand}"
                                        ToolTip.Tip="{loc:KeiString Settings.Appearance.ImportBundleTip}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右列：实时界面字体预览卡片 -->
                <Border x:Name="UiFontPreviewPanel" Grid.Column="1" VerticalAlignment="Top"
                        Background="{DynamicResource Kei.Bg.Card}" BorderBrush="{DynamicResource Kei.Border.Subtle}"
                        BorderThickness="1" CornerRadius="{DynamicResource Kei.Radius.Card}" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:KeiString Settings.Appearance.FontPreviewSection}" FontSize="12" FontWeight="SemiBold"
                                   FontFamily="{Binding UiPreviewFontFamily}" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                        <TextBlock Text="KeiTerm 工作区" FontSize="14" FontWeight="SemiBold"
                                   FontFamily="{Binding UiPreviewFontFamily}" Foreground="{DynamicResource Kei.Text.Primary}"/>
                        <TextBlock Text="{loc:KeiString Settings.Appearance.UiFontPreviewSample}" FontFamily="{Binding UiPreviewFontFamily}"
                                   FontSize="13" Foreground="{DynamicResource Kei.Text.Primary}" TextWrapping="Wrap"/>
                        <Border Height="1" Background="{DynamicResource Kei.Border.Subtle}" Margin="0,4"/>
                        <TextBlock Text="会话 · 文件管理 · 应用设置" FontSize="13" TextWrapping="Wrap"
                                   FontFamily="{Binding UiPreviewFontFamily}" Foreground="{DynamicResource Kei.Text.Primary}"/>
                        <TextBlock Text="筛选会话、选择编辑器与保存配置" FontSize="12" TextWrapping="Wrap"
                                   FontFamily="{Binding UiPreviewFontFamily}" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                        <TextBlock Text="主机：192.168.1.100 / 端口：22" FontSize="12" TextWrapping="Wrap"
                                   FontFamily="{Binding UiPreviewFontFamily}" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                        <Border Height="1" Background="{DynamicResource Kei.Border.Subtle}" Margin="0,4"/>
                        <TextBlock Text="已连接 · root@server" FontSize="12" TextWrapping="Wrap"
                                   FontFamily="{Binding UiPreviewFontFamily}" Foreground="{DynamicResource Kei.Session.Foreground}"/>
                        <TextBlock Text="正在连接 · 请稍候" FontSize="12" TextWrapping="Wrap"
                                   FontFamily="{Binding UiPreviewFontFamily}" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                        <TextBlock Text="连接失败 · 检查主机与端口" FontSize="12" TextWrapping="Wrap"
                                   FontFamily="{Binding UiPreviewFontFamily}" Foreground="{DynamicResource Kei.Status.Error}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 子页面内容区：进入子页后显示 -->
            <ContentControl Content="{Binding CurrentSubPage.Content}"
                            IsVisible="{Binding IsInSubPage}"/>
        </Panel>
    </StackPanel>
</UserControl>
