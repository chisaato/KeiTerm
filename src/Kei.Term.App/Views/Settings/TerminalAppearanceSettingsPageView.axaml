<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kei.Term.App.ViewModels"
             xmlns:settings="using:Kei.Term.App.ViewModels.Settings"
             xmlns:services="using:Kei.Term.App.Services"
             xmlns:profiles="using:Kei.Term.Core.Models.Profiles"
             xmlns:controls="using:Kei.Term.App.Views.Controls"
             xmlns:scontrols="using:Kei.Term.App.Views.Settings.Controls"
             xmlns:loc="using:Kei.Term.App.Helpers"
             x:Class="Kei.Term.App.Views.Settings.TerminalAppearanceSettingsPageView"
             x:DataType="settings:TerminalAppearanceSettingsPage">

    <Grid RowDefinitions="Auto, *" HorizontalAlignment="Stretch">
        <!-- 页头：面包屑 + 标题 + 描述 -->
        <scontrols:SettingsPageHeader Grid.Row="0"
                                      Group="{loc:KeiString Settings.Groups.Terminal}"
                                      Title="{loc:KeiString Settings.Categories.TerminalAppearance}"
                                      Description="{loc:KeiString Settings.Categories.TerminalAppearanceDesc}"
                                      SubPageTitle="{Binding Appearance.SubPageTitle}"
                                      BackCommand="{Binding Appearance.NavigateBackCommand}"
                                      Margin="0,0,0,16"/>

        <Panel Grid.Row="1">
            <!-- 主内容区：未在子页时显示 -->
            <scontrols:AdaptiveColumnsGrid ColumnSpacing="16" IsVisible="{Binding !Appearance.IsInSubPage}">
                <!-- 左列：设置卡片（独立滚动） -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="{StaticResource Kei.Settings.ContentMaxWidth}"/>
                            <ColumnDefinition Width="0.001*"/>
                        </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="16">
                    <!-- 单项导入与整体备份分开；菜单直接说明会修改配色还是字体。 -->
                    <DropDownButton x:Name="TerminalAppearanceImportButton" HorizontalAlignment="Right"
                                    DataContext="{Binding $parent[Window].((vm:SettingsViewModel)DataContext)}"
                                    x:DataType="vm:SettingsViewModel"
                                    Content="{loc:KeiString Settings.Appearance.ImportMenu}"
                                    AutomationProperties.Name="{loc:KeiString Settings.Appearance.ImportMenu}"
                                    Height="28" Padding="10,0">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{loc:KeiString Settings.Appearance.ImportColorKonsole}"
                                          AutomationProperties.Name="{loc:KeiString Settings.Appearance.ImportColorKonsole}"
                                          Command="{Binding ImportKonsoleSchemeCommand}">
                                    <MenuItem.Icon>
                                        <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
                                            <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Terminal}"/>
                                        </Grid></Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ImportTerminalThemeJsonMenuItem"
                                          Header="{loc:KeiString Settings.Appearance.ImportColorJson}"
                                          AutomationProperties.Name="{loc:KeiString Settings.Appearance.ImportColorJson}"
                                          Command="{Binding ImportTerminalThemeJsonCommand}">
                                    <MenuItem.Icon>
                                        <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
                                            <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.File}"/>
                                        </Grid></Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{loc:KeiString Settings.Appearance.ImportFontKonsole}"
                                          AutomationProperties.Name="{loc:KeiString Settings.Appearance.ImportFontKonsole}"
                                          Command="{Binding ImportKonsoleFontCommand}">
                                    <MenuItem.Icon>
                                        <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
                                            <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Compose}"/>
                                        </Grid></Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <!-- 1. 终端配色方案档案卡片 -->
                    <Border Classes="settingsCard" DataContext="{Binding Appearance}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="settingsSectionTitle" Text="{loc:KeiString Settings.Appearance.TerminalProfile}"/>

                            <scontrols:SettingRow Title="{loc:KeiString Settings.Appearance.TerminalProfile}"
                                                 Description="{loc:KeiString Settings.Appearance.TerminalProfileTip}">
                                <ComboBox MinWidth="200"
                                          HorizontalAlignment="Right"
                                          ItemsSource="{Binding TerminalProfiles}"
                                          SelectedItem="{Binding SelectedTerminalProfile}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="profiles:TerminalProfile">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Classes="profileUserTag"
                                                        IsVisible="{Binding !IsBuiltIn}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:KeiString Settings.Appearance.UserProfileTag}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource Kei.Text.Secondary}"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </scontrols:SettingRow>

                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button Content="{loc:KeiString Settings.Appearance.NewTerminalProfile}"
                                        Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).NewTerminalProfileCommand}"
                                        Height="28" Padding="10,0" Margin="0,0,8,0"/>
                                <Button Content="{loc:KeiString Settings.Appearance.EditTerminalProfile}"
                                        Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).EditTerminalProfileCommand}"
                                        Height="28" Padding="10,0" Margin="0,0,8,0"/>
                                <Button Classes="danger"
                                        Content="{loc:KeiString Settings.Appearance.DeleteTerminalProfile}"
                                        Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).DeleteTerminalProfileCommand}"
                                        IsEnabled="{Binding CanDeleteSelectedTerminalProfile}"
                                        Height="28" Padding="10,0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. 终端等宽字体与字号卡片（含回退字体下钻） -->
                    <Border Classes="settingsCard" DataContext="{Binding Appearance}">
                        <StackPanel Spacing="10">
                            <!-- 卡片标题与当前字体摘要；导入入口统一放在页首。 -->
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Classes="settingsSectionTitle"
                                           Text="{loc:KeiString Settings.Appearance.FontSection}"
                                           VerticalAlignment="Center"/>

                                <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Orientation="Horizontal"
                                           VerticalAlignment="Center">
                                    <TextBlock Text="{loc:KeiString Settings.Appearance.FontSummaryLabel}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Kei.Text.Secondary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding FontSummary}"
                                               FontFamily="{Binding SelectedFont.FontFamily, FallbackValue={x:Null}}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Kei.Text.Primary}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </WrapPanel>
                            </Grid>

                            <Border Classes="settingRowDivider"/>

                            <!-- 主字体 -->
                            <scontrols:SettingRow Title="{loc:KeiString Settings.Appearance.FontFamily}"
                                                 Description="{loc:KeiString Settings.Appearance.FontFamilyTip}">
                                <AutoCompleteBox Classes="settingsFontPicker" Width="240"
                                                 ItemTemplate="{StaticResource SettingsFontOptionTemplate}"
                                                 HorizontalAlignment="Right"
                                                 ItemsSource="{Binding AvailableFonts}"
                                                 SelectedItem="{Binding SelectedFont}"
                                                 ItemFilter="{Binding FontItemFilter}"
                                                 FilterMode="Custom"
                                                 MinimumPrefixLength="0"
                                                 ValueMemberBinding="{CompiledBinding DisplayName, DataType=services:FontFamilyOption}">
                                </AutoCompleteBox>
                            </scontrols:SettingRow>

                            <ContentControl Template="{StaticResource SettingsFontLegendTemplate}"/>
                            <Border Classes="settingRowDivider"/>

                            <!-- 字重 -->
                            <scontrols:SettingRow Title="{loc:KeiString Settings.Appearance.FontWeight}"
                                                 Description="{loc:KeiString Settings.Appearance.FontWeightTip}">
                                <ComboBox MinWidth="200"
                                          HorizontalAlignment="Right"
                                          ItemsSource="{Binding AvailableFontWeights}"
                                          SelectedItem="{Binding SelectedFontWeight}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="settings:FontWeightOption">
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </scontrols:SettingRow>

                            <Border Classes="settingRowDivider"/>

                            <!-- 字号 -->
                            <scontrols:SettingRow Title="{loc:KeiString Settings.Appearance.FontSize}"
                                                 Description="{loc:KeiString Settings.Appearance.FontSizeTip}">
                                <NumericUpDown MinWidth="200"
                                               HorizontalAlignment="Right"
                                               Value="{Binding FontSize}" Minimum="8" Maximum="36" FormatString="0.0"/>
                            </scontrols:SettingRow>

                            <Border Classes="settingRowDivider"/>

                            <!-- 光标闪烁 -->
                            <scontrols:SettingRow Title="{loc:KeiString Settings.Appearance.CursorBlink}"
                                                 Description="{loc:KeiString Settings.Appearance.CursorBlinkTip}">
                                <ToggleSwitch IsChecked="{Binding CursorBlink}"
                                              OnContent="" OffContent=""
                                              HorizontalAlignment="Right"/>
                            </scontrols:SettingRow>

                            <Border Classes="settingRowDivider"/>

                            <!-- 回退字体下钻行 -->
                            <scontrols:DrillDownRow Title="{loc:KeiString Settings.Appearance.AdvancedFallbackFonts}"
                                                   Description="{loc:KeiString Settings.Appearance.FallbackFontsHint}"
                                                   Summary="{Binding TerminalFallbackFontsSummary}"
                                                   Command="{Binding DrillDownTerminalFallbackFontsCommand}"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 右列：终端实时渲染预览（固定不动） -->
                <Border x:Name="TerminalPreviewBorder" VerticalAlignment="Stretch"
                        Background="{DynamicResource Kei.Bg.Card}" BorderBrush="{DynamicResource Kei.Border.Subtle}"
                        BorderThickness="1" CornerRadius="{DynamicResource Kei.Radius.Card}" Padding="12">
                    <Grid RowDefinitions="Auto, *" RowSpacing="10">
                        <TextBlock Grid.Row="0" Text="{loc:KeiString Settings.Appearance.LivePreview}" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource Kei.Text.Primary}"/>
                        <controls:TerminalShellPreviewView Grid.Row="1"
                                                           MinHeight="160"
                                                           VerticalAlignment="Stretch"
                                                           HorizontalAlignment="Stretch"
                                                           Profile="{Binding Appearance.SelectedTerminalProfile}"
                                                           Font="{Binding Appearance.DraftFontSnapshot}"/>
                    </Grid>
                </Border>
            </scontrols:AdaptiveColumnsGrid>

            <!-- 子页面内容区：进入子页后显示（此时整页由外层 ScrollViewer 滚动） -->
            <ContentControl Content="{Binding Appearance.SubPageContent}"
                            IsVisible="{Binding Appearance.IsInSubPage}"/>
        </Panel>
    </Grid>
</UserControl>
