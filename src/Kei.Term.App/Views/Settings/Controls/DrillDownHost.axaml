<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Kei.Term.App.Views.Settings.Controls"
             x:Class="Kei.Term.App.Views.Settings.Controls.DrillDownHost"
             x:DataType="controls:DrillDownHost">
    <!-- 下钻宿主：主内容与子页面内容切换容器 -->
    <Grid>
        <!-- 主内容区：未进入子页时显示 -->
        <ContentControl Content="{Binding Content, RelativeSource={RelativeSource AncestorType=controls:DrillDownHost}}"
                        IsVisible="{Binding !HasSubPage, RelativeSource={RelativeSource AncestorType=controls:DrillDownHost}}"/>

        <!-- 子页面内容区：进入子页后显示 -->
        <ContentControl Content="{Binding SubPageContent, RelativeSource={RelativeSource AncestorType=controls:DrillDownHost}}"
                        IsVisible="{Binding HasSubPage, RelativeSource={RelativeSource AncestorType=controls:DrillDownHost}}"/>
    </Grid>
</UserControl>
