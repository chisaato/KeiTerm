<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Kei.Term.App.Views.Settings.Controls"
             x:Class="Kei.Term.App.Views.Settings.Controls.DrillDownRow"
             x:DataType="controls:DrillDownRow">
    <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="32">
        <!-- 可选行内前置开关（如启用校验、启用归档） -->
        <CheckBox Grid.Column="0"
                  IsVisible="{Binding HasSwitch, RelativeSource={RelativeSource AncestorType=controls:DrillDownRow}}"
                  IsChecked="{Binding SwitchChecked, RelativeSource={RelativeSource AncestorType=controls:DrillDownRow}, Mode=TwoWay}"
                  VerticalAlignment="Center"
                  Margin="0,0,10,0"/>

        <!-- 标题与说明 -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,2,16,2">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=controls:DrillDownRow}}"
                       FontSize="13"
                       Foreground="{DynamicResource Kei.Text.Primary}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType=controls:DrillDownRow}}"
                       FontSize="12"
                       Foreground="{DynamicResource Kei.Text.Muted}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasDescription, RelativeSource={RelativeSource AncestorType=controls:DrillDownRow}}"/>
        </StackPanel>

        <!-- 右侧：摘要文本 + "编辑 ›" 按钮 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="{Binding Summary, RelativeSource={RelativeSource AncestorType=controls:DrillDownRow}}"
                       FontSize="12"
                       Foreground="{DynamicResource Kei.Text.Secondary}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="260"/>
            <Button Content="{Binding ActionLabel, RelativeSource={RelativeSource AncestorType=controls:DrillDownRow}}"
                    Command="{Binding Command, RelativeSource={RelativeSource AncestorType=controls:DrillDownRow}}"
                    CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=controls:DrillDownRow}}"
                    IsEnabled="{Binding IsActionEnabled, RelativeSource={RelativeSource AncestorType=controls:DrillDownRow}}"
                    Padding="10,4"
                    Height="28"
                    VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
