<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Kei.Term.App.Views.Settings.Controls"
        xmlns:services="using:Kei.Term.App.Services"
        xmlns:loc="using:Kei.Term.App.Helpers">
    <Styles.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://Kei.Term.App/DesignSystem/KeiFontIcons.axaml"/>
        </ResourceDictionary.MergedDictionaries>
        <!-- 四个字体选择器共享单行布局；星号列在弹层约束内截断，不按长字族名扩宽。 -->
        <DataTemplate x:Key="SettingsFontOptionTemplate" x:DataType="services:FontFamilyOption">
            <Grid ColumnSpacing="4" MinHeight="24"
                  ToolTip.Tip="{Binding DisplayName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}" FontFamily="{Binding FontFamily}"
                           FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ContentControl Grid.Column="1" Content="{Binding}"
                                ContentTemplate="{StaticResource SettingsFontSymbolsTemplate}"/>
            </Grid>
        </DataTemplate>
        <!-- 始终保留两个槽位；仅隐藏内部图形，不改变相邻字族名称的可用宽度。 -->
        <DataTemplate x:Key="SettingsFontSymbolsTemplate" x:DataType="services:FontFamilyOption">
            <Grid ColumnDefinitions="24,24" Height="24" Classes="fontSymbols">
                <Border Background="Transparent" IsVisible="{Binding IsMonospaceRecommended}"
                        AutomationProperties.Name="{loc:KeiString Fonts.Tag.Monospace}"
                        ToolTip.Tip="{loc:KeiString Fonts.Tag.Monospace}">
                    <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
                        <Path Classes="kei-icon fontSymbol" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.FontMonospace}"/>
                    </Grid></Viewbox>
                </Border>
                <Grid Grid.Column="1">
                    <Border Background="Transparent" IsVisible="{Binding HasSingleCellIcons}"
                            AutomationProperties.Name="{loc:KeiString Fonts.Variant.NerdMono}"
                            ToolTip.Tip="{loc:KeiString Fonts.Variant.NerdMono}">
                        <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
                            <Path Classes="kei-icon fontSymbol" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.FontSingleCell}"/>
                        </Grid></Viewbox>
                    </Border>
                    <Border Background="Transparent" IsVisible="{Binding HasDoubleCellIcons}"
                            AutomationProperties.Name="{loc:KeiString Fonts.Variant.NerdStandard}"
                            ToolTip.Tip="{loc:KeiString Fonts.Variant.NerdStandard}">
                        <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
                            <Path Classes="kei-icon fontSymbol" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.FontDoubleCell}"/>
                        </Grid></Viewbox>
                    </Border>
                    <Border Background="Transparent" IsVisible="{Binding HasProportionalIcons}"
                            AutomationProperties.Name="{loc:KeiString Fonts.Variant.NerdPropo}"
                            ToolTip.Tip="{loc:KeiString Fonts.Variant.NerdPropo}">
                        <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
                            <Path Classes="kei-icon fontSymbol" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.FontProportional}"/>
                        </Grid></Viewbox>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
        <!-- 可换行的小图例：页面与两个回退字体子页共享，不增加弹层宽度。 -->
        <ControlTemplate x:Key="SettingsFontLegendTemplate">
            <WrapPanel Classes="fontLegend">
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,12,2">
                    <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
                        <Path Classes="kei-icon fontSymbol" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.FontMonospace}"/>
                    </Grid></Viewbox>
                    <TextBlock Text="{loc:KeiString Fonts.Legend.Monospace}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,12,2">
                    <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
                        <Path Classes="kei-icon fontSymbol" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.FontSingleCell}"/>
                    </Grid></Viewbox>
                    <TextBlock Text="{loc:KeiString Fonts.Legend.SingleCell}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,12,2">
                    <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
                        <Path Classes="kei-icon fontSymbol" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.FontDoubleCell}"/>
                    </Grid></Viewbox>
                    <TextBlock Text="{loc:KeiString Fonts.Legend.DoubleCell}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,2">
                    <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
                        <Path Classes="kei-icon fontSymbol" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.FontProportional}"/>
                    </Grid></Viewbox>
                    <TextBlock Text="{loc:KeiString Fonts.Legend.Proportional}"/>
                </StackPanel>
            </WrapPanel>
        </ControlTemplate>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Path.fontSymbol">
        <Setter Property="Stroke" Value="{DynamicResource Kei.Text.Muted}"/>
    </Style>
    <Style Selector="Grid.fontSymbols:pointerover Path.fontSymbol">
        <Setter Property="Stroke" Value="{DynamicResource Kei.Text.Secondary}"/>
    </Style>
    <Style Selector="WrapPanel.fontLegend TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Muted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Fluent 默认仅设 MinWidth，长项会把弹层撑宽；明确锁定到宿主的实际宽度。 -->
    <Style Selector="AutoCompleteBox.settingsFontPicker /template/ Popup#PART_Popup">
        <Setter Property="Width" Value="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"/>
        <Setter Property="MaxWidth" Value="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"/>
    </Style>
    <Style Selector="AutoCompleteBox.settingsFontPicker /template/ ListBox#PART_SelectingItemsControl">
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style Selector="AutoCompleteBox.settingsFontPicker /template/ ListBox#PART_SelectingItemsControl ListBoxItem">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <!-- 设计系统与紧凑桌面密度令牌引用 -->

    <!-- 窄模式预览分隔条：水平拖动，颜色走现有边框令牌 -->
    <!-- 上下分栏时的分隔条：上下留出间隔，细线贯通 + 居中握把，命中区域比视觉线更高便于拖动 -->
    <Style Selector="GridSplitter.settingsPreviewSplitter">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="0,6"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Border}"/>
        <Setter Property="Cursor" Value="SizeNorthSouth"/>
        <Setter Property="ResizeDirection" Value="Rows"/>
        <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <Border Height="1" VerticalAlignment="Center"
                            Background="{DynamicResource Kei.Border.Subtle}"/>
                    <Border Width="48" Height="4" CornerRadius="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{TemplateBinding Background}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="GridSplitter.settingsPreviewSplitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource Kei.Accent.Hover}"/>
    </Style>

    <!-- 单层分组：细线划分职责，不叠加卡片背景。 -->
    <Style Selector="Border.settingsSection">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="0,10,0,0"/>
    </Style>
    <Style Selector="Border.settingsSection.first">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TextBlock.settingsSectionTitle">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
    </Style>

    <!-- 紧凑排序列表：桌面级紧凑内边距与行高 -->
    <Style Selector="ListBox.compactReorderList">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style Selector="ListBox.compactReorderList ListBoxItem">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
    </Style>
    <Style Selector="ListBox.compactReorderList ListBoxItem CheckBox">
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Padding" Value="6,0,0,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 表单字段名居中标签提升为一级文字，增强暗色对比 -->
    <Style Selector="Grid > TextBlock[VerticalAlignment=Center]">
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
    </Style>

    <!-- 保存按钮：常态 Accent，悬停 AccentHover，按下回落 -->
    <Style Selector="Button.save /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Accent.Foreground}"/>
    </Style>
    <Style Selector="Button.save:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Accent.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Accent.Foreground}"/>
    </Style>
    <Style Selector="Button.save:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Accent.Foreground}"/>
    </Style>

    <!-- 面包屑链接式按钮：无背景，悬停时文字加下划线并换为悬停强调色 -->
    <Style Selector="Button.hyperlink">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.hyperlink /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Accent}"/>
    </Style>
    <Style Selector="Button.hyperlink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Accent.Hover}"/>
    </Style>
    <Style Selector="Button.hyperlink:pointerover /template/ ContentPresenter#PART_ContentPresenter > TextBlock">
        <Setter Property="TextDecorations" Value="Underline"/>
    </Style>
    <Style Selector="Button.hyperlink:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Accent}"/>
    </Style>

    <!-- SettingsCard 卡片容器样式 -->
    <Style Selector="Border.settingsCard">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Card}"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <!-- 卡片内高级折叠区：轻量同层开关行，无实心背景，展开后内容直接延续卡片内行列表 -->
    <Style Selector="Border.settingsCard Expander">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Border.settingsCard Expander /template/ ToggleButton#ExpanderHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Secondary}"/>
    </Style>
    <Style Selector="Border.settingsCard Expander /template/ ToggleButton#ExpanderHeader:pointerover">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Accent.Hover}"/>
    </Style>
    <Style Selector="Border.settingsCard Expander /template/ ToggleButton#ExpanderHeader:pointerover Path#ExpandCollapseChevron">
        <Setter Property="Stroke" Value="{DynamicResource Kei.Accent.Hover}"/>
    </Style>
    <Style Selector="Border.settingsCard Expander /template/ ToggleButton#ExpanderHeader /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Border.settingsCard Expander /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector="Border.settingsCard Expander /template/ Border#ExpanderContent">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,8,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Border.settingsCard Expander /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Border.settingsCard Expander > StackPanel">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- SettingsRow 细分隔线样式 -->
    <Style Selector="Border.settingRowDivider">
        <Setter Property="Background" Value="{DynamicResource Kei.Border.Subtle}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

    <!-- SettingRow：标题与说明在左，控件（Content）右对齐 -->
    <Style Selector="controls|SettingRow">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" MinHeight="32">
                    <StackPanel x:Name="PART_Text" Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,2,16,2">
                        <TextBlock Text="{TemplateBinding Title}"
                                   FontSize="13"
                                   Foreground="{DynamicResource Kei.Text.Primary}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{TemplateBinding Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Kei.Text.Muted}"
                                   TextWrapping="Wrap"
                                   IsVisible="{TemplateBinding HasDescription}"/>
                    </StackPanel>
                    <ContentPresenter x:Name="PART_Control" Grid.Column="1"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- 窄行：控件区落到标题说明下方并占满整行 -->
    <Style Selector="controls|SettingRow:narrow /template/ StackPanel#PART_Text">
        <Setter Property="Grid.ColumnSpan" Value="2"/>
        <Setter Property="Margin" Value="0,2,0,6"/>
    </Style>
    <Style Selector="controls|SettingRow:narrow /template/ ContentPresenter#PART_Control">
        <Setter Property="Grid.Row" Value="1"/>
        <Setter Property="Grid.Column" Value="0"/>
        <Setter Property="Grid.ColumnSpan" Value="2"/>
        <!-- 左对齐：呈现为自然宽度，避免调用方控件的右对齐把它推到行尾 -->
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- SettingsCard：标题 + 内容 + 高级折叠区 -->
    <Style Selector="controls|SettingsCard">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Classes="settingsCard">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{TemplateBinding Title}"
                                   Classes="settingsSectionTitle"
                                   IsVisible="{TemplateBinding HasTitle}"/>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        <Expander Header="{TemplateBinding AdvancedHeader}"
                                  IsVisible="{TemplateBinding HasAdvancedContent}"
                                  IsExpanded="{TemplateBinding IsAdvancedExpanded, Mode=TwoWay}"
                                  Margin="0,4,0,0"
                                  Padding="0,8,0,0">
                            <ContentPresenter Content="{TemplateBinding AdvancedContent}"/>
                        </Expander>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- DrillDownRow：标题/说明占剩余宽度，摘要可截断，"编辑 ›" 按钮始终完整显示 -->
    <Style Selector="controls|DrillDownRow">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid MinHeight="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="3*"/>
                        <!-- 摘要列按比例分剩余宽度并设上限，窄宽度下被截断而不是挤压标题 -->
                        <ColumnDefinition Width="2*" MaxWidth="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              IsVisible="{TemplateBinding HasSwitch}"
                              IsChecked="{TemplateBinding SwitchChecked, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,2,16,2">
                        <TextBlock Text="{TemplateBinding Title}"
                                   FontSize="13"
                                   Foreground="{DynamicResource Kei.Text.Primary}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{TemplateBinding Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Kei.Text.Muted}"
                                   TextWrapping="Wrap"
                                   IsVisible="{TemplateBinding HasDescription}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{TemplateBinding Summary}"
                               FontSize="12"
                               Foreground="{DynamicResource Kei.Text.Secondary}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0"/>
                    <Button Grid.Column="3"
                            Content="{TemplateBinding ActionLabel}"
                            Command="{TemplateBinding Command}"
                            CommandParameter="{TemplateBinding CommandParameter}"
                            IsEnabled="{TemplateBinding IsActionEnabled}"
                            Padding="10,4"
                            Height="28"
                            VerticalAlignment="Center"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- 通用紧凑胶囊标签（与现有 DefaultEditorBadge / profileUserTag 统一） -->
    <Style Selector="Border.settingsTag, Border.profileUserTag">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
        <Setter Property="Padding" Value="4,1"/>
    </Style>
</Styles>
