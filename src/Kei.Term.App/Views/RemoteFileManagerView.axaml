<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kei.Term.App.ViewModels"
             xmlns:models="using:Kei.Term.Core.Models"
             xmlns:loc="using:Kei.Term.App.Helpers"
             xmlns:conv="using:Kei.Term.App.Converters"
             x:Class="Kei.Term.App.Views.RemoteFileManagerView"
             x:DataType="vm:RemoteFileManagerViewModel"
             Background="{DynamicResource Kei.Bg.Panel}">

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="TreeViewItem" x:DataType="vm:RemoteDirectoryNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsVisible" Value="{Binding !IsDummy}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" DragDrop.AllowDrop="True">
        <!-- 顶部工具条：标题与操作 -->
        <Border Grid.Row="0" Background="{DynamicResource Kei.Bg.PanelAlt}" BorderBrush="{DynamicResource Kei.Border}" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Viewbox Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Folder}" Stroke="{DynamicResource Kei.Accent}" Width="24" Height="24" Stretch="None"/>
                        </Grid>
                    </Viewbox>
                    <TextBlock Text="文件管理" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Kei.Text.Primary}" VerticalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="40" Height="4" IsVisible="{Binding IsLoading}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="FileManagerDockButton" Classes="iconBtn" Width="28" Height="28" ToolTip.Tip="切换左/右侧停靠" Command="{Binding ToggleDockPositionCommand}" IsVisible="{Binding !IsWorkspaceTab}">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.DockSwap}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="FileManagerOpenInTabButton" Classes="iconBtn" Width="28" Height="28" ToolTip.Tip="{loc:KeiString FileManager.OpenInTab}"
                            AutomationProperties.Name="{loc:KeiString FileManager.OpenInTab}" Command="{Binding PromoteToTabCommand}" IsVisible="{Binding !IsWorkspaceTab}">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.ExternalLink}" Stroke="{DynamicResource Kei.Accent}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button Classes="iconBtn" Width="28" Height="28" ToolTip.Tip="刷新" Command="{Binding RefreshDirectoryCommand}">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Refresh}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="FileManagerCloseButton" Classes="iconBtn" Width="28" Height="28" ToolTip.Tip="{Binding CloseToolTip}"
                            AutomationProperties.Name="{Binding CloseToolTip}" Command="{Binding CloseCommand}">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Close}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 路径导航栏 -->
        <Border Grid.Row="1" Background="{DynamicResource Kei.Bg.Panel}" BorderBrush="{DynamicResource Kei.Border}" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0">
                <Button Classes="iconBtn" Width="28" Height="28" ToolTip.Tip="上一级" Command="{Binding NavigateUpCommand}" Margin="0,0,4,0">
                    <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.ArrowUp}" Width="24" Height="24" Stretch="None"/>
                        </Grid>
                    </Viewbox>
                </Button>
                <TextBox x:Name="FileManagerPathInput" Grid.Column="1" Text="{Binding CurrentPath}" Height="28" Padding="6,2" FontSize="12" VerticalContentAlignment="Center">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding RefreshDirectoryCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <ToggleButton Grid.Column="2" IsChecked="{Binding ShowHiddenFiles}" Width="28" Height="28" MinWidth="28" MinHeight="28" ToolTip.Tip="显示隐藏文件 (.*)" Margin="4,0,0,0" Padding="0">
                    <TextBlock Text=".*" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- 中部文件显示区：SecureCRT 左右双栏结构（左侧目录树 + 分割条 + 右侧文件列表） -->
        <Grid Grid.Row="2" ColumnDefinitions="160,Auto,*">
            <!-- 左栏：远程目录树（仅目录，层级展开，点击切换当前目录） -->
            <TreeView x:Name="DirectoryTreeView"
                      Grid.Column="0"
                      ItemsSource="{Binding DirectoryTreeRoots}"
                      SelectedItem="{Binding SelectedDirectoryNode, Mode=TwoWay}"
                      DoubleTapped="OnDirectoryTreeDoubleTapped"
                      Background="Transparent">
                <TreeView.DataTemplates>
                    <TreeDataTemplate DataType="vm:RemoteDirectoryNodeViewModel" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,1" VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Folder}" Stroke="{DynamicResource Kei.Text.Muted}" Width="24" Height="24" Stretch="None"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Kei.Text.Primary}"/>
                            <ProgressBar IsIndeterminate="True" Width="20" Height="2" IsVisible="{Binding IsLoading}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.DataTemplates>
            </TreeView>

            <!-- 垂直分割条 -->
            <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource Kei.Border}" ResizeDirection="Columns"/>

            <!-- 右栏：当前目录下文件列表（含 .. 回上级、文件图标、大小、权限等） -->
            <ListBox x:Name="FileListBox"
                     Grid.Column="2"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     SelectionMode="Multiple"
                     DoubleTapped="OnListBoxDoubleTapped"
                     PointerPressed="OnListBoxPointerPressed"
                     Background="Transparent">
                <ListBox.ContextMenu>
                    <ContextMenu Opening="OnContextMenuOpening">
                        <MenuItem Header="打开" Command="{Binding EnterOrOpenFileCommand}" CommandParameter="{Binding SelectedItem}"/>
                        <MenuItem Header="打开方式" x:Name="OpenWithSubMenu">
                            <!-- 子项将在 ContextMenu 打开时动态构建 -->
                        </MenuItem>
                        <MenuItem Header="使用系统默认程序打开"
                                  Command="{Binding OpenWithSystemDefaultCommand}"
                                  CommandParameter="{Binding SelectedItem}"/>
                        <MenuItem Header="选择其他本地程序打开..."
                                  Command="{Binding OpenWithCustomExecutableCommand}"
                                  CommandParameter="{Binding SelectedItem}"/>
                        <Separator/>
                        <MenuItem Header="下载到桌面" Command="{Binding DownloadToDesktopCommand}" CommandParameter="{Binding SelectedItem}"/>
                        <MenuItem Header="{loc:KeiString FileManager.CopyRemotePath}" Click="OnCopyRemotePath"/>
                        <Separator/>
                        <MenuItem Header="删除" Command="{Binding DeleteItemCommand}" CommandParameter="{Binding SelectedItem}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:RemoteFileItem">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,1">
                            <!-- 图标 -->
                            <Viewbox Width="14" Height="14" Stretch="Uniform" Grid.Column="0" Margin="0,0,6,0" IsVisible="{Binding IsDirectory}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Folder}" Stroke="{DynamicResource Kei.Text.Muted}" Width="24" Height="24" Stretch="None"/>
                                </Grid>
                            </Viewbox>
                            <Viewbox Width="14" Height="14" Stretch="Uniform" Grid.Column="0" Margin="0,0,6,0" IsVisible="{Binding !IsDirectory}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.File}" Stroke="{DynamicResource Kei.Text.Secondary}" Width="24" Height="24" Stretch="None"/>
                                </Grid>
                            </Viewbox>

                            <!-- 名称 -->
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Kei.Text.Primary}" TextTrimming="CharacterEllipsis"/>

                            <!-- 大小 -->
                            <TextBlock Grid.Column="2" IsVisible="{Binding !IsDirectory}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" Margin="8,0"
                                       ToolTip.Tip="{Binding Size, StringFormat='{}{0} B'}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static conv:FileSizeConverter.Instance}">
                                        <Binding Path="Size"/>
                                        <Binding Path="$parent[UserControl].((vm:RemoteFileManagerViewModel)DataContext).SizeDisplayMode"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <!-- 权限 -->
                            <TextBlock Grid.Column="3" Text="{Binding Permissions}" VerticalAlignment="Center" FontSize="12" FontFamily="{DynamicResource Kei.Font.Mono}" Foreground="{DynamicResource Kei.Text.Muted}" Margin="6,0,2,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 底部微型传输状态栏、抽屉面板与受监视文件标签 -->
        <Border Grid.Row="3" Background="{DynamicResource Kei.Bg.PanelAlt}" BorderBrush="{DynamicResource Kei.Border}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto">
                <!-- 第一行：可展开的传输任务抽屉面板 -->
                <Border Grid.Row="0"
                        IsVisible="{Binding IsTransferDrawerOpen}"
                        MaxHeight="140"
                        BorderBrush="{DynamicResource Kei.Border}"
                        BorderThickness="0,0,0,1"
                        Background="{DynamicResource Kei.Bg.Window}">
                    <Grid RowDefinitions="Auto,*">
                        <!-- 抽屉头部标题与操作 -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,4" Background="{DynamicResource Kei.Bg.Panel}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Viewbox Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="24" Height="24">
                                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.QuickConnect}" Stroke="{DynamicResource Kei.Accent}" Width="24" Height="24" Stretch="None"/>
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="传输任务队列" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Kei.Text.Primary}"/>
                                <TextBlock Text="{Binding TransferTasks.Count, StringFormat='({0})'}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Classes="iconBtn" Width="NaN" Height="28" Padding="8,0" ToolTip.Tip="清除已完成/已取消" Command="{Binding ClearCompletedTransferTasksCommand}">
                                    <TextBlock Text="清除已完成" FontSize="12" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                </Button>
                                <Button Classes="iconBtn" Width="28" Height="28" ToolTip.Tip="收起抽屉" Command="{Binding ToggleTransferDrawerCommand}">
                                    <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="24" Height="24">
                                            <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Close}" Width="24" Height="24" Stretch="None"/>
                                        </Grid>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 传输任务列表 -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TransferTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:FileTransferTaskItemViewModel">
                                        <Border BorderBrush="{DynamicResource Kei.Border}" BorderThickness="0,0,0,0.5" Padding="8,3">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                                <!-- 方向图标 -->
                                                <Viewbox Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" IsVisible="{Binding Direction, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:FileTransferDirection.Upload}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid Width="24" Height="24">
                                                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Upload}" Stroke="{DynamicResource Kei.Session.Foreground}" Width="24" Height="24" Stretch="None"/>
                                                    </Grid>
                                                </Viewbox>
                                                <Viewbox Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" IsVisible="{Binding Direction, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:FileTransferDirection.Download}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid Width="24" Height="24">
                                                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Download}" Stroke="{DynamicResource Kei.Accent}" Width="24" Height="24" Stretch="None"/>
                                                    </Grid>
                                                </Viewbox>

                                                <!-- 文件名与进度条 -->
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{DynamicResource Kei.Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="2"
                                                                 Foreground="{DynamicResource Kei.Accent}"
                                                                 Background="{DynamicResource Kei.Bg.PanelAlt}"/>
                                                </StackPanel>

                                                <!-- 状态/速度文本 -->
                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" Margin="8,0" VerticalAlignment="Center"/>

                                                <!-- 取消/移除按钮 -->
                                                <Button Grid.Column="3" Classes="closeBtn" Padding="4,2" Cursor="Hand"
                                                        Command="{Binding CancelCommand}" ToolTip.Tip="取消或移除">
                                                    <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid Width="24" Height="24">
                                                            <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Close}" Width="24" Height="24" Stretch="None"/>
                                                        </Grid>
                                                    </Viewbox>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 第二行：状态文本、任务折叠触发器与活跃受监视文件标签 -->
                <Border Grid.Row="1" Padding="8,4" MinHeight="28">
                    <Grid RowDefinitions="Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding TransferStatusMessage, FallbackValue='就绪'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Kei.Text.Secondary}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>

                            <!-- 传输抽屉展开/折叠切换按钮（若有任务） -->
                            <Button Grid.Column="1" Classes="iconBtn" Width="NaN" Margin="6,0,0,0" Padding="6,1"
                                    IsVisible="{Binding TransferTasks.Count}"
                                    Command="{Binding ToggleTransferDrawerCommand}"
                                    ToolTip.Tip="展开/收起传输队列">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Viewbox Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="24" Height="24">
                                            <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.QuickConnect}" Stroke="{DynamicResource Kei.Accent}" Width="24" Height="24" Stretch="None"/>
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock Text="任务" FontSize="12" Foreground="{DynamicResource Kei.Accent}"/>
                                    <TextBlock Text="{Binding TransferTasks.Count, StringFormat='({0})'}" FontSize="12" Foreground="{DynamicResource Kei.Accent}"/>
                                </StackPanel>
                            </Button>

                            <ItemsControl Grid.Column="2" ItemsSource="{Binding ActiveTrackedFiles}" Margin="6,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Kei.Bg.Card}" CornerRadius="3" Padding="4,1" Margin="2,0" BorderBrush="{DynamicResource Kei.Border.Subtle}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Kei.Session.Foreground}" VerticalAlignment="Center"/>
                                                <Button Classes="closeBtn" Padding="2,0" Cursor="Hand"
                                                        Command="{Binding $parent[UserControl].((vm:RemoteFileManagerViewModel)DataContext).StopTrackingFileCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="停止监视此文件">

                                                    <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid Width="24" Height="24">
                                                            <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Close}" Width="24" Height="24" Stretch="None"/>
                                                        </Grid>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- 上传/下载进度条（仅在传输进行时展现） -->
                        <ProgressBar Grid.Row="1"
                                     Value="{Binding TransferProgress}"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="3"
                                     Margin="0,3,0,1"
                                     IsVisible="{Binding IsTransferring}"
                                     Foreground="{DynamicResource Kei.Accent}"
                                     Background="{DynamicResource Kei.Bg.Window}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
