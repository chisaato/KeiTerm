<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kei.Term.App.ViewModels"
             xmlns:models="using:Kei.Term.Core.Models"
             xmlns:loc="using:Kei.Term.App.Helpers"
             xmlns:conv="using:Kei.Term.App.Converters"
             x:Class="Kei.Term.App.Views.RemoteFileManagerView"
             x:DataType="vm:RemoteFileManagerViewModel"
             Background="{DynamicResource Kei.Bg.Panel}">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshDirectoryCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="TreeViewItem" x:DataType="vm:RemoteDirectoryNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsVisible" Value="{Binding !IsDummy}"/>
        </Style>
        <Style Selector="TextBlock.transferStatus">
            <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Muted}"/>
        </Style>
        <Style Selector="Border.transferTask.failed TextBlock.transferStatus">
            <Setter Property="Foreground" Value="{DynamicResource Kei.Status.Error}"/>
        </Style>
        <Style Selector="Border.transferTask.skipped TextBlock.transferStatus">
            <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Secondary}"/>
        </Style>
        <Style Selector="Border.transferTask.completed TextBlock.transferStatus">
            <Setter Property="Foreground" Value="{DynamicResource Kei.Status.Connected}"/>
        </Style>
        <Style Selector="TabItem.fileActivityTab">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Secondary}"/>
            <Setter Property="Background" Value="{DynamicResource Kei.Bg.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Classes="activityTabSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem.fileActivityTab:pointerover">
            <Setter Property="Background" Value="{DynamicResource Kei.Bg.PanelAlt}"/>
        </Style>
        <Style Selector="TabItem.fileActivityTab:selected">
            <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Kei.Text.Muted}"/>
            <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
        </Style>
        <Style Selector="TabItem.fileActivityTab.activity">
            <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
            <Setter Property="Background" Value="{DynamicResource Kei.Bg.PanelAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Kei.Text.Muted}"/>
        </Style>
        <Style Selector="TabItem.fileActivityTab.activity:selected">
            <Setter Property="Background" Value="{DynamicResource Kei.Bg.Pressed}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Kei.Text.Secondary}"/>
        </Style>
        <Style Selector="Button.fileActivityToggle">
            <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Secondary}"/>
        </Style>
        <Style Selector="Button.fileActivityToggle.open">
            <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
        </Style>
        <Style Selector="Button.directoryTreeToggle.open Path.kei-icon">
            <Setter Property="Stroke" Value="{DynamicResource Kei.Accent}"/>
        </Style>
        <Style Selector="Button.directoryTreeToggle.open">
            <Setter Property="Background" Value="{DynamicResource Kei.Bg.Pressed}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Kei.Text.Muted}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.fileMaximize">
            <Setter Property="ToolTip.Tip" Value="{loc:KeiString FileManager.Maximize}"/>
            <Setter Property="AutomationProperties.Name" Value="{loc:KeiString FileManager.Maximize}"/>
        </Style>
        <Style Selector="Button.fileMaximize.maximized">
            <Setter Property="ToolTip.Tip" Value="{loc:KeiString FileManager.RestoreLayout}"/>
            <Setter Property="AutomationProperties.Name" Value="{loc:KeiString FileManager.RestoreLayout}"/>
            <Setter Property="Background" Value="{DynamicResource Kei.Bg.Pressed}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Kei.Text.Muted}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.transferTableRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
        </Style>
        <Style Selector="Border.transferTableRow.failed TextBlock.transferStatus">
            <Setter Property="Foreground" Value="{DynamicResource Kei.Status.Error}"/>
        </Style>
        <Style Selector="Border.transferTableRow.skipped TextBlock.transferStatus">
            <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Secondary}"/>
        </Style>
        <Style Selector="Border.transferTableRow.completed TextBlock.transferStatus">
            <Setter Property="Foreground" Value="{DynamicResource Kei.Status.Connected}"/>
        </Style>
        <!-- 表头列分隔把手：6px 宽的命中区，中间一条细线，悬停高亮 -->
        <Style Selector="Border.columnGrip">
            <Setter Property="Width" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWestEast"/>
        </Style>
        <Style Selector="Border.columnGrip > Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="{DynamicResource Kei.Border.Subtle}"/>
        </Style>
        <Style Selector="Border.columnGrip:pointerover > Border">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource Kei.Accent}"/>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="FileManagerLayout" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" DragDrop.AllowDrop="True">
        <!-- 顶部工具条：标题与操作 -->
        <Border Grid.Row="0" Background="{DynamicResource Kei.Bg.PanelAlt}" BorderBrush="{DynamicResource Kei.Border}" BorderThickness="0,0,0,1" Padding="8,4">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:KeiString FileManager.Dock.MoveToLeft}" Command="{Binding MoveToLeftCommand}" IsEnabled="{Binding !IsOnLeft}" IsVisible="{Binding !IsFileTab}"/>
                    <MenuItem Header="{loc:KeiString FileManager.Dock.MoveToRight}" Command="{Binding MoveToRightCommand}" IsEnabled="{Binding IsOnLeft}" IsVisible="{Binding !IsFileTab}"/>
                    <Separator IsVisible="{Binding !IsFileTab}"/>
                    <MenuItem Header="{loc:KeiString FileManager.PromoteToFileTab}" Command="{Binding PromoteToTabCommand}" IsVisible="{Binding !IsFileTab}"/>
                    <MenuItem Header="{loc:KeiString FileManager.Hide}" Command="{Binding CloseCommand}" IsVisible="{Binding !IsFileTab}"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid x:Name="FileManagerToolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Viewbox Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Folder}" Stroke="{DynamicResource Kei.Text.Secondary}" Width="24" Height="24" Stretch="None"/>
                        </Grid>
                    </Viewbox>
                    <TextBlock x:Name="FileManagerHeading" Grid.Column="1" Text="文件管理" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource Kei.Text.Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="FileManagerTreeToggleButton" Classes="iconBtn directoryTreeToggle" Classes.open="{Binding IsDirectoryTreeVisible}"
                            Width="28" Height="28" Command="{Binding ToggleDirectoryTreeCommand}"
                            ToolTip.Tip="{loc:KeiString FileManager.Tree.Toggle}" AutomationProperties.Name="{loc:KeiString FileManager.Tree.Toggle}">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.ListTree}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="FileManagerShowShellButton" Classes="iconBtn" Width="28" Height="28" IsVisible="{Binding !IsShellVisible}"
                            ToolTip.Tip="{loc:KeiString FileManager.ShowShell}" AutomationProperties.Name="{loc:KeiString FileManager.ShowShell}"
                            Command="{Binding ShowShellCommand}">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Terminal}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="FileManagerDockButton" Classes="iconBtn" Width="28" Height="28"
                            ToolTip.Tip="{loc:KeiString FileManager.Dock.Toggle}" AutomationProperties.Name="{loc:KeiString FileManager.Dock.Toggle}"
                            Command="{Binding ToggleDockPositionCommand}">
                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!IsFileTab"/>
                                <Binding Path="!IsMaximized"/>
                            </MultiBinding>
                        </Button.IsVisible>
                        <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.DockSwap}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="FileManagerMaximizeButton" Classes="iconBtn fileMaximize" Classes.maximized="{Binding IsMaximized}"
                            Width="28" Height="28" Command="{Binding MaximizeCommand}" IsVisible="{Binding !IsFileTab}">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Maximize}" IsVisible="{Binding !IsMaximized}" Width="24" Height="24" Stretch="None"/>
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Minimize}" IsVisible="{Binding IsMaximized}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="FileManagerOpenInTabButton" Classes="iconBtn" Width="28" Height="28" ToolTip.Tip="{loc:KeiString FileManager.PromoteToFileTab}"
                            AutomationProperties.Name="{loc:KeiString FileManager.PromoteToFileTab}" Command="{Binding PromoteToTabCommand}" IsVisible="{Binding !IsFileTab}">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.ExternalLink}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="FileManagerSyncTerminalDirectoryButton" Classes="iconBtn" Width="28" Height="28"
                            Command="{Binding JumpToTerminalDirectoryCommand}" IsEnabled="{Binding HasTerminalDirectory}"
                            ToolTip.Tip="{Binding TerminalDirectorySyncHint}" AutomationProperties.Name="{loc:KeiString FileManager.CwdFollow.Sync}">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.FolderOpen}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button Classes="iconBtn" Width="28" Height="28" ToolTip.Tip="刷新" Command="{Binding RefreshDirectoryCommand}">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Refresh}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="FileManagerCloseButton" Classes="iconBtn" Width="28" Height="28" ToolTip.Tip="{Binding CloseToolTip}"
                            AutomationProperties.Name="{Binding CloseToolTip}" Command="{Binding CloseCommand}">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Close}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                </StackPanel>
                <!-- 加载状态独占底行；标题列在窄面板中可收缩，不覆盖操作按钮。 -->
                <ProgressBar x:Name="FileManagerLoadingProgressBar" Grid.Row="1" Grid.ColumnSpan="2" IsIndeterminate="True"
                             Height="3" MinHeight="3" Margin="0,4,0,0" IsVisible="{Binding IsLoading}"
                             Foreground="{DynamicResource Kei.Text.Secondary}" Background="{DynamicResource Kei.Bg.Input}"/>
            </Grid>
        </Border>

        <!-- 路径导航栏 -->
        <Border Grid.Row="1" Background="{DynamicResource Kei.Bg.Panel}" BorderBrush="{DynamicResource Kei.Border}" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0">
                <Button Classes="iconBtn" Width="28" Height="28" ToolTip.Tip="上一级" Command="{Binding NavigateUpCommand}" Margin="0,0,4,0">
                    <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.ArrowUp}" Width="24" Height="24" Stretch="None"/>
                        </Grid>
                    </Viewbox>
                </Button>
                <TextBox x:Name="FileManagerPathInput" Grid.Column="1" Text="{Binding CurrentPath}" Height="28" Padding="6,2" FontSize="12" VerticalContentAlignment="Center">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding RefreshDirectoryCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <ToggleButton Grid.Column="2" IsChecked="{Binding ShowHiddenFiles}" Width="28" Height="28" MinWidth="28" MinHeight="28" ToolTip.Tip="显示隐藏文件 (.*)" Margin="4,0,0,0" Padding="0">
                    <TextBlock Text=".*" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- 中部文件显示区：SecureCRT 左右双栏结构（左侧目录树 + 分割条 + 右侧文件列表） -->
        <Grid x:Name="DirectoryContentGrid" Grid.Row="2" ColumnDefinitions="160,Auto,*">
            <!-- 左栏：远程目录树（仅目录，层级展开，点击切换当前目录） -->
            <TreeView x:Name="DirectoryTreeView"
                      Grid.Column="0"
                      ItemsSource="{Binding DirectoryTreeRoots}"
                      SelectedItem="{Binding SelectedDirectoryNode, Mode=TwoWay}"
                      DoubleTapped="OnDirectoryTreeDoubleTapped"
                      IsVisible="{Binding IsDirectoryTreeVisible}"
                      Background="Transparent">
                <TreeView.DataTemplates>
                    <TreeDataTemplate DataType="vm:RemoteDirectoryNodeViewModel" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,1" VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Folder}" Stroke="{DynamicResource Kei.Text.Muted}" Width="24" Height="24" Stretch="None"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Kei.Text.Primary}"/>
                            <ProgressBar IsIndeterminate="True" Width="20" Height="2" IsVisible="{Binding IsLoading}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.DataTemplates>
            </TreeView>

            <!-- 垂直分割条 -->
            <GridSplitter x:Name="DirectoryTreeSplitter" Grid.Column="1" Width="3" Background="{DynamicResource Kei.Border}"
                          IsVisible="{Binding IsDirectoryTreeVisible}" ResizeDirection="Columns"/>

            <!-- 右栏：当前目录下文件列表（含 .. 回上级、文件图标、大小、权限等） -->
            <ListBox x:Name="FileListBox"
                     Grid.Column="2"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     SelectionMode="Multiple"
                     DoubleTapped="OnListBoxDoubleTapped"
                     PointerPressed="OnListBoxPointerPressed"
                     Background="Transparent">
                <ListBox.ContextMenu>
                    <ContextMenu Opening="OnContextMenuOpening">
                        <MenuItem Classes="selection-action" Header="打开" Command="{Binding EnterOrOpenFileCommand}" CommandParameter="{Binding SelectedItem}"/>
                        <MenuItem x:Name="OpenDirectoryInTabMenuItem" Header="{loc:KeiString FileManager.OpenInTab}"
                                  Command="{Binding OpenDirectoryInTabCommand}" CommandParameter="{Binding SelectedItem}"
                                  IsVisible="{Binding SelectedItem.IsDirectory, FallbackValue=False}"/>
                        <MenuItem Header="打开方式" x:Name="OpenWithSubMenu">
                            <!-- 子项将在 ContextMenu 打开时动态构建 -->
                        </MenuItem>
                        <MenuItem Classes="selection-action" Header="使用系统默认程序打开"
                                  Command="{Binding OpenWithSystemDefaultCommand}"
                                  CommandParameter="{Binding SelectedItem}"/>
                        <MenuItem Classes="selection-action" Header="选择其他本地程序打开..."
                                  Command="{Binding OpenWithCustomExecutableCommand}"
                                  CommandParameter="{Binding SelectedItem}"/>
                        <Separator Classes="selection-action"/>
                        <MenuItem Classes="selection-action" Header="{loc:KeiString FileManager.Download}" Command="{Binding DownloadCommand}" CommandParameter="{Binding SelectedItem}"/>
                        <MenuItem Classes="selection-action" Header="{loc:KeiString FileManager.DownloadTo}" Command="{Binding DownloadToCommand}" CommandParameter="{Binding SelectedItem}"/>
                        <MenuItem Classes="selection-action" Header="{loc:KeiString FileManager.CopyRemotePath}" Click="OnCopyRemotePath"/>
                        <Separator Classes="selection-action"/>
                        <MenuItem x:Name="RenameMenuItem" Header="{loc:KeiString FileManager.Rename}" Command="{Binding RenameItemCommand}" CommandParameter="{Binding SelectedItem}"/>
                        <MenuItem Classes="selection-action" Header="删除" Command="{Binding DeleteItemCommand}" CommandParameter="{Binding SelectedItem}"/>
                        <Separator Classes="selection-action"/>
                        <MenuItem Header="{loc:KeiString FileManager.CreateFile}" Command="{Binding CreateFileCommand}"/>
                        <MenuItem Header="{loc:KeiString FileManager.CreateDirectory}" Command="{Binding CreateDirectoryCommand}"/>
                        <MenuItem Header="{loc:KeiString FileManager.UploadFiles}" Command="{Binding UploadFilesCommand}"/>
                        <MenuItem Header="{loc:KeiString FileManager.Refresh}" InputGesture="F5" Command="{Binding RefreshDirectoryCommand}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:RemoteFileItem">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,1">
                            <!-- 图标 -->
                            <Viewbox Width="14" Height="14" Stretch="Uniform" Grid.Column="0" Margin="0,0,6,0" IsVisible="{Binding IsDirectory}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Folder}" Stroke="{DynamicResource Kei.Text.Muted}" Width="24" Height="24" Stretch="None"/>
                                </Grid>
                            </Viewbox>
                            <Viewbox Width="14" Height="14" Stretch="Uniform" Grid.Column="0" Margin="0,0,6,0" IsVisible="{Binding !IsDirectory}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.File}" Stroke="{DynamicResource Kei.Text.Secondary}" Width="24" Height="24" Stretch="None"/>
                                </Grid>
                            </Viewbox>

                            <!-- 名称 -->
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Kei.Text.Primary}" TextTrimming="CharacterEllipsis"/>

                            <!-- 大小 -->
                            <TextBlock Grid.Column="2" IsVisible="{Binding !IsDirectory}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" Margin="8,0"
                                       ToolTip.Tip="{Binding Size, StringFormat='{}{0} B'}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static conv:FileSizeConverter.Instance}">
                                        <Binding Path="Size"/>
                                        <Binding Path="$parent[UserControl].((vm:RemoteFileManagerViewModel)DataContext).SizeDisplayMode"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <!-- 权限 -->
                            <TextBlock Grid.Column="3" Text="{Binding Permissions}" VerticalAlignment="Center" FontSize="12" FontFamily="{DynamicResource Kei.Font.Mono}" Foreground="{DynamicResource Kei.Text.Muted}" Margin="6,0,2,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 分隔条上下调整文件区与活动区；活动区高度上限由窗口布局统一计算。 -->
        <GridSplitter x:Name="FileActivitySplitter" Grid.Row="3" Height="4" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" IsVisible="{Binding IsActivityPanelOpen}"
                      Background="{DynamicResource Kei.Border.Subtle}"/>
        <Border x:Name="FileActivityPanel" Grid.Row="4" IsVisible="{Binding IsActivityPanelOpen}"
                Background="{DynamicResource Kei.Bg.Window}" BorderBrush="{DynamicResource Kei.Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid>
                <TabControl x:Name="FileActivityTabs" SelectedIndex="{Binding SelectedActivityTab, Mode=TwoWay}"
                            Background="{DynamicResource Kei.Bg.Window}" BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <TabItem x:Name="TransferActivityTab" Classes="fileActivityTab" Classes.activity="{Binding HasTransferActivity}">
                        <TabItem.Header>
                            <StackPanel x:Name="TransferActivityHeader" Classes="activityTabHeader" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center">
                                    <Grid Width="24" Height="24">
                                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.QuickConnect}" Stroke="{Binding $parent[TabItem].Foreground}" Width="24" Height="24" Stretch="None"/>
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="{loc:KeiString FileActivity.Transfers}" FontSize="12" Foreground="{Binding $parent[TabItem].Foreground}" VerticalAlignment="Center"/>
                                <Border Classes="activityCountBadge" Background="{DynamicResource Kei.Bg.Input}" CornerRadius="{DynamicResource Kei.Radius.Control}"
                                        Height="18" MinWidth="18" Padding="4,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TransferTasks.Count}" FontSize="12" Foreground="{Binding $parent[TabItem].Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="TransferActivityMarker" Width="3" Height="12" CornerRadius="1"
                                        Background="{DynamicResource Kei.Text.Secondary}" IsVisible="{Binding HasTransferActivity}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <!-- 外层水平滚动：各列宽度之和超过面板时整体滚动（名称列先压到最小宽度），不裁剪操作按钮 -->
                        <ScrollViewer x:Name="TransferTableScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="TransferQueueContainer" RowDefinitions="Auto,*"
                              Width="{Binding TransferView.ContentWidth}">
                            <!-- 固定表头：列间分隔把手可拖动调整宽度，右键勾选显隐可选列 -->
                            <Border x:Name="TransferTableHeader" Grid.Row="0" Background="{DynamicResource Kei.Bg.PanelAlt}" BorderBrush="{DynamicResource Kei.Border.Subtle}"
                                    BorderThickness="0,0,0,1" Padding="8,2" Height="24">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:KeiString FileActivity.Header.RemotePath}" ToggleType="CheckBox" IsChecked="{Binding TransferLayout.RemotePath.IsVisible, Mode=TwoWay}"/>
                                        <MenuItem Header="{loc:KeiString FileActivity.Header.Size}" ToggleType="CheckBox" IsChecked="{Binding TransferLayout.Size.IsVisible, Mode=TwoWay}"/>
                                        <MenuItem Header="{loc:KeiString FileActivity.Header.Progress}" ToggleType="CheckBox" IsChecked="{Binding TransferLayout.Progress.IsVisible, Mode=TwoWay}"/>
                                        <MenuItem Header="{loc:KeiString FileActivity.Header.Speed}" ToggleType="CheckBox" IsChecked="{Binding TransferLayout.Speed.IsVisible, Mode=TwoWay}"/>
                                        <MenuItem Header="{loc:KeiString FileActivity.Header.Status}" ToggleType="CheckBox" IsChecked="{Binding TransferLayout.Status.IsVisible, Mode=TwoWay}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid x:Name="TransferHeaderGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*" MinWidth="60"/>
                                        <ColumnDefinition Width="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.RemotePath.GridWidth}" MinWidth="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.RemotePath.GridMinWidth}"/>
                                        <ColumnDefinition Width="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Size.GridWidth}" MinWidth="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Size.GridMinWidth}"/>
                                        <ColumnDefinition Width="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Progress.GridWidth}" MinWidth="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Progress.GridMinWidth}"/>
                                        <ColumnDefinition Width="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Speed.GridWidth}" MinWidth="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Speed.GridMinWidth}"/>
                                        <ColumnDefinition Width="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Status.GridWidth}" MinWidth="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Status.GridMinWidth}"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{loc:KeiString FileActivity.Header.Name}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" VerticalAlignment="Center" Margin="4,0"/>
                                    <Panel Grid.Column="2" ClipToBounds="True" IsVisible="{Binding TransferView.RemotePath.IsVisible}">
                                        <TextBlock Text="{loc:KeiString FileActivity.Header.RemotePath}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"/>
                                        <Border Classes="columnGrip" Tag="RemotePath" ToolTip.Tip="{loc:KeiString FileActivity.Header.ResizeTip}"><Border/></Border>
                                    </Panel>
                                    <Panel Grid.Column="3" ClipToBounds="True" IsVisible="{Binding TransferView.Size.IsVisible}">
                                        <TextBlock Text="{loc:KeiString FileActivity.Header.Size}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"/>
                                        <Border Classes="columnGrip" Tag="Size" ToolTip.Tip="{loc:KeiString FileActivity.Header.ResizeTip}"><Border/></Border>
                                    </Panel>
                                    <Panel Grid.Column="4" ClipToBounds="True" IsVisible="{Binding TransferView.Progress.IsVisible}">
                                        <TextBlock Text="{loc:KeiString FileActivity.Header.Progress}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"/>
                                        <Border Classes="columnGrip" Tag="Progress" ToolTip.Tip="{loc:KeiString FileActivity.Header.ResizeTip}"><Border/></Border>
                                    </Panel>
                                    <Panel Grid.Column="5" ClipToBounds="True" IsVisible="{Binding TransferView.Speed.IsVisible}">
                                        <TextBlock Text="{loc:KeiString FileActivity.Header.Speed}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"/>
                                        <Border Classes="columnGrip" Tag="Speed" ToolTip.Tip="{loc:KeiString FileActivity.Header.ResizeTip}"><Border/></Border>
                                    </Panel>
                                    <Panel Grid.Column="6" ClipToBounds="True" IsVisible="{Binding TransferView.Status.IsVisible}">
                                        <TextBlock Text="{loc:KeiString FileActivity.Header.Status}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"/>
                                        <Border Classes="columnGrip" Tag="Status" ToolTip.Tip="{loc:KeiString FileActivity.Header.ResizeTip}"><Border/></Border>
                                    </Panel>
                                    <TextBlock Grid.Column="7" Text="{loc:KeiString FileActivity.Header.Actions}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="TransferTaskList" ItemsSource="{Binding TransferTasks}" Margin="4,2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:FileTransferTaskItemViewModel" x:DataType="vm:FileTransferTaskItemViewModel">
                                            <Border Classes="transferTask transferTableRow" Background="Transparent" CornerRadius="{DynamicResource Kei.Radius.Control}"
                                                    Padding="4,1" MinHeight="22" Height="24"
                                                    Classes.failed="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:FileTransferState.Failed}}"
                                                    Classes.skipped="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:FileTransferState.Skipped}}"
                                                    Classes.completed="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:FileTransferState.Completed}}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{loc:KeiString FileActivity.Retry}" Command="{Binding RetryCommand}"
                                                                  IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:FileTransferState.Failed}}"/>
                                                        <MenuItem Header="{loc:KeiString FileActivity.CancelOrRemove}" Command="{Binding CancelCommand}"/>
                                                        <MenuItem Header="{loc:KeiString FileActivity.Action.Remove}" Command="{Binding RemoveCommand}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{loc:KeiString FileActivity.Action.CopyError}"
                                                                  Command="{Binding $parent[UserControl].((vm:RemoteFileManagerViewModel)DataContext).CopyErrorMessageCommand}"
                                                                  CommandParameter="{Binding ErrorMessage}"
                                                                  IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <MenuItem Header="{loc:KeiString FileActivity.Action.CopyRemotePath}"
                                                                  Command="{Binding $parent[UserControl].((vm:RemoteFileManagerViewModel)DataContext).CopyTextToClipboardCommand}"
                                                                  CommandParameter="{Binding RemotePath}"/>
                                                        <MenuItem Header="{loc:KeiString FileActivity.Action.NavigateToRemote}" Command="{Binding NavigateToRemoteDirectoryCommand}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*" MinWidth="60"/>
                                                        <ColumnDefinition Width="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.RemotePath.GridWidth}" MinWidth="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.RemotePath.GridMinWidth}"/>
                                                        <ColumnDefinition Width="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Size.GridWidth}" MinWidth="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Size.GridMinWidth}"/>
                                                        <ColumnDefinition Width="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Progress.GridWidth}" MinWidth="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Progress.GridMinWidth}"/>
                                                        <ColumnDefinition Width="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Speed.GridWidth}" MinWidth="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Speed.GridMinWidth}"/>
                                                        <ColumnDefinition Width="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Status.GridWidth}" MinWidth="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Status.GridMinWidth}"/>
                                                        <ColumnDefinition Width="50"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 列 0: 方向图标 -->
                                                    <Viewbox Grid.Column="0" Width="13" Height="13" Stretch="Uniform" Margin="2,0" ToolTip.Tip="上传"
                                                             IsVisible="{Binding Direction, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:FileTransferDirection.Upload}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid Width="24" Height="24">
                                                            <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Upload}" Stroke="{DynamicResource Kei.Text.Primary}" Width="24" Height="24" Stretch="None"/>
                                                        </Grid>
                                                    </Viewbox>
                                                    <Viewbox Grid.Column="0" Width="13" Height="13" Stretch="Uniform" Margin="2,0" ToolTip.Tip="下载"
                                                             IsVisible="{Binding Direction, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:FileTransferDirection.Download}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid Width="24" Height="24">
                                                            <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Download}" Stroke="{DynamicResource Kei.Text.Primary}" Width="24" Height="24" Stretch="None"/>
                                                        </Grid>
                                                    </Viewbox>

                                                    <!-- 列 1: 名称（悬停显示 LocalPath → RemotePath） -->
                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" Foreground="{DynamicResource Kei.Text.Primary}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" ToolTip.Tip="{Binding TransferPathTooltip}"/>

                                                    <!-- 列 2: 远端路径（默认隐藏，表头右键勾选） -->
                                                    <TextBlock Grid.Column="2" Text="{Binding RemotePath}" FontSize="12" Foreground="{DynamicResource Kei.Text.Secondary}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,4,0" ClipToBounds="True" ToolTip.Tip="{Binding RemotePath}"
                                                               IsVisible="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.RemotePath.IsVisible}"/>

                                                    <!-- 列 3: 大小（进行中 已传/总，完成后仅总大小），右对齐等宽 -->
                                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSizeText}" FontSize="12" FontFamily="{DynamicResource Kei.Font.Mono}"
                                                               Foreground="{DynamicResource Kei.Text.Secondary}" VerticalAlignment="Center" TextAlignment="Right" Margin="8,0,4,0"
                                                               TextTrimming="CharacterEllipsis" ClipToBounds="True" ToolTip.Tip="{Binding FormattedSizeText}"
                                                               IsVisible="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Size.IsVisible}"/>

                                                    <!-- 列 4: 进度：细进度条贴在行底部，百分比右对齐；非进行中状态留空 -->
                                                    <Panel Grid.Column="4" ClipToBounds="True" Margin="8,0,4,0"
                                                           IsVisible="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Progress.IsVisible}">
                                                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="2" MinHeight="2" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                                                     IsVisible="{Binding ShowsProgress}"
                                                                     Foreground="{DynamicResource Kei.Accent}" Background="{DynamicResource Kei.Bg.PanelAlt}"/>
                                                        <TextBlock Text="{Binding FormattedProgressText}" FontSize="12" FontFamily="{DynamicResource Kei.Font.Mono}"
                                                                   Foreground="{DynamicResource Kei.Text.Muted}" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                                    </Panel>

                                                    <!-- 列 5: 即时速度（仅传输中），ETA 在 Tooltip -->
                                                    <TextBlock Grid.Column="5" Text="{Binding FormattedSpeedText}" FontSize="12" FontFamily="{DynamicResource Kei.Font.Mono}"
                                                               Foreground="{DynamicResource Kei.Text.Secondary}" VerticalAlignment="Center" TextAlignment="Right" Margin="8,0,4,0"
                                                               TextTrimming="CharacterEllipsis" ClipToBounds="True"
                                                               ToolTip.Tip="{Binding FormattedRemainingTimeText}"
                                                               IsVisible="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Speed.IsVisible}"/>

                                                    <!-- 列 6: 状态与未校验标记（失败时显示完整错误信息 Tooltip） -->
                                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,4,0" ClipToBounds="True"
                                                                IsVisible="{Binding #TransferQueueContainer.((vm:RemoteFileManagerViewModel)DataContext).TransferView.Status.IsVisible}">
                                                        <TextBlock Classes="transferStatus" Text="{Binding StatusText}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                   ToolTip.Tip="{Binding ErrorMessage, TargetNullValue={Binding StatusText}}"/>
                                                        <Border Background="{DynamicResource Kei.Bg.PanelAlt}" BorderBrush="{DynamicResource Kei.Border.Subtle}"
                                                                BorderThickness="1" CornerRadius="{DynamicResource Kei.Radius.Control}"
                                                                Padding="3,0" Height="16" VerticalAlignment="Center"
                                                                IsVisible="{Binding IsUnverified}" ToolTip.Tip="{loc:KeiString FileActivity.UnverifiedTip}">
                                                            <TextBlock Text="{loc:KeiString FileActivity.Unverified}" FontSize="12"
                                                                       Foreground="{DynamicResource Kei.Text.Secondary}" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- 列 7: 操作按钮（重试/取消/移除） -->
                                                    <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Classes="iconBtn" Width="22" Height="22"
                                                                Command="{Binding RetryCommand}"
                                                                IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:FileTransferState.Failed}}"
                                                                ToolTip.Tip="{loc:KeiString FileActivity.Retry}" AutomationProperties.Name="{loc:KeiString FileActivity.Retry}">
                                                            <Viewbox Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Grid Width="24" Height="24">
                                                                    <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Refresh}" Stroke="{DynamicResource Kei.Text.Primary}" Width="24" Height="24" Stretch="None"/>
                                                                </Grid>
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Classes="iconBtn" Width="22" Height="22"
                                                                Command="{Binding CancelCommand}" ToolTip.Tip="{loc:KeiString FileActivity.CancelOrRemove}" AutomationProperties.Name="{loc:KeiString FileActivity.CancelOrRemove}">
                                                            <Viewbox Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Grid Width="24" Height="24">
                                                                    <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Close}" Width="24" Height="24" Stretch="None"/>
                                                                </Grid>
                                                            </Viewbox>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="NoTransfersMessage" Grid.Row="1" Text="{loc:KeiString FileActivity.NoTransfers}" FontSize="12" Margin="12,8"
                                       Foreground="{DynamicResource Kei.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.IsVisible>
                                    <Binding Path="TransferTasks.Count" Converter="{x:Static ObjectConverters.Equal}">
                                        <Binding.ConverterParameter><x:Int32>0</x:Int32></Binding.ConverterParameter>
                                    </Binding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                        </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="TrackedActivityTab" Classes="fileActivityTab" Classes.activity="{Binding HasTrackedActivity}">
                        <TabItem.Header>
                            <StackPanel x:Name="TrackedActivityHeader" Classes="activityTabHeader" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center">
                                    <Grid Width="24" Height="24">
                                        <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Eye}" Stroke="{Binding $parent[TabItem].Foreground}" Width="24" Height="24" Stretch="None"/>
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="{loc:KeiString FileActivity.TrackedFiles}" FontSize="12" Foreground="{Binding $parent[TabItem].Foreground}" VerticalAlignment="Center"/>
                                <Border Classes="activityCountBadge" Background="{DynamicResource Kei.Bg.Input}" CornerRadius="{DynamicResource Kei.Radius.Control}"
                                        Height="18" MinWidth="18" Padding="4,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveTrackedFiles.Count}" FontSize="12" Foreground="{Binding $parent[TabItem].Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="TrackedActivityMarker" Width="3" Height="12" CornerRadius="1"
                                        Background="{DynamicResource Kei.Text.Secondary}" IsVisible="{Binding HasTrackedActivity}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="TrackedFileList" ItemsSource="{Binding ActiveTrackedFiles}" Margin="8,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Classes="trackedFile" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="{DynamicResource Kei.Radius.Control}"
                                                    Padding="8,1,4,1" MinHeight="24" Height="24" BorderBrush="{DynamicResource Kei.Border.Subtle}" BorderThickness="1">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Kei.Text.Primary}"
                                                               TextTrimming="PathSegmentEllipsis" ToolTip.Tip="{Binding}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Classes="iconBtn" Width="22" Height="22" Margin="6,0,0,0"
                                                            Command="{Binding $parent[UserControl].((vm:RemoteFileManagerViewModel)DataContext).StopTrackingFileCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="停止监视此文件" AutomationProperties.Name="停止监视此文件">
                                                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                                                            <Grid Width="24" Height="24">
                                                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Close}" Width="24" Height="24" Stretch="None"/>
                                                            </Grid>
                                                        </Viewbox>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="NoTrackedFilesMessage" Text="{loc:KeiString FileActivity.NoTrackedFiles}" FontSize="12" Margin="12,8"
                                       Foreground="{DynamicResource Kei.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.IsVisible>
                                    <Binding Path="ActiveTrackedFiles.Count" Converter="{x:Static ObjectConverters.Equal}">
                                        <Binding.ConverterParameter><x:Int32>0</x:Int32></Binding.ConverterParameter>
                                    </Binding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                        </Grid>
                    </TabItem>
                </TabControl>
                <StackPanel x:Name="FileActivityHeaderActions" Orientation="Horizontal" Spacing="4" Margin="0,4,4,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                    <!-- 传输摘要：进行中数量与总速度 -->
                    <TextBlock x:Name="TransferActivitySummary" Text="{Binding TransferActivitySummaryText}" FontSize="12"
                               Foreground="{DynamicResource Kei.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="SelectedActivityTab" Converter="{x:Static ObjectConverters.Equal}">
                                    <Binding.ConverterParameter><x:Int32>0</x:Int32></Binding.ConverterParameter>
                                </Binding>
                                <Binding Path="ActiveTransferCount" Converter="{x:Static ObjectConverters.NotEqual}">
                                    <Binding.ConverterParameter><x:Int32>0</x:Int32></Binding.ConverterParameter>
                                </Binding>
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                    <Button x:Name="RetryAllFailedTasksButton" Classes="iconBtn" Width="28" Height="28" Foreground="{DynamicResource Kei.Text.Secondary}"
                            ToolTip.Tip="{loc:KeiString FileActivity.RetryAllFailed}" AutomationProperties.Name="{loc:KeiString FileActivity.RetryAllFailed}"
                            Command="{Binding RetryAllFailedTransfersCommand}">
                        <Button.IsVisible>
                            <Binding Path="SelectedActivityTab" Converter="{x:Static ObjectConverters.Equal}">
                                <Binding.ConverterParameter><x:Int32>0</x:Int32></Binding.ConverterParameter>
                            </Binding>
                        </Button.IsVisible>
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Refresh}" Stroke="{Binding $parent[Button].Foreground}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="ClearTransferTasksButton" Classes="iconBtn" Width="28" Height="28" Foreground="{DynamicResource Kei.Text.Secondary}"
                            ToolTip.Tip="清除已完成、失败或取消的任务" AutomationProperties.Name="清除已结束的任务" Command="{Binding ClearCompletedTransferTasksCommand}">
                        <Button.IsVisible>
                            <Binding Path="SelectedActivityTab" Converter="{x:Static ObjectConverters.Equal}">
                                <Binding.ConverterParameter><x:Int32>0</x:Int32></Binding.ConverterParameter>
                            </Binding>
                        </Button.IsVisible>
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Delete}" Stroke="{Binding $parent[Button].Foreground}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="CollapseFileActivityButton" Classes="iconBtn" Width="28" Height="28" Foreground="{DynamicResource Kei.Text.Secondary}"
                            ToolTip.Tip="{loc:KeiString FileActivity.Collapse}" AutomationProperties.Name="{loc:KeiString FileActivity.Collapse}"
                            Command="{Binding ToggleActivityPanelCommand}">
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.Close}" Stroke="{Binding $parent[Button].Foreground}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部仅保留面板展开/收起入口与全局传输进度。 -->
        <Border Grid.Row="5" Padding="8,4" MinHeight="28" IsVisible="{Binding HasFileActivities}" Background="{DynamicResource Kei.Bg.PanelAlt}"
                BorderBrush="{DynamicResource Kei.Border}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto">
                <Button x:Name="FileActivityToggleButton" Classes="iconBtn fileActivityToggle" Classes.open="{Binding IsActivityPanelOpen}"
                        Width="NaN" Height="28" Padding="6,0" HorizontalAlignment="Right" IsVisible="{Binding HasFileActivities}"
                        Command="{Binding ToggleActivityPanelCommand}" ToolTip.Tip="{loc:KeiString FileActivity.Toggle}" AutomationProperties.Name="{loc:KeiString FileActivity.Toggle}">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.ArrowDown}" Stroke="{Binding $parent[Button].Foreground}"
                                      IsVisible="{Binding IsActivityPanelOpen}" Width="24" Height="24" Stretch="None"/>
                                <Path Classes="kei-icon" Data="{StaticResource Kei.Icon.ArrowUp}" Stroke="{Binding $parent[Button].Foreground}"
                                      IsVisible="{Binding !IsActivityPanelOpen}" Width="24" Height="24" Stretch="None"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="{loc:KeiString FileActivity.CollapsePanel}" FontSize="12" Foreground="{Binding $parent[Button].Foreground}"
                                   IsVisible="{Binding IsActivityPanelOpen}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:KeiString FileActivity.ExpandPanel}" FontSize="12" Foreground="{Binding $parent[Button].Foreground}"
                                   IsVisible="{Binding !IsActivityPanelOpen}" VerticalAlignment="Center"/>
                        <Border Classes="activityCountBadge" Background="{DynamicResource Kei.Bg.Input}" CornerRadius="{DynamicResource Kei.Radius.Control}"
                                Height="18" MinWidth="18" Padding="4,0" VerticalAlignment="Center">
                            <TextBlock x:Name="FileActivityTotalCount" Text="{Binding ActivityCount}" FontSize="12" Foreground="{Binding $parent[Button].Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Button>
                <ProgressBar Grid.Row="1" Value="{Binding TransferProgress}" Minimum="0" Maximum="100" Height="3" Margin="0,3,0,1"
                             IsVisible="{Binding IsTransferring}" Foreground="{DynamicResource Kei.Accent}" Background="{DynamicResource Kei.Bg.Window}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
