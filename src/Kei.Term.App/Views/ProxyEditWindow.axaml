<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kei.Term.App.ViewModels"
        xmlns:views="using:Kei.Term.App.Views"
        xmlns:models="using:Kei.Term.Core.Models"
        xmlns:loc="using:Kei.Term.App.Helpers"
        x:Class="Kei.Term.App.Views.ProxyEditWindow"
        x:DataType="vm:ProxyEditViewModel"
        Title="{Binding Title}"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource Kei.Bg.Window}"
        FontFamily="{DynamicResource Kei.Font.UI}" FontSize="13">
    <Grid RowDefinitions="Auto, Auto, Auto" Margin="18" RowSpacing="12">
        <Grid ColumnDefinitions="100, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="8" ColumnSpacing="12">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:KeiString Proxy.Name}" VerticalAlignment="Center"
                       Foreground="{DynamicResource Kei.Text.Secondary}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:KeiString Proxy.Type}" VerticalAlignment="Center"
                       Foreground="{DynamicResource Kei.Text.Secondary}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ProxyConfigKind">
                        <TextBlock Text="{Binding Converter={x:Static views:ProxyTypeLabelConverter.Instance}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:KeiString Proxy.Host}" VerticalAlignment="Center"
                       Foreground="{DynamicResource Kei.Text.Secondary}" IsVisible="{Binding IsEndpoint}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Host}" IsVisible="{Binding IsEndpoint}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:KeiString Proxy.Port}" VerticalAlignment="Center"
                       Foreground="{DynamicResource Kei.Text.Secondary}" IsVisible="{Binding IsEndpoint}"/>
            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Port}" Minimum="1" Maximum="65535"
                           FormatString="0" HorizontalAlignment="Left" MinWidth="140" IsVisible="{Binding IsEndpoint}"/>

            <Button Grid.Row="2" Grid.Column="1" Content="{loc:KeiString Proxy.ChooseSession}"
                    Command="{Binding PickSessionCommand}" IsVisible="{Binding IsSession}" HorizontalAlignment="Left"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SessionDisplay}" IsVisible="{Binding IsSession}"
                       Foreground="{DynamicResource Kei.Text.Secondary}" VerticalAlignment="Center"
                       FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SessionDisplay}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:KeiString Proxy.Username}" VerticalAlignment="Center"
                       Foreground="{DynamicResource Kei.Text.Secondary}" IsVisible="{Binding IsSocks5}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Username}" IsVisible="{Binding IsSocks5}"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:KeiString Proxy.Password}" VerticalAlignment="Center"
                       Foreground="{DynamicResource Kei.Text.Secondary}" IsVisible="{Binding IsSocks5}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Password}" PasswordChar="•"
                     PlaceholderText="{Binding PasswordPlaceholder}" IsVisible="{Binding IsSocks5}"/>

            <CheckBox Grid.Row="6" Grid.Column="1" Content="{loc:KeiString Proxy.ClearPassword}"
                      IsChecked="{Binding ClearSavedPassword}" IsVisible="{Binding ShowClearPassword}" MinHeight="28"/>

            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding TypeNotice}"
                       Foreground="{DynamicResource Kei.Text.Secondary}" FontSize="12" TextWrapping="Wrap"/>
        </Grid>
        <SelectableTextBlock Grid.Row="1" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                             FontSize="12" Foreground="{DynamicResource Kei.Status.Error}" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Content="{loc:KeiString Common.Cancel}" Command="{Binding CancelCommand}" MinWidth="76" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="{loc:KeiString Common.Save}" Command="{Binding SaveCommand}" MinWidth="76" Classes="accent" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
