<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kei.Term.App.ViewModels"
        xmlns:loc="using:Kei.Term.App.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="580"
        x:Class="Kei.Term.App.Views.IdentityEditWindow"
        x:DataType="vm:IdentityEditViewModel"
        Title="{Binding Title}"
        Width="620" Height="580"
        MinWidth="540" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        FontFamily="{DynamicResource Kei.Font.UI}"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource Kei.Bg.Window}">

    <Window.Styles>
        <!-- 本窗口的表单与操作共用 28px 行高，避免全局 32px 按钮高于输入框。 -->
        <Style Selector="Button, TextBox, ComboBox">
            <Setter Property="Height" Value="{DynamicResource Kei.Height.Control}"/>
            <Setter Property="MinHeight" Value="{DynamicResource Kei.Height.Control}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.iconBtn">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="{DynamicResource Kei.Height.Control}"/>
            <Setter Property="Height" Value="{DynamicResource Kei.Height.Control}"/>
            <Setter Property="MinWidth" Value="{DynamicResource Kei.Height.Control}"/>
            <Setter Property="MinHeight" Value="{DynamicResource Kei.Height.Control}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="10" Margin="16">
        <!-- 头部：身份基本信息卡片（紧凑高密度布局） -->
        <Border Grid.Row="0"
                Background="{DynamicResource Kei.Bg.Card}"
                BorderBrush="{DynamicResource Kei.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Kei.Radius.Card}"
                Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:KeiString IdentityEdit.InfoSection}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Kei.Text.Primary}"
                           FontSize="13"/>

                <Grid ColumnDefinitions="80, *" ColumnSpacing="8"
                      RowDefinitions="Auto, Auto, Auto" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{loc:KeiString IdentityEdit.Name}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Kei.Text.Secondary}"
                               FontSize="13"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding Name}"
                             PlaceholderText="{loc:KeiString IdentityEdit.Name.Placeholder}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{loc:KeiString IdentityEdit.Username}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Kei.Text.Secondary}"
                               FontSize="13"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding Username}"
                             PlaceholderText="{loc:KeiString IdentityEdit.Username.Placeholder}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="{loc:KeiString IdentityEdit.Description}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Kei.Text.Secondary}"
                               FontSize="13"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding Description}"
                             PlaceholderText="{loc:KeiString IdentityEdit.Description.Placeholder}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 中部：认证方法列表卡片 -->
        <Border Grid.Row="1"
                Background="{DynamicResource Kei.Bg.Card}"
                BorderBrush="{DynamicResource Kei.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Kei.Radius.Card}"
                Padding="12">
            <Grid RowDefinitions="Auto, Auto, *">
                <TextBlock Grid.Row="0"
                           Text="{loc:KeiString IdentityEdit.MethodsSection}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Kei.Text.Primary}"
                           FontSize="13"
                           Margin="0,0,0,8"/>

                <!-- 标题独立一行，添加操作栏在最小窗口宽度下仍有完整的选择空间。 -->
                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="8" Margin="0,0,0,10">
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding MethodTypes}"
                              SelectedItem="{Binding SelectedMethodType}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AuthMethodTypeOption">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1"
                            Classes="accent"
                            Content="{loc:KeiString IdentityEdit.AddMethod}"
                            Command="{Binding AddMethodCommand}"
                            MinWidth="88"/>
                </Grid>

                <!-- 认证项列表 -->
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Methods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IdentityMethodRowViewModel">
                                <Border Background="{DynamicResource Kei.Bg.Panel}"
                                        BorderBrush="{DynamicResource Kei.Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Kei.Radius.Control}"
                                        Padding="10,8"
                                        Margin="0,0,0,8">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KindName}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Kei.Text.Primary}"
                                                           FontSize="13"/>
                                                <TextBlock Text="{Binding Hint}"
                                                           Foreground="{DynamicResource Kei.Text.Secondary}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                                        VerticalAlignment="Center">
                                                <Button Classes="iconBtn"
                                                        ToolTip.Tip="{loc:KeiString Common.MoveUp}"
                                                        AutomationProperties.Name="{loc:KeiString Common.MoveUp}"
                                                        Command="{Binding $parent[Window].((vm:IdentityEditViewModel)DataContext).MoveUpCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid Width="24" Height="24">
                                                            <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.ArrowUp}"/>
                                                        </Grid>
                                                    </Viewbox>
                                                </Button>
                                                <Button Classes="iconBtn"
                                                        ToolTip.Tip="{loc:KeiString Common.MoveDown}"
                                                        AutomationProperties.Name="{loc:KeiString Common.MoveDown}"
                                                        Command="{Binding $parent[Window].((vm:IdentityEditViewModel)DataContext).MoveDownCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid Width="24" Height="24">
                                                            <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.ArrowDown}"/>
                                                        </Grid>
                                                    </Viewbox>
                                                </Button>
                                                <Border Width="1" Height="16" Margin="4,0"
                                                        Background="{DynamicResource Kei.Border}"
                                                        VerticalAlignment="Center"/>
                                                <Button Classes="iconBtn danger"
                                                        ToolTip.Tip="{loc:KeiString Common.Delete}"
                                                        AutomationProperties.Name="{loc:KeiString Common.Delete}"
                                                        Command="{Binding $parent[Window].((vm:IdentityEditViewModel)DataContext).RemoveMethodCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid Width="24" Height="24">
                                                            <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Delete}"/>
                                                        </Grid>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 文件私钥行内字段 -->
                                        <Grid IsVisible="{Binding IsFilePrivateKey}"
                                              ColumnDefinitions="80, *, Auto" ColumnSpacing="8"
                                              RowDefinitions="Auto, Auto, Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="{loc:KeiString IdentityEdit.KeyFilePath}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Kei.Text.Secondary}"
                                                       FontSize="13"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding KeyFilePath}"
                                                     PlaceholderText="{loc:KeiString IdentityEdit.KeyFilePath.Placeholder}"/>
                                            <Button Grid.Row="0" Grid.Column="2" Content="{loc:KeiString Common.Browse}"
                                                    Command="{Binding BrowseFileCommand}" MinWidth="64"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="{loc:KeiString IdentityEdit.PassphraseMode}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Kei.Text.Secondary}"
                                                       FontSize="13"
                                                       Margin="0,8,0,0"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                      HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                                      ItemsSource="{Binding $parent[Window].((vm:IdentityEditViewModel)DataContext).PassphraseModes}"
                                                      SelectedIndex="{Binding PassphraseModeIndex}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PassphraseModeOption">
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                       Text="{Binding FileKeyStatus}"
                                                       IsVisible="{Binding HasFileKeyStatus}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Kei.Text.Secondary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                        </Grid>

                                        <!-- Vault 私钥行内字段 -->
                                        <!-- 行间距改用子元素 Margin，指纹行隐藏时不保留空隙。 -->
                                        <Grid IsVisible="{Binding IsVaultPrivateKey}"
                                              ColumnDefinitions="80, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="8">
                                            <!-- 私钥材料状态行 -->
                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="{loc:KeiString IdentityEdit.VaultKeyMaterial}"
                                                       Foreground="{DynamicResource Kei.Text.Secondary}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>
                                            <SelectableTextBlock Grid.Row="0" Grid.Column="1"
                                                                 Text="{Binding VaultKeyStatus}"
                                                                 Foreground="{DynamicResource Kei.Text.Primary}"
                                                                 FontSize="13"
                                                                 VerticalAlignment="Center"/>

                                            <!-- 指纹行（有指纹时显示，左侧标签与材料对齐，右侧指纹支持选中与折行） -->
                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="{loc:KeiString IdentityEdit.Fingerprint}"
                                                       Foreground="{DynamicResource Kei.Text.Secondary}"
                                                       FontSize="13"
                                                       VerticalAlignment="Top"
                                                       Margin="0,6,0,0"
                                                       IsVisible="{Binding HasVaultKeyFingerprint}"/>
                                            <SelectableTextBlock Grid.Row="1" Grid.Column="1"
                                                                 Text="{Binding VaultKeyFingerprint}"
                                                                 Foreground="{DynamicResource Kei.Text.Primary}"
                                                                 FontSize="12"
                                                                 FontFamily="{DynamicResource Kei.Font.Mono}"
                                                                 TextWrapping="Wrap"
                                                                 VerticalAlignment="Top"
                                                                 Margin="0,6,0,0"
                                                                 IsVisible="{Binding HasVaultKeyFingerprint}"/>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                        Margin="0,8,0,0">
                                                <Button Content="{loc:KeiString IdentityEdit.ImportVaultKey}"
                                                        Command="{Binding ImportVaultKeyCommand}"/>
                                                <Button Classes="danger" Content="{loc:KeiString IdentityEdit.RemoveVaultKey}"
                                                        Command="{Binding RemoveVaultKeyCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部：提示与确定/取消操作栏 -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*, Auto" ColumnSpacing="12">
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Kei.Status.Error}" FontSize="12" Margin="0,0,0,6"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{loc:KeiString IdentityEdit.ApplyHint}"
                       Foreground="{DynamicResource Kei.Text.Muted}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{loc:KeiString Common.Cancel}"
                        Command="{Binding CancelCommand}"
                        Width="76"
                        IsCancel="True"/>
                <Button Content="{loc:KeiString Common.Apply}"
                        Command="{Binding ApplyCommand}"
                        Width="76"/>
                <Button Classes="accent"
                        Content="{loc:KeiString Common.Confirm}"
                        Command="{Binding ConfirmCommand}"
                        Width="76"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
