<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kei.Term.App.ViewModels"
        xmlns:loc="using:Kei.Term.App.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="200"
        x:Class="Kei.Term.App.Views.DuplicateSessionWindow"
        x:DataType="vm:DuplicateSessionViewModel"
        Title="{loc:KeiString DuplicateSession.Title}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Kei.Bg.Window}"
        FontFamily="{DynamicResource Kei.Font.UI}">

    <Window.Styles>
        <Style Selector="Button.dialogBtn">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid Margin="18" RowDefinitions="Auto, Auto">
        <!-- 核心输入区域：名称、主机、端口与右侧确定/取消按钮组 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="10" ColumnSpacing="12">
            <!-- Name -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{loc:KeiString DuplicateSession.Name}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Kei.Text.Primary}"
                       FontSize="13"/>
            <TextBox x:Name="NameBox"
                     Grid.Row="0" Grid.Column="1"
                     Text="{Binding Name, Mode=TwoWay}"
                     FontSize="13"/>
            <Button Grid.Row="0" Grid.Column="2"
                    Classes="dialogBtn accent"
                    Content="{loc:KeiString DuplicateSession.Confirm}"
                    Command="{Binding ConfirmCommand}"/>

            <!-- Hostname -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{loc:KeiString DuplicateSession.Hostname}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Kei.Text.Primary}"
                       FontSize="13"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding Hostname, Mode=TwoWay}"
                     FontSize="13"/>
            <Button Grid.Row="1" Grid.Column="2"
                    Classes="dialogBtn"
                    Content="{loc:KeiString DuplicateSession.Cancel}"
                    Command="{Binding CancelCommand}"/>

            <!-- Port -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{loc:KeiString DuplicateSession.Port}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Kei.Text.Primary}"
                       FontSize="13"/>
            <NumericUpDown Grid.Row="2" Grid.Column="1"
                           Value="{Binding Port, Mode=TwoWay}"
                           Minimum="1" Maximum="65535"
                           FormatString="0"
                           HorizontalAlignment="Left"
                           Width="120"/>
        </Grid>
    </Grid>
</Window>
