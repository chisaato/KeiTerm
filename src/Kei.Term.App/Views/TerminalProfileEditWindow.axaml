<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kei.Term.App.ViewModels"
        xmlns:loc="using:Kei.Term.App.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="600"
        x:Class="Kei.Term.App.Views.TerminalProfileEditWindow"
        x:DataType="vm:TerminalProfileEditViewModel"
        Title="{loc:KeiString TerminalProfileEdit.Title}"
        Width="920" Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource Kei.Bg.Window}">

    <Window.Styles>
        <!-- 色块按键公共样式 -->
        <Style Selector="Button.colorSwatch">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.colorSwatch:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource Kei.Accent}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*, Auto" Margin="16">
        <!-- 主体区域：左右双面板 -->
        <Grid Grid.Row="0" ColumnDefinitions="420, 16, *" Margin="0,0,0,12">
            <!-- 左侧面板：调色与控制面板 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Kei.Bg.Panel}"
                    BorderBrush="{DynamicResource Kei.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Kei.Radius.Card}"
                    Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <!-- 主题名称 -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:KeiString TerminalProfileEdit.Name}"
                                       Foreground="{DynamicResource Kei.Text.Secondary}"
                                       FontSize="12"/>
                            <TextBox Text="{Binding Name}"
                                     Height="28"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <Separator Background="{DynamicResource Kei.Border}" Height="1"/>

                        <!-- 基础色 (背景、前景、光标、选区) -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:KeiString TerminalProfileEdit.BaseColors}"
                                       Foreground="{DynamicResource Kei.Accent}"
                                       FontWeight="SemiBold"
                                       FontSize="12"/>
                            
                            <Grid ColumnDefinitions="*, *, *, *" RowDefinitions="Auto, Auto">
                                <!-- 背景 -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="4">
                                    <Button Classes="colorSwatch"
                                            Background="{Binding BackgroundBrush}"
                                            Command="{Binding SelectTargetCommand}"
                                            CommandParameter="Background"/>
                                    <TextBlock Text="{loc:KeiString TerminalProfileEdit.Background}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                </StackPanel>

                                <!-- 前景 -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4">
                                    <Button Classes="colorSwatch"
                                            Background="{Binding ForegroundBrush}"
                                            Command="{Binding SelectTargetCommand}"
                                            CommandParameter="Foreground"/>
                                    <TextBlock Text="{loc:KeiString TerminalProfileEdit.Foreground}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                </StackPanel>

                                <!-- 光标 -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="4">
                                    <Button Classes="colorSwatch"
                                            Background="{Binding CursorBrush}"
                                            Command="{Binding SelectTargetCommand}"
                                            CommandParameter="Cursor"/>
                                    <TextBlock Text="{loc:KeiString TerminalProfileEdit.Cursor}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                </StackPanel>

                                <!-- 选区 -->
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="4">
                                    <Button Classes="colorSwatch"
                                            Background="{Binding SelectionBrush}"
                                            Command="{Binding SelectTargetCommand}"
                                            CommandParameter="Selection"/>
                                    <TextBlock Text="{loc:KeiString TerminalProfileEdit.Selection}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Separator Background="{DynamicResource Kei.Border}" Height="1"/>

                        <!-- ANSI 16 色调色板 (SecureCRT 风格) -->
                        <StackPanel Spacing="10">
                            <!-- Normal 8 色 -->
                            <TextBlock Text="{loc:KeiString TerminalProfileEdit.NormalAnsi}"
                                       Foreground="{DynamicResource Kei.Text.Secondary}"
                                       FontSize="12"/>
                            <UniformGrid Columns="8">
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[0]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi0" ToolTip.Tip="0 Black"/>
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[1]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi1" ToolTip.Tip="1 Red"/>
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[2]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi2" ToolTip.Tip="2 Green"/>
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[3]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi3" ToolTip.Tip="3 Yellow"/>
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[4]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi4" ToolTip.Tip="4 Blue"/>
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[5]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi5" ToolTip.Tip="5 Magenta"/>
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[6]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi6" ToolTip.Tip="6 Cyan"/>
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[7]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi7" ToolTip.Tip="7 White"/>
                            </UniformGrid>

                            <!-- Bright 8 色 -->
                            <TextBlock Text="{loc:KeiString TerminalProfileEdit.BrightAnsi}"
                                       Foreground="{DynamicResource Kei.Text.Secondary}"
                                       FontSize="12"/>
                            <UniformGrid Columns="8">
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[8]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi8" ToolTip.Tip="8 Bright Black"/>
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[9]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi9" ToolTip.Tip="9 Bright Red"/>
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[10]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi10" ToolTip.Tip="10 Bright Green"/>
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[11]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi11" ToolTip.Tip="11 Bright Yellow"/>
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[12]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi12" ToolTip.Tip="12 Bright Blue"/>
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[13]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi13" ToolTip.Tip="13 Bright Magenta"/>
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[14]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi14" ToolTip.Tip="14 Bright Cyan"/>
                                <Button Classes="colorSwatch" Background="{Binding AnsiBrushes[15]}" Command="{Binding SelectTargetCommand}" CommandParameter="Ansi15" ToolTip.Tip="15 Bright White"/>
                            </UniformGrid>
                        </StackPanel>

                        <Separator Background="{DynamicResource Kei.Border}" Height="1"/>

                        <!-- 当前色值编辑微调 -->
                        <Border Background="{DynamicResource Kei.Bg.PanelAlt}"
                                CornerRadius="{DynamicResource Kei.Radius.Control}"
                                Padding="10">
                            <Grid ColumnDefinitions="Auto, 10, *, 10, Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding ActiveColorTarget}"
                                           Foreground="{DynamicResource Kei.Text.Primary}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding ActiveHex, Mode=TwoWay}"
                                         Height="26"
                                         VerticalContentAlignment="Center"
                                         FontFamily="Cascadia Mono, Consolas, monospace"/>
                                <Border Grid.Column="4"
                                        Width="28" Height="26"
                                        CornerRadius="{DynamicResource Kei.Radius.Control}"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Kei.Border}"
                                        Background="{Binding ActiveBrush}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧面板：Tabby 风格实时模拟终端屏幕 (Demo Terminal Preview) -->
            <Border Grid.Column="2"
                    Background="{Binding BackgroundBrush}"
                    BorderBrush="{DynamicResource Kei.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Kei.Radius.Card}"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" TextElement.FontFamily="Cascadia Mono, Consolas, monospace" TextElement.FontSize="12">
                        <!-- 顶层色块梯级测试条 -->
                        <TextBlock Text="ANSI Palette Test (0-7 Normal, 8-15 Bright):"
                                   Foreground="{DynamicResource Kei.Text.Muted}"
                                   FontSize="11"/>
                        <StackPanel Orientation="Vertical" Spacing="2">
                            <UniformGrid Columns="8" Height="14">
                                <Border Background="{Binding AnsiBrushes[0]}"/>
                                <Border Background="{Binding AnsiBrushes[1]}"/>
                                <Border Background="{Binding AnsiBrushes[2]}"/>
                                <Border Background="{Binding AnsiBrushes[3]}"/>
                                <Border Background="{Binding AnsiBrushes[4]}"/>
                                <Border Background="{Binding AnsiBrushes[5]}"/>
                                <Border Background="{Binding AnsiBrushes[6]}"/>
                                <Border Background="{Binding AnsiBrushes[7]}"/>
                            </UniformGrid>
                            <UniformGrid Columns="8" Height="14">
                                <Border Background="{Binding AnsiBrushes[8]}"/>
                                <Border Background="{Binding AnsiBrushes[9]}"/>
                                <Border Background="{Binding AnsiBrushes[10]}"/>
                                <Border Background="{Binding AnsiBrushes[11]}"/>
                                <Border Background="{Binding AnsiBrushes[12]}"/>
                                <Border Background="{Binding AnsiBrushes[13]}"/>
                                <Border Background="{Binding AnsiBrushes[14]}"/>
                                <Border Background="{Binding AnsiBrushes[15]}"/>
                            </UniformGrid>
                        </StackPanel>

                        <Separator Background="{DynamicResource Kei.Border.Subtle}" Margin="0,4"/>

                        <!-- 模拟命令行 Shell 输出 -->
                        <TextBlock Foreground="{Binding ForegroundBrush}">
                            <Run Foreground="{Binding AnsiBrushes[2]}" Text="user@keiterm"/>
                            <Run Foreground="{Binding ForegroundBrush}" Text=":"/>
                            <Run Foreground="{Binding AnsiBrushes[12]}" Text="~"/>
                            <Run Foreground="{Binding ForegroundBrush}" Text="$ uname -srm"/>
                        </TextBlock>
                        <TextBlock Foreground="{Binding ForegroundBrush}" Text="Linux 6.10.0-keiterm x86_64"/>

                        <TextBlock Foreground="{Binding ForegroundBrush}" Margin="0,4,0,0">
                            <Run Foreground="{Binding AnsiBrushes[2]}" Text="user@keiterm"/>
                            <Run Foreground="{Binding ForegroundBrush}" Text=":"/>
                            <Run Foreground="{Binding AnsiBrushes[12]}" Text="~/workspace"/>
                            <Run Foreground="{Binding ForegroundBrush}" Text="$ ls -la --color=auto"/>
                        </TextBlock>

                        <!-- ls 目录与文件列表模拟 -->
                        <StackPanel Spacing="2">
                            <TextBlock Foreground="{Binding ForegroundBrush}">
                                <Run Foreground="{Binding AnsiBrushes[8]}" Text="drwxr-xr-x 4 user user 4096 Sep 29 10:00 "/>
                                <Run Foreground="{Binding AnsiBrushes[4]}" FontWeight="Bold" Text="."/>
                            </TextBlock>
                            <TextBlock Foreground="{Binding ForegroundBrush}">
                                <Run Foreground="{Binding AnsiBrushes[8]}" Text="drwxr-xr-x 6 user user 4096 Sep 29 09:30 "/>
                                <Run Foreground="{Binding AnsiBrushes[4]}" FontWeight="Bold" Text=".."/>
                            </TextBlock>
                            <TextBlock Foreground="{Binding ForegroundBrush}">
                                <Run Foreground="{Binding AnsiBrushes[8]}" Text="-rw-r--r-- 1 user user  220 Sep 29 09:30 "/>
                                <Run Foreground="{Binding ForegroundBrush}" Text=".bashrc"/>
                            </TextBlock>
                            <TextBlock Foreground="{Binding ForegroundBrush}">
                                <Run Foreground="{Binding AnsiBrushes[8]}" Text="drwxr-xr-x 2 user user 4096 Sep 29 09:35 "/>
                                <Run Foreground="{Binding AnsiBrushes[12]}" FontWeight="Bold" Text="src/"/>
                            </TextBlock>
                            <TextBlock Foreground="{Binding ForegroundBrush}">
                                <Run Foreground="{Binding AnsiBrushes[8]}" Text="-rwxr-xr-x 1 user user 8192 Sep 29 09:40 "/>
                                <Run Foreground="{Binding AnsiBrushes[10]}" FontWeight="Bold" Text="build.sh*"/>
                            </TextBlock>
                            <TextBlock Foreground="{Binding ForegroundBrush}">
                                <Run Foreground="{Binding AnsiBrushes[8]}" Text="-rw-r--r-- 1 user user 1024 Sep 29 09:42 "/>
                                <Run Foreground="{Binding AnsiBrushes[9]}" Text="package.tar.gz"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Git 状态与选区高亮模拟 -->
                        <TextBlock Foreground="{Binding ForegroundBrush}" Margin="0,4,0,0">
                            <Run Foreground="{Binding AnsiBrushes[2]}" Text="user@keiterm"/>
                            <Run Foreground="{Binding ForegroundBrush}" Text=":"/>
                            <Run Foreground="{Binding AnsiBrushes[12]}" Text="~/workspace"/>
                            <Run Foreground="{Binding ForegroundBrush}" Text="$ git status -s"/>
                        </TextBlock>
                        <StackPanel Spacing="2">
                            <TextBlock Foreground="{Binding ForegroundBrush}">
                                <Run Foreground="{Binding AnsiBrushes[1]}" Text=" M "/>
                                <Run Foreground="{Binding ForegroundBrush}" Text="BuiltInPresets.cs"/>
                            </TextBlock>
                            <!-- 选区效果演示 -->
                            <Border Background="{Binding SelectionBrush}" HorizontalAlignment="Left" Padding="1,0">
                                <TextBlock Foreground="{Binding ForegroundBrush}">
                                    <Run Foreground="{Binding AnsiBrushes[2]}" Text="?? "/>
                                    <Run Foreground="{Binding ForegroundBrush}" Text="Themes/KeiTokens.axaml (Selected)"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- 交互输入光标模拟 -->
                        <TextBlock Foreground="{Binding ForegroundBrush}" Margin="0,4,0,0">
                            <Run Foreground="{Binding AnsiBrushes[2]}" Text="user@keiterm"/>
                            <Run Foreground="{Binding ForegroundBrush}" Text=":"/>
                            <Run Foreground="{Binding AnsiBrushes[12]}" Text="~/workspace"/>
                            <Run Foreground="{Binding ForegroundBrush}" Text="$ "/>
                            <Run Foreground="{Binding CursorBrush}" Text="█"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部确定与取消操作栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{loc:KeiString Common.Cancel}"
                    Click="OnCancelClick"
                    Width="80"
                    Height="28"
                    HorizontalContentAlignment="Center"/>
            <Button Content="{loc:KeiString Common.Confirm}"
                    Click="OnConfirmClick"
                    Classes="accent"
                    Width="80"
                    Height="28"
                    HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
