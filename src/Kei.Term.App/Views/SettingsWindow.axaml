<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kei.Term.App.ViewModels"
        xmlns:settings="using:Kei.Term.App.ViewModels.Settings"
        xmlns:pages="using:Kei.Term.App.Views.Settings"
        xmlns:controls="using:Kei.Term.App.Views.Controls"
        xmlns:loc="using:Kei.Term.App.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="840" d:DesignHeight="620"
        x:Class="Kei.Term.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{loc:KeiString Settings.Title}"
        Width="980" Height="660" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        FontFamily="{DynamicResource Kei.Font.UI}"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource Kei.Bg.Window}">

    <Window.Styles>
        <StyleInclude Source="/Views/Settings/SettingsStyles.axaml"/>
    </Window.Styles>

    <Grid RowDefinitions="*, Auto">
        <Grid Grid.Row="0" ColumnDefinitions="190, *">
            <!-- 左侧：分类导航 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Kei.Bg.Panel}"
                    BorderBrush="{DynamicResource Kei.Border}"
                    BorderThickness="0,0,1,0">
                <controls:CategoryNavListBox ItemsSource="{Binding Categories}"
                                             SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/>
            </Border>

            <!-- 右侧：分类内容区，按页面 VM 类型分发模板（受 IsBusy 控制禁用交互） -->
            <Border Grid.Column="1" Background="{DynamicResource Kei.Bg.Window}">
                <ScrollViewer IsEnabled="{Binding !IsBusy}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="{Binding IsCurrentPageSelfScrolling, Converter={x:Static controls:SettingsScrollVisibilityConverter.Instance}}">
                    <ContentControl x:Name="PART_SettingsPagePresenter" Content="{Binding SelectedCategory.Page}" Margin="26,22,26,22" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="settings:SyncSettingsPage" x:DataType="settings:SyncSettingsPage">
                                <pages:SyncSettingsPageView/>
                            </DataTemplate>

                            <!-- 常规页 -->
                            <DataTemplate DataType="settings:GeneralSettingsPage"
                                          x:DataType="settings:GeneralSettingsPage">
                                <pages:GeneralSettingsPageView/>
                            </DataTemplate>

                            <!-- 外观配色页 -->
                            <DataTemplate DataType="settings:AppearanceSettingsPage"
                                          x:DataType="settings:AppearanceSettingsPage">
                                <pages:AppearanceSettingsPageView/>
                            </DataTemplate>

                            <!-- 会话树设置页 -->
                            <DataTemplate DataType="settings:TreeSettingsProxyPage"
                                          x:DataType="settings:TreeSettingsProxyPage">
                                <pages:TreeSettingsPageView/>
                            </DataTemplate>

                            <!-- 终端设置页（底层终端仿真与回滚缓冲） -->
                            <DataTemplate DataType="settings:TerminalSettingsCombinedPage"
                                          x:DataType="settings:TerminalSettingsCombinedPage">
                                <pages:TerminalSettingsPageView/>
                            </DataTemplate>

                            <!-- 终端外观设置页（配色方案、主字体与回退字体，左右两栏响应式布局） -->
                            <DataTemplate DataType="settings:TerminalAppearanceSettingsPage"
                                          x:DataType="settings:TerminalAppearanceSettingsPage">
                                <pages:TerminalAppearanceSettingsPageView/>
                            </DataTemplate>

                            <!-- 标签栏设置页 -->
                            <DataTemplate DataType="settings:TabBarSettingsProxyPage"
                                          x:DataType="settings:TabBarSettingsProxyPage">
                                <pages:TabBarSettingsPageView/>
                            </DataTemplate>

                            <!-- SSH 页 -->
                            <DataTemplate DataType="settings:SshSettingsPage"
                                          x:DataType="settings:SshSettingsPage">
                                <pages:SshSettingsPageView/>
                            </DataTemplate>

                            <!-- 安全页：主密码、自动锁定、本机解锁 -->
                            <DataTemplate DataType="settings:SecuritySettingsPage"
                                          x:DataType="settings:SecuritySettingsPage">
                                <pages:SecuritySettingsPageView/>
                            </DataTemplate>


                            <!-- 界面回退字体下钻子页 -->
                            <DataTemplate DataType="settings:UiFallbackFontsSubPage"
                                          x:DataType="settings:UiFallbackFontsSubPage">
                                <pages:UiFallbackFontsSubPageView/>
                            </DataTemplate>

                            <!-- 终端回退字体下钻子页 -->
                            <DataTemplate DataType="settings:TerminalFallbackFontsSubPage"
                                          x:DataType="settings:TerminalFallbackFontsSubPage">
                                <pages:TerminalFallbackFontsSubPageView/>
                            </DataTemplate>

                            <!-- 标签标题变量参考下钻子页 -->
                            <DataTemplate DataType="settings:TabBarVariablesSubPage"
                                          x:DataType="settings:TabBarVariablesSubPage">
                                <pages:TabBarVariablesSubPageView/>
                            </DataTemplate>

                            <!-- 传输页（新样式样板） -->
                            <DataTemplate DataType="settings:TransferSettingsPage"
                                          x:DataType="settings:TransferSettingsPage">
                                <pages:TransferSettingsPageView/>
                            </DataTemplate>

                            <!-- 文件管理与编辑器页（新样式样板） -->
                            <DataTemplate DataType="settings:FileManagerSettingsPage"
                                          x:DataType="settings:FileManagerSettingsPage">
                                <pages:FileManagerSettingsPageView/>
                            </DataTemplate>

                            <!-- 哈希算法优先级下钻子页 -->
                            <DataTemplate DataType="settings:HashAlgorithmsSubPage"
                                          x:DataType="settings:HashAlgorithmsSubPage">
                                <pages:HashAlgorithmsSubPageView/>
                            </DataTemplate>

                            <!-- 归档格式优先级下钻子页 -->
                            <DataTemplate DataType="settings:ArchiveFormatsSubPage"
                                          x:DataType="settings:ArchiveFormatsSubPage">
                                <pages:ArchiveFormatsSubPageView/>
                            </DataTemplate>

                            <DataTemplate DataType="settings:ProxySettingsPage" x:DataType="settings:ProxySettingsPage">
                                <pages:ProxySettingsPageView/>
                            </DataTemplate>

                        </ContentControl.DataTemplates>
                    </ContentControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部：操作按钮与错误提示行（取消 / 应用 / 确定 三态分家） -->
        <Border Grid.Row="1"
                Background="{DynamicResource Kei.Bg.Panel}"
                BorderBrush="{DynamicResource Kei.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid ColumnDefinitions="*, Auto">
                <!-- 窗口内可见错误/提示信息条（保留原始+补偿错误，可选中复制） -->
                <SelectableTextBlock x:Name="NotificationTextBlock"
                                     Grid.Column="0"
                                     VerticalAlignment="Center"
                                     Margin="0,0,16,0"
                                     Foreground="{DynamicResource Kei.Status.Error}"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     IsVisible="False"/>

                <!-- 底部操作按钮容器：受 IsBusy 控制禁用交互，保留左侧 NotificationTextBlock 独立可读可复制 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="12"
                            IsEnabled="{Binding !IsBusy}">
                    <Button Content="{loc:KeiString Common.Cancel}" MinWidth="88" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}"/>
                    <Button Content="{loc:KeiString Common.Apply}" MinWidth="88" HorizontalContentAlignment="Center" Command="{Binding ApplyCommand}"/>
                    <Button Content="{loc:KeiString Common.Confirm}" MinWidth="88" HorizontalContentAlignment="Center"
                            Classes="save" Foreground="{DynamicResource Kei.Accent.Foreground}" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
