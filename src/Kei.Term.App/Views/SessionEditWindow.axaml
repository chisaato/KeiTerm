<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kei.Term.App.ViewModels"
        xmlns:loc="using:Kei.Term.App.Helpers"
        xmlns:controls="using:Kei.Term.App.Views.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="520"
        x:Class="Kei.Term.App.Views.SessionEditWindow"
        x:DataType="vm:SessionEditViewModel"
        Title="{Binding Title}"
        Width="700" Height="520" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        FontFamily="{DynamicResource Kei.Font.UI}"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource Kei.Bg.Window}">

    <Window.Styles>
        <Style Selector="Button.save /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Kei.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Kei.Accent.Foreground}"/>
        </Style>
        <Style Selector="Button.save:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Kei.Accent.Hover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Kei.Accent.Foreground}"/>
        </Style>
        <Style Selector="Button.save:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Kei.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Kei.Accent.Foreground}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*, Auto">
        <!-- 主体区域：左侧分类侧边栏，右侧根据分类切换内容 -->
        <Grid Grid.Row="0" ColumnDefinitions="160, *">
            <!-- 左侧：分类导航 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Kei.Bg.Panel}"
                    BorderBrush="{DynamicResource Kei.Border}"
                    BorderThickness="0,0,1,0">
                <controls:CategoryNavListBox ItemsSource="{Binding Categories}"
                                             SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/>
            </Border>

            <!-- 右侧：分类面板区 -->
            <Border Grid.Column="1" Background="{DynamicResource Kei.Bg.Window}">
                <ScrollViewer Margin="24,20">
                    <StackPanel Spacing="14">
                        <!-- 1. 连接分类 -->
                        <StackPanel Spacing="14" IsVisible="{Binding SelectedCategory.Page, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Connection'}">
                            <TextBlock Text="{loc:KeiString SessionEdit.BasicSection}" FontWeight="Bold" Foreground="{DynamicResource Kei.Text.Primary}" FontSize="13"/>

                            <!-- 协议类型切换 -->
                            <Grid ColumnDefinitions="120, *" ColumnSpacing="12">
                                <TextBlock Text="{loc:KeiString SessionEdit.ConnectionProtocol}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                <ComboBox x:Name="SessionProtocolComboBox" Grid.Column="1" ItemsSource="{Binding AvailableConnectionProtocols}"
                                          SelectedItem="{Binding SelectedConnectionProtocolOption}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!-- Telnet 安全提示卡片 -->
                            <Border IsVisible="{Binding IsTelnetProtocol}"
                                    Background="{DynamicResource Kei.Bg.Card}"
                                    BorderBrush="{DynamicResource Kei.Warning}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Kei.Radius.Control}"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                    <TextBlock Text="⚠" Foreground="{DynamicResource Kei.Warning}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{loc:KeiString SessionEdit.Telnet.SecurityWarning}"
                                               Foreground="{DynamicResource Kei.Text.Primary}"
                                               FontSize="12" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- 不受支持协议提示卡片 -->
                            <Border IsVisible="{Binding IsUnsupportedProtocol}"
                                    Background="{DynamicResource Kei.Bg.Card}"
                                    BorderBrush="{DynamicResource Kei.Warning}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Kei.Radius.Control}"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                    <TextBlock Text="⚠" Foreground="{DynamicResource Kei.Warning}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{loc:KeiString SessionEdit.Protocol.UnsupportedNotice}"
                                               Foreground="{DynamicResource Kei.Text.Primary}"
                                               FontSize="12" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- 显示名称（所有协议通用） -->
                            <Grid ColumnDefinitions="120, *" ColumnSpacing="12">
                                <TextBlock Text="{loc:KeiString SessionEdit.Name}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="{loc:KeiString SessionEdit.Name.Placeholder}"/>
                            </Grid>

                            <!-- 网络协议（SSH & Telnet）参数 -->
                            <StackPanel Spacing="10" IsVisible="{Binding IsNetworkProtocol}">
                                <Grid ColumnDefinitions="120, *" ColumnSpacing="12">
                                    <TextBlock Text="{loc:KeiString SessionEdit.Host}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Host}" PlaceholderText="{loc:KeiString SessionEdit.Host.Placeholder}"/>
                                </Grid>

                                <Grid ColumnDefinitions="120, *" ColumnSpacing="12">
                                    <TextBlock Text="{loc:KeiString SessionEdit.Port}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                    <NumericUpDown Grid.Column="1" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0" HorizontalAlignment="Left" MinWidth="180"/>
                                </Grid>

                                <!-- SSH 专属凭据与跳板/代理 -->
                                <StackPanel Spacing="10" IsVisible="{Binding IsSshProtocol}">
                                    <Grid ColumnDefinitions="120, *" ColumnSpacing="12">
                                        <TextBlock Text="{loc:KeiString SessionEdit.Username}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                        <TextBox Grid.Column="1" Text="{Binding Username}" PlaceholderText="{Binding UsernamePlaceholder}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="120, *" ColumnSpacing="12">
                                        <TextBlock Text="{loc:KeiString SessionEdit.Identity}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Identities}" SelectedItem="{Binding SelectedIdentity}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnDefinitions="120, *" ColumnSpacing="12">
                                        <TextBlock Text="{loc:KeiString SessionEdit.Firewall}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding FirewallOptions}" SelectedItem="{Binding SelectedFirewall}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>

                                <!-- 网络超时与传输引擎 -->
                                <Grid ColumnDefinitions="120, *" ColumnSpacing="12">
                                    <TextBlock Text="{loc:KeiString Settings.Ssh.ConnectTimeout}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ConnectTimeoutOptions}" SelectedItem="{Binding SelectedConnectTimeout}" HorizontalAlignment="Stretch"/>
                                </Grid>

                                <Grid ColumnDefinitions="120, *" ColumnSpacing="12">
                                    <TextBlock Text="{loc:KeiString SessionEdit.TransportEngine}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                    <ComboBox x:Name="SessionTransportEngineComboBox" Grid.Column="1" ItemsSource="{Binding TransportEngineOptions}" SelectedItem="{Binding SelectedTransportEngine}" HorizontalAlignment="Stretch"/>
                                </Grid>
                            </StackPanel>

                            <!-- Serial 串口参数与三级逐字段覆盖 -->
                            <StackPanel Spacing="14" IsVisible="{Binding IsSerialProtocol}">
                                <TextBlock Text="{loc:KeiString SessionEdit.Serial.Section}" FontWeight="Bold" Foreground="{DynamicResource Kei.Text.Primary}" FontSize="13"/>

                                <!-- 作用域层级切换 -->
                                <Grid ColumnDefinitions="120, *" ColumnSpacing="12">
                                    <TextBlock Text="{loc:KeiString SessionEdit.Serial.Scope}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                    <ComboBox x:Name="SessionSerialScopeComboBox" Grid.Column="1" ItemsSource="{Binding SerialScopes}"
                                              SelectedItem="{Binding SelectedSerialScopeOption}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SerialScopeOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <!-- 当前层级参数表格 -->
                                <Grid ColumnDefinitions="140, *, Auto" ColumnSpacing="10" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="10">
                                    <!-- 端口端点 -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:KeiString SessionEdit.Serial.PortName}" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Overridden}" FontSize="12" Foreground="{DynamicResource Kei.Accent}" IsVisible="{Binding IsPortOverriddenInCurrentScope}"/>
                                        </Border>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Inherited}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" IsVisible="{Binding !IsPortOverriddenInCurrentScope}"/>
                                        </Border>
                                    </StackPanel>
                                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                        <AutoCompleteBox x:Name="SerialScopePortAutoCompleteBox"
                                                         Text="{Binding CurrentScopePortName}"
                                                         ItemsSource="{Binding SerialPortNames}"
                                                         FilterMode="ContainsOrdinal"
                                                         PlaceholderText="{loc:KeiString SessionEdit.Serial.PortName.Placeholder}"/>
                                        <Button x:Name="RefreshSerialPortsButton" Grid.Column="1"
                                                Command="{Binding RefreshSerialPortsCommand}"
                                                ToolTip.Tip="{loc:KeiString SessionEdit.Serial.RefreshPorts}"
                                                Padding="6,2" MinWidth="32" VerticalAlignment="Stretch">
                                            <Viewbox Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid Width="24" Height="24">
                                                    <Path Classes="kei-icon" Width="24" Height="24" Stretch="None" Data="{StaticResource Kei.Icon.Refresh}"/>
                                                </Grid>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                    <Button Grid.Row="0" Grid.Column="2" Content="{loc:KeiString SessionEdit.Serial.ResetOverride}" Command="{Binding ResetPortOverrideCommand}"
                                            IsVisible="{Binding IsPortOverriddenInCurrentScope}" ToolTip.Tip="{loc:KeiString SessionEdit.Serial.ResetOverrideTip}" Padding="6,2"/>

                                    <!-- 波特率 -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:KeiString SessionEdit.Serial.BaudRate}" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Overridden}" FontSize="12" Foreground="{DynamicResource Kei.Accent}" IsVisible="{Binding IsBaudRateOverriddenInCurrentScope}"/>
                                        </Border>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Inherited}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" IsVisible="{Binding !IsBaudRateOverriddenInCurrentScope}"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox x:Name="SerialScopeBaudRateComboBox" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SerialBaudRates}" SelectedItem="{Binding CurrentScopeBaudRate}" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="{loc:KeiString SessionEdit.Serial.ResetOverride}" Command="{Binding ResetBaudRateOverrideCommand}"
                                            IsVisible="{Binding IsBaudRateOverriddenInCurrentScope}" ToolTip.Tip="{loc:KeiString SessionEdit.Serial.ResetOverrideTip}" Padding="6,2"/>

                                    <!-- 数据位 -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:KeiString SessionEdit.Serial.DataBits}" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Overridden}" FontSize="12" Foreground="{DynamicResource Kei.Accent}" IsVisible="{Binding IsDataBitsOverriddenInCurrentScope}"/>
                                        </Border>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Inherited}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" IsVisible="{Binding !IsDataBitsOverriddenInCurrentScope}"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox x:Name="SerialScopeDataBitsComboBox" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SerialDataBitsOptions}" SelectedItem="{Binding CurrentScopeDataBits}" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="{loc:KeiString SessionEdit.Serial.ResetOverride}" Command="{Binding ResetDataBitsOverrideCommand}"
                                            IsVisible="{Binding IsDataBitsOverriddenInCurrentScope}" ToolTip.Tip="{loc:KeiString SessionEdit.Serial.ResetOverrideTip}" Padding="6,2"/>

                                    <!-- 校验位 -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:KeiString SessionEdit.Serial.Parity}" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Overridden}" FontSize="12" Foreground="{DynamicResource Kei.Accent}" IsVisible="{Binding IsParityOverriddenInCurrentScope}"/>
                                        </Border>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Inherited}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" IsVisible="{Binding !IsParityOverriddenInCurrentScope}"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox x:Name="SerialScopeParityComboBox" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding SerialParities}" SelectedItem="{Binding CurrentScopeParity}" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Row="3" Grid.Column="2" Content="{loc:KeiString SessionEdit.Serial.ResetOverride}" Command="{Binding ResetParityOverrideCommand}"
                                            IsVisible="{Binding IsParityOverriddenInCurrentScope}" ToolTip.Tip="{loc:KeiString SessionEdit.Serial.ResetOverrideTip}" Padding="6,2"/>

                                    <!-- 停止位 -->
                                    <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:KeiString SessionEdit.Serial.StopBits}" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Overridden}" FontSize="12" Foreground="{DynamicResource Kei.Accent}" IsVisible="{Binding IsStopBitsOverriddenInCurrentScope}"/>
                                        </Border>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Inherited}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" IsVisible="{Binding !IsStopBitsOverriddenInCurrentScope}"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox x:Name="SerialScopeStopBitsComboBox" Grid.Row="4" Grid.Column="1" ItemsSource="{Binding SerialStopBitsOptions}" SelectedItem="{Binding CurrentScopeStopBits}" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Row="4" Grid.Column="2" Content="{loc:KeiString SessionEdit.Serial.ResetOverride}" Command="{Binding ResetStopBitsOverrideCommand}"
                                            IsVisible="{Binding IsStopBitsOverriddenInCurrentScope}" ToolTip.Tip="{loc:KeiString SessionEdit.Serial.ResetOverrideTip}" Padding="6,2"/>

                                    <!-- 自动流控 -->
                                    <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:KeiString SessionEdit.Serial.FlowControl}" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Overridden}" FontSize="12" Foreground="{DynamicResource Kei.Accent}" IsVisible="{Binding IsFlowControlOverriddenInCurrentScope}"/>
                                        </Border>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Inherited}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" IsVisible="{Binding !IsFlowControlOverriddenInCurrentScope}"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox x:Name="SerialScopeFlowControlComboBox" Grid.Row="5" Grid.Column="1" ItemsSource="{Binding SerialFlowControls}"
                                              SelectedValue="{Binding CurrentScopeFlowControl}" SelectedValueBinding="{Binding Mode, DataType=vm:SerialFlowControlOption}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Row="5" Grid.Column="2" Content="{loc:KeiString SessionEdit.Serial.ResetOverride}" Command="{Binding ResetFlowControlOverrideCommand}"
                                            IsVisible="{Binding IsFlowControlOverriddenInCurrentScope}" ToolTip.Tip="{loc:KeiString SessionEdit.Serial.ResetOverrideTip}" Padding="6,2"/>

                                    <!-- DTR 引脚 -->
                                    <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:KeiString SessionEdit.Serial.Dtr}" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Overridden}" FontSize="12" Foreground="{DynamicResource Kei.Accent}" IsVisible="{Binding IsDtrOverriddenInCurrentScope}"/>
                                        </Border>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Inherited}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" IsVisible="{Binding !IsDtrOverriddenInCurrentScope}"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox x:Name="SerialScopeDtrComboBox" Grid.Row="6" Grid.Column="1" ItemsSource="{Binding SerialPinOptions}"
                                              SelectedValue="{Binding CurrentScopeDtrEnable}" SelectedValueBinding="{Binding Value, DataType=vm:SerialPinOption}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Row="6" Grid.Column="2" Content="{loc:KeiString SessionEdit.Serial.ResetOverride}" Command="{Binding ResetDtrOverrideCommand}"
                                            IsVisible="{Binding IsDtrOverriddenInCurrentScope}" ToolTip.Tip="{loc:KeiString SessionEdit.Serial.ResetOverrideTip}" Padding="6,2"/>

                                    <!-- RTS 引脚 -->
                                    <StackPanel Grid.Row="7" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:KeiString SessionEdit.Serial.Rts}" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Overridden}" FontSize="12" Foreground="{DynamicResource Kei.Accent}" IsVisible="{Binding IsRtsOverriddenInCurrentScope}"/>
                                        </Border>
                                        <Border IsVisible="{Binding IsOverrideScopeSelected}" Background="{DynamicResource Kei.Bg.Card}" CornerRadius="2" Padding="4,1">
                                            <TextBlock Text="{loc:KeiString SessionEdit.Serial.Inherited}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}" IsVisible="{Binding !IsRtsOverriddenInCurrentScope}"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox x:Name="SerialScopeRtsComboBox" Grid.Row="7" Grid.Column="1" ItemsSource="{Binding SerialPinOptions}"
                                              SelectedValue="{Binding CurrentScopeRtsEnable}" SelectedValueBinding="{Binding Value, DataType=vm:SerialPinOption}"
                                              IsEnabled="{Binding IsSerialRtsManualAllowed}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Row="7" Grid.Column="2" Content="{loc:KeiString SessionEdit.Serial.ResetOverride}" Command="{Binding ResetRtsOverrideCommand}"
                                            IsVisible="{Binding IsRtsOverriddenInCurrentScope}" ToolTip.Tip="{loc:KeiString SessionEdit.Serial.ResetOverrideTip}" Padding="6,2"/>
                                </Grid>

                                <!-- 串口发现错误提示 -->
                                <Border x:Name="SerialPortDiscoveryErrorBorder"
                                        IsVisible="{Binding SerialPortDiscoveryError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Background="{DynamicResource Kei.Bg.Card}"
                                        BorderBrush="{DynamicResource Kei.Warning}"
                                        BorderThickness="1" CornerRadius="{DynamicResource Kei.Radius.Control}"
                                        Padding="10,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="⚠" Foreground="{DynamicResource Kei.Warning}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SerialPortDiscoveryError}" FontSize="12" Foreground="{DynamicResource Kei.Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- RTS 冲突警告 -->
                                <Border IsVisible="{Binding IsSerialRtsConflict}"
                                        Background="{DynamicResource Kei.Bg.Card}"
                                        BorderBrush="{DynamicResource Kei.Border.Subtle}"
                                        BorderThickness="1" CornerRadius="{DynamicResource Kei.Radius.Control}"
                                        Padding="10,8">
                                    <TextBlock Text="{Binding SerialRtsConflictWarning}"
                                               FontSize="12" Foreground="{DynamicResource Kei.Text.Secondary}" TextWrapping="Wrap"/>
                                </Border>

                                <!-- 下层手动 RTS 冲突警告 -->
                                <Border IsVisible="{Binding IsLowerLevelManualRtsConflict}"
                                        Background="{DynamicResource Kei.Bg.Card}"
                                        BorderBrush="{DynamicResource Kei.Warning}"
                                        BorderThickness="1" CornerRadius="{DynamicResource Kei.Radius.Control}"
                                        Padding="10,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="⚠" Foreground="{DynamicResource Kei.Warning}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LowerLevelRtsConflictWarning}"
                                                   FontSize="12" Foreground="{DynamicResource Kei.Text.Primary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- 三级端口快速概览 -->
                                <TextBlock Text="{loc:KeiString SessionEdit.Serial.BindingSection}" FontWeight="Bold" Foreground="{DynamicResource Kei.Text.Primary}" FontSize="13"/>

                                <Grid ColumnDefinitions="140, *" ColumnSpacing="10" RowDefinitions="Auto, Auto, Auto" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:KeiString SessionEdit.Serial.Binding.Generic}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SerialGenericPort}" PlaceholderText="{loc:KeiString SessionEdit.Serial.PortName.Placeholder}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding OsBindingLabel}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SerialOsPort}" PlaceholderText="{loc:KeiString SessionEdit.Serial.PortName.Placeholder}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:KeiString SessionEdit.Serial.Binding.Device}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SerialDevicePort}" PlaceholderText="{loc:KeiString SessionEdit.Serial.PortName.Placeholder}"/>
                                </Grid>

                                <!-- 设备标识与重建 -->
                                <Border Background="{DynamicResource Kei.Bg.Card}" BorderBrush="{DynamicResource Kei.Border.Subtle}"
                                        BorderThickness="1" CornerRadius="{DynamicResource Kei.Radius.Control}" Padding="10,8">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                                        <TextBlock Text="{loc:KeiString SessionEdit.Serial.DeviceId}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentDeviceIdDisplay}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Kei.Text.Primary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Content="{loc:KeiString SessionEdit.Serial.RegenerateDeviceId}"
                                                Command="{Binding RegenerateDeviceIdCommand}"
                                                IsEnabled="{Binding CanRegenerateDeviceId}"
                                                ToolTip.Tip="{loc:KeiString SessionEdit.Serial.RegenerateDeviceIdTip}"
                                                Padding="6,2" FontSize="12" MinHeight="24"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 描述说明（所有协议通用） -->
                            <Grid ColumnDefinitions="120, *" ColumnSpacing="12">
                                <TextBlock Text="{loc:KeiString SessionEdit.Description}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                <TextBox Grid.Column="1" Text="{Binding Description}" PlaceholderText="{loc:KeiString SessionEdit.Description.Placeholder}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 2. 终端与脚本 (Terminal) -->
                        <StackPanel Spacing="14" IsVisible="{Binding SelectedCategory.Page, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Terminal'}">
                            <TextBlock Text="{loc:KeiString SessionEdit.AdvancedSection}" FontWeight="Bold" Foreground="{DynamicResource Kei.Text.Primary}" FontSize="13"/>

                            <Grid ColumnDefinitions="120, *" ColumnSpacing="12" RowDefinitions="Auto, Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:KeiString SessionEdit.TerminalType}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TerminalType}" PlaceholderText="{loc:KeiString SessionEdit.TerminalType.Placeholder}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:KeiString SessionEdit.StartupScript}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StartupScript}" PlaceholderText="{loc:KeiString SessionEdit.StartupScript.Placeholder}" AcceptsReturn="True" Height="100"/>
                            </Grid>
                        </StackPanel>

                        <!-- 3. 文件传输 (FileTransfer) -->
                        <StackPanel Spacing="14" IsVisible="{Binding SelectedCategory.Page, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='FileTransfer'}">
                            <TextBlock Text="{loc:KeiString SessionEdit.FileManagerProtocolSection}" FontWeight="Bold" Foreground="{DynamicResource Kei.Text.Primary}" FontSize="13"/>

                            <Grid ColumnDefinitions="120, *" ColumnSpacing="12" RowDefinitions="Auto, Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="传输协议:" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableProtocols}" SelectedItem="{Binding SelectedProtocol}" HorizontalAlignment="Stretch"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="SFTP 模式:" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableSftpModes}" SelectedItem="{Binding SelectedSftpMode}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <TextBlock Text="{loc:KeiString Terminal.Drop.SettingsSection}" FontWeight="Bold" Foreground="{DynamicResource Kei.Text.Primary}" FontSize="13"/>
                            <Grid ColumnDefinitions="120,*" ColumnSpacing="12">
                                <TextBlock Text="{loc:KeiString Terminal.Drop.Protocol}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                <ComboBox x:Name="SessionTerminalUploadProtocolComboBox" Grid.Column="1" ItemsSource="{Binding TerminalUploadOptions}" SelectedItem="{Binding SelectedTerminalUpload}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <TextBlock Text="{loc:KeiString Terminal.Drop.SessionHint}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}"/>

                            <!-- 完整性校验与归档传输覆盖 -->
                            <TextBlock Text="{loc:KeiString SessionEdit.TransferCapabilitiesSection}" FontWeight="Bold" Foreground="{DynamicResource Kei.Text.Primary}" FontSize="13"/>
                            <Grid ColumnDefinitions="120, *" ColumnSpacing="12" RowDefinitions="Auto, Auto" RowSpacing="10" MaxWidth="440" HorizontalAlignment="Left">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:KeiString SessionEdit.VerifyHash}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                <ComboBox x:Name="SessionVerifyHashComboBox" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding VerifyHashOptions}" SelectedItem="{Binding SelectedVerifyHash}" HorizontalAlignment="Stretch"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:KeiString SessionEdit.ArchiveDirectories}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                <ComboBox x:Name="SessionArchiveDirectoriesComboBox" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ArchiveDirectoriesOptions}" SelectedItem="{Binding SelectedArchiveDirectories}" HorizontalAlignment="Stretch"/>
                            </Grid>

                            <!-- 能力探测展示 -->
                            <Border Background="{DynamicResource Kei.Bg.Card}" BorderBrush="{DynamicResource Kei.Border.Subtle}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Kei.Radius.Control}" Padding="10,8"
                                    MaxWidth="440" HorizontalAlignment="Left">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{loc:KeiString SessionEdit.ProbeResultTitle}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource Kei.Text.Primary}" VerticalAlignment="Center"/>
                                        <Button x:Name="ClearProbeButton" Grid.Column="1" Content="{loc:KeiString SessionEdit.ClearProbe}"
                                                Command="{Binding ClearProbeCommand}" IsEnabled="{Binding CanClearProbe}"
                                                ToolTip.Tip="{loc:KeiString SessionEdit.ClearProbeTip}" Padding="6,2" FontSize="12" MinHeight="24"/>
                                    </Grid>
                                    <TextBlock Text="{Binding ProbeStatusText}" FontSize="12" Foreground="{DynamicResource Kei.Text.Secondary}"
                                               IsVisible="{Binding !HasProbeResult}"/>
                                    <StackPanel Spacing="3" IsVisible="{Binding HasProbeResult}">
                                        <TextBlock Text="{Binding ProbePlatformText}" FontSize="12" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                        <TextBlock Text="{Binding ProbeHashesText}" FontSize="12" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                        <TextBlock Text="{Binding ProbeArchivesText}" FontSize="12" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                        <TextBlock Text="{Binding ProbeTimeText}" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 4. 会话行为 (Behavior) -->
                        <StackPanel Spacing="14" IsVisible="{Binding SelectedCategory.Page, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Behavior'}">
                            <TextBlock Text="{loc:KeiString SessionEdit.BehaviorSection}" FontWeight="Bold" Foreground="{DynamicResource Kei.Text.Primary}" FontSize="13"/>

                            <Grid ColumnDefinitions="120, *" ColumnSpacing="12" RowDefinitions="Auto, Auto, Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:KeiString SessionEdit.TabTitle}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding TitleFollowOptions}" SelectedItem="{Binding SelectedTitleFollow}" HorizontalAlignment="Stretch"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:KeiString SessionEdit.CwdFollow}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                <ComboBox x:Name="SessionDirectoryFollowModeComboBox" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CwdFollowOptions}" SelectedItem="{Binding SelectedCwdFollow}" HorizontalAlignment="Stretch"/>

                                <TextBlock Grid.Row="2" Text="{loc:KeiString Settings.Terminal.Multiplexer}" VerticalAlignment="Center" Foreground="{DynamicResource Kei.Text.Secondary}"/>
                                <ComboBox x:Name="SessionTerminalMultiplexerModeComboBox" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding MultiplexerOptions}"
                                          SelectedItem="{Binding SelectedMultiplexer}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <TextBlock Text="{loc:KeiString SessionEdit.DirectoryFollowHint}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}"/>
                            <TextBlock Text="{loc:KeiString Settings.Terminal.MultiplexerTip}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Kei.Text.Muted}"/>
                        </StackPanel>

                        <!-- 5. 端口转发。不改连接页的防火墙行。 -->
                        <StackPanel Spacing="14" IsVisible="{Binding SelectedCategory.Page, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Ports'}">
                            <TextBlock Text="{loc:KeiString SessionEdit.Category.Ports}" FontWeight="Bold" Foreground="{DynamicResource Kei.Text.Primary}" FontSize="13"/>
                            <TextBlock Text="{loc:KeiString PortForward.Hint}" Foreground="{DynamicResource Kei.Text.Secondary}" TextWrapping="Wrap"/>
                            <ListBox ItemsSource="{Binding PortForwards}" SelectedItem="{Binding SelectedPortForward}" MaxHeight="220" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Mode}" MinWidth="72"/>
                                            <TextBlock Text="{Binding BindAddress}"/>
                                            <TextBlock Text="{Binding ListenPort}"/>
                                            <TextBlock Text="{Binding DestinationHost}"/>
                                            <TextBlock Text="{Binding DestinationPort}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:KeiString PortForward.Add}" Command="{Binding AddPortForwardCommand}" MinWidth="72"/>
                                <Button Content="{loc:KeiString PortForward.Edit}" Command="{Binding EditPortForwardCommand}" MinWidth="72"/>
                                <Button Classes="danger" Content="{loc:KeiString Common.Delete}" Command="{Binding DeletePortForwardCommand}" MinWidth="72"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部确定/取消按钮 -->
        <Border Grid.Row="1" Background="{DynamicResource Kei.Bg.Panel}" BorderBrush="{DynamicResource Kei.Border}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="{loc:KeiString Common.Cancel}" Command="{Binding CancelCommand}" Width="85" HorizontalContentAlignment="Center"/>
                <Button Content="{loc:KeiString Common.Save}" Command="{Binding SaveCommand}" Width="85" HorizontalContentAlignment="Center" Classes="save"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
