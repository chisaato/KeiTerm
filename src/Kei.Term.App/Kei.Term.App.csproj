<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/KeiTerm-transparent.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <!-- Dock 实验锁定 12.1.0.6。官方 Dock.Avalonia 最低 Avalonia 为 12.1.1，此处不升级也不降级现有 Avalonia 12.1.2。主题入口由后续任务接入。 -->
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.7" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.7" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.1.0.7" />
    <!-- 诊断桥仅 Debug 消费。非 Debug 把 IncludeAssets 置为 None，编译与复制都不带走该程序集，避免多 RID 的 Release 发布带上 DevTools。 -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- 官方 XAML 热重载是授权包，无密钥时模块初始化会抛 AvaloniaLicensingException。
         仅 Debug 且已设置 AvaloniaUILicenseKey（MSBuild 属性或同名环境变量）时引用；密钥由 AvaloniaUI.Licensing 的 targets 写入宿主配置。 -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport.HotReload" Version="1.0.1"
                      Condition="'$(Configuration)' == 'Debug' AND '$(AvaloniaUILicenseKey)' != ''" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="RoyalApps.RoyalTerminal.Avalonia" Version="0.6.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../third-party/lucide/LICENSE" Link="Licenses/Lucide/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../third-party/lucide/README.md" Link="Licenses/Lucide/README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kei.Term.Core\Kei.Term.Core.csproj" />
    <ProjectReference Include="..\Kei.Term.Infrastructure\Kei.Term.Infrastructure.csproj" />
    <ProjectReference Include="..\Kei.Term.Ssh\Kei.Term.Ssh.csproj" />
  </ItemGroup>
</Project>
