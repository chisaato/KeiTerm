<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- KeiTerm 全局统一矢量图标库（标准化 24×24 视口网格，闭合单色矢量，杜绝跨平台字符渲染差异） -->

    <!-- ================= 连接与身份凭据 ================= -->
    <!-- 快速连接：闪电 -->
    <StreamGeometry x:Key="Kei.Icon.QuickConnect">M13 2L3 14h7v8l10-12h-7l3-8z</StreamGeometry>

    <!-- 连接：双引脚插头 -->
    <StreamGeometry x:Key="Kei.Icon.Connect">M9 2v4M15 2v4M6 6h12v4a6 6 0 0 1-12 0V6zM12 16v6</StreamGeometry>

    <!-- 断开连接：断开插头（带斜切断线） -->
    <StreamGeometry x:Key="Kei.Icon.Disconnect">M9 2v3M15 2v3M6 6h12v3a6 6 0 0 1-4 5.6M12 17v5M2 2l20 20M6 10a6 6 0 0 0 3 5.2</StreamGeometry>

    <!-- 凭据/密钥：钥匙 -->
    <StreamGeometry x:Key="Kei.Icon.Key">M21 2l-7.5 7.5a6 6 0 1 0 2 2L18 9l1 1 2-2-1-1 3-3-2-2zM7.5 19a3 3 0 1 1 0-6 3 3 0 0 1 0 6z</StreamGeometry>

    <!-- SSH 挂锁 -->
    <StreamGeometry x:Key="Kei.Icon.Lock">M17 11V7a5 5 0 0 0-10 0v4H5v11h14V11h-2zm-8-4a3 3 0 0 1 6 0v4H9V7zm3 9a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z</StreamGeometry>


    <!-- ================= 会话与树管理器 ================= -->
    <!-- 终端会话：窗口外框 + 提示符 > 和光标 _ -->
    <StreamGeometry x:Key="Kei.Icon.Terminal">M2 4h20v16H2V4zm2 2v12h16V6H4zm3 3l3.5 3L7 15l1.4 1.4 5.1-4.4-5.1-4.4L7 9zm6 5h4v2h-4v-2z</StreamGeometry>

    <!-- 新建会话：终端小窗 + 右下角加号 -->
    <StreamGeometry x:Key="Kei.Icon.NewSession">M2 4h20v11h-2V6H4v12h9v2H2V4zm5 4l3 2.5L7 13l1.2 1.2 4.3-3.7-4.3-3.7L7 8zm11 5v3h-3v2h3v3h2v-3h3v-2h-3v-3h-2z</StreamGeometry>

    <!-- 新建、编辑和删除：统一闭合单色图标 -->
    <StreamGeometry x:Key="Kei.Icon.Add">M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7V4z</StreamGeometry>
    <StreamGeometry x:Key="Kei.Icon.Edit">M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.04a.996.996 0 0 0 0-1.41l-2.34-2.34a.996.996 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z</StreamGeometry>
    <StreamGeometry x:Key="Kei.Icon.Delete">M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zm3-9h2v8H9v-8zm4 0h2v8h-2v-8zM15 4V3H9v1H5v2h14V4h-4z</StreamGeometry>
    <StreamGeometry x:Key="Kei.Icon.Warning">M12 3 2 21h20L12 3zm-1 6h2v6h-2V9zm0 8h2v2h-2v-2z</StreamGeometry>

    <!-- 闭合文件夹 -->
    <StreamGeometry x:Key="Kei.Icon.Folder">M2 5a2 2 0 0 1 2-2h5l2 2h9a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5zm2 2v9h16V7h-7.83l-2-2H4z</StreamGeometry>

    <!-- 打开的文件夹 -->
    <StreamGeometry x:Key="Kei.Icon.FolderOpen">M2 5a2 2 0 0 1 2-2h5l2 2h9a2 2 0 0 1 2 2v2H4V7h14.17l-2-2H4v2zm0 6h17.5a1.5 1.5 0 0 1 1.48 1.75l-1.33 8A1.5 1.5 0 0 1 18.17 22H4a2 2 0 0 1-2-2V11zm2 2v7h13.84l1.17-7H4z</StreamGeometry>

    <!-- 新建文件夹：文件夹 + 右下角加号 -->
    <StreamGeometry x:Key="Kei.Icon.NewFolder">M2 5a2 2 0 0 1 2-2h5l2 2h9a2 2 0 0 1 2 2v5h-2V7h-7.83l-2-2H4v11h8v2H4a2 2 0 0 1-2-2V5zm16 8v3h-3v2h3v3h2v-3h3v-2h-3v-3h-2z</StreamGeometry>

    <!-- 剪切：剪刀 -->
    <StreamGeometry x:Key="Kei.Icon.Cut">M6 9a3 3 0 1 1 0-6 3 3 0 0 1 2.2 4.96L12 11.7l3.8-3.74A3 3 0 1 1 18 9a2.98 2.98 0 0 1-2.18-.95L12 11.95l-3.82-3.9A3 3 0 0 1 6 9zm0-2a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm12 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zM9.6 14.1l-1.4 1.46A3 3 0 1 0 6 21a2.98 2.98 0 0 0 2.2-.95L12 16.2l3.8 3.85A3 3 0 1 0 18 19a3 3 0 0 0-2.2-.96l-1.4-1.44 1.42-1.42L12 11.4 8.2 15.5l1.4-1.4zM6 19a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm12 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2z</StreamGeometry>

    <!-- 复制：双重叠卡片 -->
    <StreamGeometry x:Key="Kei.Icon.Copy">M8 3h10a2 2 0 0 1 2 2v10h-2V5H8V3zm-4 4h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2zm0 2v10h10V9H4z</StreamGeometry>

    <!-- 粘贴：剪贴板 -->
    <StreamGeometry x:Key="Kei.Icon.Paste">M9 2a2 2 0 0 0-2 2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2a2 2 0 0 0-2-2H9zm0 2h6v2H9V4zm-4 4h2v2h10V8h2v12H5V8z</StreamGeometry>

    <!-- 全部折叠：双折向内箭头 -->
    <StreamGeometry x:Key="Kei.Icon.CollapseAll">M4 7l8 8 8-8-1.4-1.4L12 12.2 5.4 5.6 4 7zm0 8l8 8 8-8-1.4-1.4L12 20.2l-6.6-6.6L4 15z</StreamGeometry>

    <!-- 全部展开：双向外箭头 -->
    <StreamGeometry x:Key="Kei.Icon.ExpandAll">M12 4l-8 8 1.4 1.4L12 6.8l6.6 6.6L20 12l-8-8zm0 8l-8 8 1.4 1.4L12 14.8l6.6 6.6L20 20l-8-8z</StreamGeometry>


    <!-- ================= 视图、停靠与全局设置 ================= -->
    <!-- 会话管理器：窗口外框与左侧栏 -->
    <StreamGeometry x:Key="Kei.Icon.Sidebar">M3 4h18v16H3V4zm2 2v12h4V6H5zm6 0v12h8V6h-8z</StreamGeometry>

    <!-- 文件管理器：窗口外框与右侧栏 -->
    <StreamGeometry x:Key="Kei.Icon.SidebarRight">M3 4h18v16H3V4zm2 2v12h8V6H5zm10 0v12h4V6h-4z</StreamGeometry>

    <!-- 固定侧栏：图钉，几何边界中心位于 24×24 视口的 (12,12) -->
    <StreamGeometry x:Key="Kei.Icon.Pin">M8 2h8v2h-1v6l3 3v2h-5v6l-1 1-1-1v-6H6v-2l3-3V4H8V2zm3 2v6.8L8.8 13h6.4L13 10.8V4h-2z</StreamGeometry>

    <!-- 收起侧栏：左箭头，同一 24×24 视口中心 -->
    <StreamGeometry x:Key="Kei.Icon.ChevronLeft">M15 4l-8 8 8 8 2-2-6-6 6-6-2-2z</StreamGeometry>

    <!-- 设置：齿轮 -->
    <StreamGeometry x:Key="Kei.Icon.Settings">M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm-2 4a2 2 0 1 1 4 0 2 2 0 0 1-4 0zm10.2 1.3l-1.6-.3a7.2 7.2 0 0 0-.8-1.9l1-1.3a1 1 0 0 0-.1-1.3l-1.4-1.4a1 1 0 0 0-1.3-.1l-1.3 1a7.2 7.2 0 0 0-1.9-.8l-.3-1.6a1 1 0 0 0-1-.8h-2a1 1 0 0 0-1 .8l-.3 1.6a7.2 7.2 0 0 0-1.9.8l-1.3-1a1 1 0 0 0-1.3.1L3.8 7.4a1 1 0 0 0-.1 1.3l1 1.3a7.2 7.2 0 0 0-.8 1.9l-1.6.3a1 1 0 0 0-.8 1v2a1 1 0 0 0 .8 1l1.6.3a7.2 7.2 0 0 0 .8 1.9l-1 1.3a1 1 0 0 0 .1 1.3l1.4 1.4a1 1 0 0 0 1.3.1l1.3-1a7.2 7.2 0 0 0 1.9.8l.3 1.6a1 1 0 0 0 1 .8h2a1 1 0 0 0 1-.8l.3-1.6a7.2 7.2 0 0 0 1.9-.8l1.3 1a1 1 0 0 0 1.3-.1l1.4-1.4a1 1 0 0 0 .1-1.3l-1-1.3a7.2 7.2 0 0 0 .8-1.9l1.6-.3a1 1 0 0 0 .8-1v-2a1 1 0 0 0-.8-1z</StreamGeometry>

    <!-- SFTP / 文件管理：双栏文件架构面板 -->
    <StreamGeometry x:Key="Kei.Icon.FileManager">M3 4h18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v12h6V6H3zm8 0v12h10V6H11z</StreamGeometry>

    <!-- 快捷命令栏：命令行输入提示条 -->
    <StreamGeometry x:Key="Kei.Icon.Compose">M2 5h20a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2v10h18V7H3zm3 4h6v2H6v-2zm8 0h4v2h-4v-2z</StreamGeometry>

    <!-- 侧栏停靠切换：右停靠 / 左右切换 -->
    <StreamGeometry x:Key="Kei.Icon.DockRight">M3 4h18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v12h12V6H3zm14 0v12h4V6h-4z</StreamGeometry>


    <!-- ================= 文件管理操作（清理替代原纯文本符号与 Emoji） ================= -->
    <!-- 单个常规文件（带右上折角） -->
    <StreamGeometry x:Key="Kei.Icon.File">M4 3h9l6 6v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 2v14h13V10h-5V5H4zm7 0v3h3l-3-3z</StreamGeometry>

    <!-- 上一级目录：向上箭头（替代 ⬆） -->
    <StreamGeometry x:Key="Kei.Icon.ArrowUp">M12 4l-7 7 1.4 1.4L11 7.8V20h2V7.8l4.6 4.6L19 11l-7-7z</StreamGeometry>

    <!-- 下移：与上移共享 24×24 视口 -->
    <StreamGeometry x:Key="Kei.Icon.ArrowDown">M11 4v12.2l-4.6-4.6L5 13l7 7 7-7-1.4-1.4L13 16.2V4h-2z</StreamGeometry>

    <!-- 刷新：圆环双箭头（替代 ↻） -->
    <StreamGeometry x:Key="Kei.Icon.Refresh">M17.65 6.35A7.95 7.95 0 0 0 12 4V1L7 6l5 5V7a6 6 0 1 1-6 6H4a8 8 0 1 0 13.65-6.65z</StreamGeometry>

    <!-- 在新标签中打开：右上引出斜箭头（替代 ↗） -->
    <StreamGeometry x:Key="Kei.Icon.ExternalLink">M14 3v2h4.59L8.3 15.3l1.4 1.4L20 6.41V11h2V3h-8zM5 5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-6h-2v6H5V7h6V5H5z</StreamGeometry>

    <!-- 切换停靠方向：左右双向箭头（替代 ⇄） -->
    <StreamGeometry x:Key="Kei.Icon.DockSwap">M8 4l-4 4 4 4V9h8V7H8V4zm8 8v3H8v2h8v3l4-4-4-4z</StreamGeometry>

    <!-- 上传：向上箭头与基座线 -->
    <StreamGeometry x:Key="Kei.Icon.Upload">M5 20h14v-2H5v2zm7-18l-5.5 5.5 1.42 1.42L11 5.83V16h2V5.83l3.08 3.09 1.42-1.42L12 2z</StreamGeometry>

    <!-- 下载：向下箭头与基座线 -->
    <StreamGeometry x:Key="Kei.Icon.Download">M5 20h14v-2H5v2zM12 2v10.17l-3.08-3.09-1.42 1.42L12 16l4.5-4.5-1.42-1.42L13 12.17V2h-2z</StreamGeometry>

    <!-- 关闭/删除：细叉号（替代 ✕） -->
    <StreamGeometry x:Key="Kei.Icon.Close">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z</StreamGeometry>

    <!-- 眼睛：显示隐藏文件（替代 .*） -->
    <StreamGeometry x:Key="Kei.Icon.Eye">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z</StreamGeometry>

    <!-- 放大镜：搜索 -->
    <StreamGeometry x:Key="Kei.Icon.Search">M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>

    <!-- 对勾：完成 / 成功 -->
    <StreamGeometry x:Key="Kei.Icon.Check">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z</StreamGeometry>

</ResourceDictionary>
