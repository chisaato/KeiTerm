<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:Avalonia.Controls.Converters"
        xmlns:controls="using:Kei.Term.App.Controls">

    <Styles.Resources>
        <ControlTheme x:Key="KeiTreeViewItem" TargetType="TreeViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
            <Setter Property="MinHeight" Value="{DynamicResource Kei.Tree.ItemHeight}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <!-- 外层容器：负责行高与点击焦点，不带不透明背景 -->
                        <Border Name="PART_LayoutRoot"
                                Classes="TreeViewItemLayoutRoot"
                                Focusable="True"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Kei.Radius.Control}"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="2,1"
                                TemplatedControl.IsTemplateFocusTarget="True">
                            <Grid Name="PART_Header">
                                <Grid.Margin>
                                    <MultiBinding Converter="{x:Static converters:TreeViewItemIndentConverter.Instance}">
                                        <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <DynamicResource ResourceKey="Kei.Tree.Indent"/>
                                    </MultiBinding>
                                </Grid.Margin>
                                <!-- 节点内容胶囊容器：背景色放在此处，使得左侧缩进层级不被整行高亮截断 -->
                                <Border Name="PART_ContentPill"
                                        Classes="TreeViewItemContentPill"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{DynamicResource Kei.Radius.Control}">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Panel Name="PART_ExpandCollapseChevronContainer" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <ToggleButton Name="PART_ExpandCollapseChevron"
                                                          Theme="{StaticResource FluentTreeViewExpandCollapseChevron}"
                                                          Foreground="{DynamicResource Kei.Text.Secondary}"
                                                          Width="12" Height="12" MinWidth="0" MinHeight="0"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Focusable="False"
                                                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"/>
                                        </Panel>
                                        <ContentPresenter Name="PART_HeaderPresenter"
                                                          Grid.Column="1"
                                                          Focusable="False"
                                                          Background="Transparent"
                                                          Content="{TemplateBinding Header}"
                                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                                          Margin="{TemplateBinding Padding}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid IsVisible="{TemplateBinding IsExpanded}">
                            <!-- 父箭头轴和直接子项横支线共用实际布局坐标，随密度设置一起更新。 -->
                            <controls:KeiTreeLine
                                                  LineBrush="{DynamicResource Kei.Tree.Line}"
                                                  IsHitTestVisible="False"/>
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter>

            <!-- 交互状态定义：高亮应用于内容胶囊 PART_ContentPill，使得父级垂直引导线不被横切截断 -->
            <Style Selector="^ /template/ Border#PART_ContentPill:pointerover">
                <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
            </Style>
            <Style Selector="^:selected /template/ Border#PART_ContentPill">
                <Setter Property="Background" Value="{DynamicResource Kei.Bg.Pressed}"/>
            </Style>
            <Style Selector="^:selected:focus /template/ Border#PART_ContentPill">
                <Setter Property="Background" Value="{DynamicResource Kei.Bg.Pressed}"/>
            </Style>
            <Style Selector="^:selected:pointerover /template/ Border#PART_ContentPill">
                <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
            </Style>

            <!-- 同时保留 PART_LayoutRoot 的透明继承，以便窗口级样式（如拖拽反馈）无缝生效 -->
            <Style Selector="^ /template/ Border#PART_LayoutRoot:pointerover">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="^:selected:focus /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="^:selected:pointerover /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <!-- 空节点时隐藏箭头，但保留占位宽度，对齐层级 -->
            <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <!-- Kei 桌面工具紧凑控件外观样式（基于 FluentTheme，覆盖紧凑度、小圆角与沉稳边框） -->

    <!-- 两层模板选择器须放在应用样式中，ControlTheme 内只允许穿过自身的一层模板。 -->
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron[IsEnabled=True] /template/ Path">
        <!-- 状态样式优先于 Fluent 模板内的独立 Fill，保持字形与 Kei 前景一致。 -->
        <Setter Property="Fill" Value="{DynamicResource Kei.Text.Secondary}"/>
    </Style>
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron:disabled /template/ Path">
        <Setter Property="Fill" Value="{DynamicResource Kei.Text.Muted}"/>
    </Style>

    <!-- 通用输入框：封闭实体框、28px 紧凑高度、3px 圆角、细腻微弱描边、聚焦高亮 -->
    <Style Selector="TextBox">
        <!-- 桌面菜单取得焦点后仍须能编辑此前选区；失焦时只隐藏高亮，不清空选区。 -->
        <Setter Property="ClearSelectionOnLostFocus" Value="False"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- 多行文本框：取消固定 28px 高度限制，内容靠顶对齐，舒适编辑内边距 -->
    <Style Selector="TextBox.multiline, TextBox[AcceptsReturn=True]">
        <Setter Property="Height" Value="NaN"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Text.Muted}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Input}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Focus}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Input}"/>
        <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}"/>
    </Style>
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Subtle}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Input}"/>
    </Style>
    <Style Selector="TextBox:error /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Status.Error}"/>
    </Style>

    <!-- 自动补全框将宿主 Padding 传给内嵌 TextBox，必须与 28px 行高一起收紧。 -->
    <Style Selector="AutoCompleteBox">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="AutoCompleteBox /template/ TextBox#PART_TextBox">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Height" Value="NaN"/>
    </Style>

    <!-- 通用下拉框：28px 紧凑高度、3px 圆角、实体背景 -->
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Text.Muted}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
    </Style>
    <Style Selector="ComboBox:pressed /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Text.Muted}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Pressed}"/>
    </Style>
    <Style Selector="ComboBox:focus-within /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Focus}"/>
    </Style>
    <!-- Fluent 的键盘焦点层位于 Background 之上，不能留下另一套渐变描边。 -->
    <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Focus}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ComboBox:disabled /template/ Border#Background, ComboBox:disabled /template/ Border#HighlightBackground">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Subtle}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Input}"/>
    </Style>
    <Style Selector="ComboBox:error /template/ Border#Background, ComboBox:error /template/ Border#HighlightBackground">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Status.Error}"/>
    </Style>

    <!-- 数字微调框：28px 紧凑高度 -->
    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- 外层 28px，但 Fluent 的 Spinner 默认最少 32px，会把上下描边放在控件之外。 -->
    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="NumericUpDown:pointerover /template/ ButtonSpinner#PART_Spinner">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Text.Muted}"/>
    </Style>
    <Style Selector="NumericUpDown:focus-within /template/ ButtonSpinner#PART_Spinner">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Focus}"/>
    </Style>
    <Style Selector="NumericUpDown:disabled /template/ ButtonSpinner#PART_Spinner">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Subtle}"/>
    </Style>
    <Style Selector="NumericUpDown:error /template/ ButtonSpinner#PART_Spinner">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Status.Error}"/>
    </Style>

    <!-- 复合输入的内嵌编辑器只负责文字，外层统一绘制实体背景和完整边框。 -->
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox, ComboBox /template/ TextBox#PART_EditableTextBox">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Height" Value="NaN"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style Selector="^ /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- 状态选择器单独保留触发优先级，覆盖共用 TextBox 状态的背景。 -->
        <Style Selector="^:pointerover /template/ Border#PART_BorderElement,
                         ^:focus /template/ Border#PART_BorderElement,
                         ^:disabled /template/ Border#PART_BorderElement,
                         ^:error /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Style>

    <!-- 高级设置折叠栏采用与表单一致的紧凑尺寸，避免默认大标题抢占层级。 -->
    <Style Selector="Expander">
        <!-- Fluent 模板用 TemplateBinding 将宿主 MinHeight 传给标题，需在宿主覆盖默认 48px。 -->
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.PanelAlt}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
        <!-- 模板的 Width/Height 是局部资源值，上限约束才能缩小其实际布局尺寸。 -->
        <Setter Property="MaxWidth" Value="24"/>
        <Setter Property="MaxHeight" Value="24"/>
    </Style>

    <!-- 通用标准按钮：32px 舒适高度、3px 圆角、13px 字号、舒适内边距 -->
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.PanelAlt}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Text.Muted}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Pressed}"/>
    </Style>

    <!-- 主要操作按钮（Accent） -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource Kei.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Accent.Foreground}"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Accent.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Accent.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Accent.Foreground}"/>
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Accent.Pressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Accent.Pressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Accent.Foreground}"/>
    </Style>

    <!-- 工具栏图标按钮：30×30 易点尺寸，hover 高亮，圆角 3px -->
    <Style Selector="Button.iconBtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.iconBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
    </Style>
    <Style Selector="Button.iconBtn:disabled">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>

    <!-- Lucide 统一使用 24x24 画布和 2px 圆角描边，由外层 Viewbox 缩放到显示尺寸。 -->
    <Style Selector="Path.kei-icon">
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="Stroke" Value="{DynamicResource Kei.Text.Secondary}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <!-- 可用操作保持主文字色，禁用态单独淡化，避免普通入口看起来不可用。 -->
    <Style Selector="Button.iconBtn Path.kei-icon">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Stroke" Value="{DynamicResource Kei.Text.Primary}"/>
    </Style>
    <Style Selector="Button.iconBtn:pointerover Path.kei-icon">
        <Setter Property="Opacity" Value="1.0"/>
        <Setter Property="Stroke" Value="{DynamicResource Kei.Text.Primary}"/>
    </Style>
    <Style Selector="Button.iconBtn:disabled Path.kei-icon">
        <Setter Property="Stroke" Value="{DynamicResource Kei.Text.Muted}"/>
    </Style>

    <!-- 侧栏固定按钮以底色与图标强调表示已固定。 -->
    <Style Selector="Button.iconBtn.sessionManagerPin.pinned">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Pressed}"/>
    </Style>
    <Style Selector="Button.iconBtn.sessionManagerPin.pinned Path.kei-icon">
        <Setter Property="Stroke" Value="{DynamicResource Kei.Accent}"/>
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource Kei.Status.Error}"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter, Button.danger:pressed /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Kei.Status.Error}"/>
    </Style>
    <Style Selector="Button.danger Path.kei-icon, Button.iconBtn.danger Path.kei-icon">
        <Setter Property="Stroke" Value="{DynamicResource Kei.Status.Error}"/>
    </Style>
    <Style Selector="Button.danger:disabled">
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Muted}"/>
    </Style>
    <Style Selector="Button.danger:disabled Path.kei-icon, Button.iconBtn.danger:disabled Path.kei-icon">
        <Setter Property="Stroke" Value="{DynamicResource Kei.Text.Muted}"/>
    </Style>

    <!-- 弹窗数据列表采用灰色选中面、细强调边界；正文颜色由类设置，选中时可统一提高对比度。 -->
    <Style Selector="ListBox.popupList ListBoxItem">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.popupList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
    </Style>
    <Style Selector="ListBox.popupList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Pressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
    </Style>
    <Style Selector="ListBox.popupList TextBlock.popupPrimary">
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
    </Style>
    <Style Selector="ListBox.popupList TextBlock.popupSecondary, ListBox.popupList SelectableTextBlock.popupSecondary">
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Secondary}"/>
    </Style>
    <Style Selector="ListBox.popupList TextBlock.popupMuted">
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Muted}"/>
    </Style>
    <Style Selector="ListBox.popupList ListBoxItem:selected TextBlock.popupPrimary, ListBox.popupList ListBoxItem:selected TextBlock.popupSecondary, ListBox.popupList ListBoxItem:selected TextBlock.popupMuted, ListBox.popupList ListBoxItem:selected SelectableTextBlock.popupSecondary">
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
    </Style>

    <!-- 工具栏垂直分隔条 -->
    <Style Selector="Separator.toolSep">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Border}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 标签条：未选中 / 选中 / 后台活动靠明度和字重分开，只用 Kei.* 令牌 -->
    <Style Selector="Button.tabItem">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.TabInactive}"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="2,4,0,0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="CornerRadius" Value="3,3,0,0"/>
        <Setter Property="BorderThickness" Value="1,1,1,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Subtle}"/>
    </Style>
    <Style Selector="Button.tabItem TextBlock.tabTitle">
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Muted}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Button.tabItem.selected">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Panel}"/>
        <Setter Property="BorderThickness" Value="1,2,1,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Accent}"/>
    </Style>
    <Style Selector="Button.tabItem.selected TextBlock.tabTitle">
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- 后台活动且未选中：比未选中更亮，比选中更轻 -->
    <Style Selector="Button.tabItem.activity:not(.selected)">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.PanelAlt}"/>
    </Style>
    <Style Selector="Button.tabItem.activity:not(.selected) TextBlock.tabTitle">
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Secondary}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Button.tabItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="Theme" Value="{StaticResource KeiTreeViewItem}"/>
    </Style>

    <!-- 标签关闭按钮 -->
    <Style Selector="Button.closeBtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Muted}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.closeBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
    </Style>
    <Style Selector="Button.closeBtn:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
    </Style>
</Styles>
