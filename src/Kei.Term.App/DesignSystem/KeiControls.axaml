<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:Avalonia.Controls.Converters">

    <Styles.Resources>
        <ControlTheme x:Key="KeiTreeViewItem" TargetType="TreeViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
            <Setter Property="MinHeight" Value="{DynamicResource Kei.Tree.ItemHeight}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <Border Name="PART_LayoutRoot"
                                Classes="TreeViewItemLayoutRoot"
                                Focusable="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Kei.Radius.Control}"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="2,1"
                                TemplatedControl.IsTemplateFocusTarget="True">
                            <Grid Name="PART_Header">
                                <Grid.Margin>
                                    <MultiBinding Converter="{x:Static converters:TreeViewItemIndentConverter.Instance}">
                                        <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <DynamicResource ResourceKey="Kei.Tree.Indent"/>
                                    </MultiBinding>
                                </Grid.Margin>
                                <!-- 水平分支引导线：与父级垂直对齐线相交 -->
                                <Rectangle Height="1"
                                           Width="6"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="-6,0,0,0"
                                           Fill="{DynamicResource Kei.Tree.Line}"
                                           IsHitTestVisible="False"/>
                                <Grid ColumnDefinitions="Auto, *">
                                    <Panel Name="PART_ExpandCollapseChevronContainer" Margin="4,0,4,0">
                                        <ToggleButton Name="PART_ExpandCollapseChevron"
                                                      Theme="{StaticResource FluentTreeViewExpandCollapseChevron}"
                                                      Focusable="False"
                                                      IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"/>
                                    </Panel>
                                    <ContentPresenter Name="PART_HeaderPresenter"
                                                      Grid.Column="1"
                                                      Focusable="False"
                                                      Background="Transparent"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                                      Margin="{TemplateBinding Padding}"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid IsVisible="{TemplateBinding IsExpanded}">
                            <Rectangle Width="1"
                                       HorizontalAlignment="Left"
                                       Fill="{DynamicResource Kei.Tree.Line}"
                                       IsHitTestVisible="False">
                                <Rectangle.Margin>
                                    <MultiBinding Converter="{x:Static converters:TreeViewItemIndentConverter.Instance}">
                                        <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <DynamicResource ResourceKey="Kei.Tree.Indent"/>
                                    </MultiBinding>
                                </Rectangle.Margin>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="10"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter>

            <!-- 交互状态定义 -->
            <Style Selector="^ /template/ Border#PART_LayoutRoot:pointerover">
                <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
            </Style>
            <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource Kei.Bg.Pressed}"/>
            </Style>
            <Style Selector="^:selected:focus /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource Kei.Bg.Pressed}"/>
            </Style>
            <Style Selector="^:selected:pointerover /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
            </Style>

            <!-- 空节点时隐藏箭头，但保留占位宽度，对齐层级 -->
            <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="^:empty /template/ Panel#PART_ExpandCollapseChevronContainer">
                <Setter Property="Width" Value="12"/>
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <!-- Kei 桌面工具紧凑控件外观样式（基于 FluentTheme，覆盖紧凑度、小圆角与沉稳边框） -->

    <!-- 通用输入框：封闭实体框、28px 紧凑高度、3px 圆角、细腻微弱描边、聚焦高亮 -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- 多行文本框：取消固定 28px 高度限制，内容靠顶对齐，舒适编辑内边距 -->
    <Style Selector="TextBox.multiline, TextBox[AcceptsReturn=True]">
        <Setter Property="Height" Value="NaN"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Text.Muted}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Input}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Focus}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Input}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- 通用下拉框：28px 紧凑高度、3px 圆角、实体背景 -->
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Text.Muted}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Focus}"/>
    </Style>

    <!-- 数字微调框：28px 紧凑高度 -->
    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- 通用标准按钮：32px 舒适高度、3px 圆角、13px 字号、舒适内边距 -->
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.PanelAlt}"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Text.Muted}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Pressed}"/>
    </Style>

    <!-- 主要操作按钮（Accent） -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource Kei.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Accent}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Accent.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Accent.Hover}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Accent.Pressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Accent.Pressed}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- 工具栏图标按钮：30×30 易点尺寸，hover 高亮，圆角 3px -->
    <Style Selector="Button.iconBtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Kei.Radius.Control}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.iconBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
    </Style>
    <Style Selector="Button.iconBtn:disabled">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>

    <!-- Kei 统一单色矢量图标规范（默认 16x16，居中，等比缩放，次级文字色） -->
    <Style Selector="Path.kei-icon">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource Kei.Text.Secondary}"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <!-- 图标按钮与图标联动交互态（平时 85% 透明度，悬停 100% 并高亮为主字色，禁用淡化） -->
    <Style Selector="Button.iconBtn Path.kei-icon">
        <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <Style Selector="Button.iconBtn:pointerover Path.kei-icon">
        <Setter Property="Opacity" Value="1.0"/>
        <Setter Property="Fill" Value="{DynamicResource Kei.Text.Primary}"/>
    </Style>
    <Style Selector="Button.iconBtn:disabled Path.kei-icon">
        <Setter Property="Fill" Value="{DynamicResource Kei.Text.Muted}"/>
    </Style>

    <!-- 工具栏垂直分隔条 -->
    <Style Selector="Separator.toolSep">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Background" Value="{DynamicResource Kei.Border}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 标签条按钮：选中态面板底 + 顶部 2px 强调条 -->
    <Style Selector="Button.tabItem">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.TabInactive}"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="2,4,0,0"/>
        <Setter Property="CornerRadius" Value="3,3,0,0"/>
        <Setter Property="BorderThickness" Value="1,1,1,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Border.Subtle}"/>
    </Style>
    <Style Selector="Button.tabItem.selected">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Panel}"/>
        <Setter Property="BorderThickness" Value="1,2,1,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Kei.Accent}"/>
    </Style>
    <Style Selector="Button.tabItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
    </Style>
    <!-- 后台活动标签：标题斜体提示有未读输出 -->
    <Style Selector="Button.tabItem.activity TextBlock.tabTitle">
        <Setter Property="FontStyle" Value="Italic"/>
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="Theme" Value="{StaticResource KeiTreeViewItem}"/>
    </Style>

    <!-- 标签关闭按钮 -->
    <Style Selector="Button.closeBtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Muted}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.closeBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Kei.Bg.Hover}"/>
    </Style>
    <Style Selector="Button.closeBtn:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Kei.Text.Primary}"/>
    </Style>
</Styles>
